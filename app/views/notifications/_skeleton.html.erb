<!-- Notifications Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="notifications-skeleton" aria-hidden="true">
  <!-- Notifications Global Quick Actions Skeleton -->
  <div class="notifications-header-bar mb-3">
    <div class="d-flex gap-2 align-items-center justify-content-between flex-wrap">
      <div class="skeleton-btn-pill" style="width: 88px; height: 32px;"></div>
      <div class="skeleton-btn" style="width: 130px; height: 32px; border-radius: var(--form-field-radius, 0.5rem);"></div>
    </div>
  </div>

  <!-- Metric Overview Cards Skeleton (1:1 with real stat-widget-card) -->
  <div class="row g-2 g-sm-3 mb-3 mb-md-4">
    <% 4.times do %>
      <div class="col-6 col-md-3">
        <div class="card stat-widget-card border-0 rounded-3 p-2.5 p-sm-3 h-100">
          <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div class="skeleton-line skeleton-line-sm mb-0" style="width: 45%; height: 12px;"></div>
            <div class="skeleton-circle" style="width: 32px; height: 32px;"></div>
          </div>
          <div class="skeleton-value mb-0" style="width: 50px; height: 28px;"></div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Filter Card Skeleton (1:1 with real notifications-filter-card) -->
  <div class="card border-0 rounded-3 mb-3 notifications-filter-card">
    <div class="card-body p-2.5 p-sm-3">
      <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-2.5 gap-lg-3">
        <!-- Category Tabs -->
        <div class="d-flex gap-1.5 flex-nowrap overflow-hidden">
          <div class="skeleton-pill" style="width: 65px; height: 32px;"></div>
          <div class="skeleton-pill" style="width: 145px; height: 32px;"></div>
          <div class="skeleton-pill" style="width: 135px; height: 32px;"></div>
          <div class="skeleton-pill" style="width: 120px; height: 32px;"></div>
        </div>
        <!-- Status Filter & Search -->
        <div class="d-flex align-items-center gap-2 flex-wrap flex-sm-nowrap">
          <div class="skeleton-pill" style="width: 160px; height: 32px;"></div>
          <div class="skeleton-btn flex-grow-1" style="min-width: 180px; height: 32px; border-radius: var(--form-field-radius, 0.5rem);"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification Feed Skeleton List (1:1 with real notification-page-card) -->
  <div class="d-flex flex-column" style="gap: 12px;">
    <% 6.times do |i| %>
      <div class="card notification-page-card rounded-3 border-0">
        <div class="card-body p-2.5 p-sm-3 p-md-3.5">
          <div class="d-flex align-items-start gap-2.5 gap-sm-3">
            <div class="pt-1 flex-shrink-0">
              <div class="skeleton-box" style="width: 18px; height: 18px; border-radius: 4px;"></div>
            </div>
            <div class="skeleton-circle flex-shrink-0" style="width: 40px; height: 40px;"></div>
            <div class="flex-grow-1 min-w-0">
              <div class="d-flex align-items-center justify-content-between gap-2 mb-1.5">
                <div class="skeleton-line skeleton-title-sm mb-0" style="width: <%= [35, 45, 30, 50, 40, 42][i] %>%; height: 14px;"></div>
                <div class="skeleton-badge" style="width: 65px; height: 18px;"></div>
              </div>
              <div class="skeleton-line skeleton-line-sm mb-1.5" style="width: <%= [85, 95, 75, 90, 80, 88][i] %>%; height: 12px;"></div>
              <div class="skeleton-line skeleton-line-xs mb-0" style="width: <%= [55, 65, 45, 60, 50, 52][i] %>%; height: 10px;"></div>
            </div>
            <div class="d-flex gap-1.5 ms-auto flex-shrink-0 align-self-center d-none d-sm-flex">
              <div class="skeleton-circle" style="width: 28px; height: 28px;"></div>
              <div class="skeleton-circle" style="width: 28px; height: 28px;"></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
