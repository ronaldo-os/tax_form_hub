<%
  icon_cfg = notification.icon_config
%>
<div class="toast live-notification-toast show shadow-lg border-0 mb-3 rounded-4 overflow-hidden"
     id="toast_notification_<%= notification.id %>"
     role="alert"
     aria-live="assertive"
     aria-atomic="true"
     data-bs-autohide="true"
     data-bs-delay="7000"
     style="background: var(--bg-sidebar); border: 1px solid var(--border-color) !important; min-width: 320px; max-width: 380px;">
  <div class="toast-header border-bottom px-3 py-2.5 d-flex align-items-center justify-content-between" style="background: var(--bg-secondary);">
    <div class="d-flex align-items-center gap-2">
      <div class="notification-item-icon <%= icon_cfg[:bg] %> <%= icon_cfg[:color] %> rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.75rem;">
        <i class="<%= icon_cfg[:icon] %>"></i>
      </div>
      <strong class="me-auto text-main fs-8 fw-bold text-truncate" style="max-width: 200px;"><%= notification.title %></strong>
    </div>
    <div class="d-flex align-items-center gap-2">
      <small class="text-muted fs-9">Just now</small>
      <button type="button" class="btn-close fs-9" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
  <div class="toast-body p-3">
    <% if notification.message.present? %>
      <p class="fs-8 text-muted mb-2"><%= notification.message %></p>
    <% end %>
    <div class="d-flex align-items-center justify-content-between gap-2 pt-1 border-top border-secondary-subtle">
      <span class="badge <%= notification.category == 'taxes' ? 'bg-success-subtle text-success' : 'bg-primary-subtle text-primary' %> fs-9">
        <%= notification.category.capitalize %>
      </span>
      <a href="<%= click_notification_path(notification) %>" class="btn btn-sm btn-primary rounded-pill py-1 px-3 fs-9 fw-semibold text-decoration-none">
        <span>View Details</span>
        <i class="fa-solid fa-arrow-right ms-1 fs-9"></i>
      </a>
    </div>
  </div>
</div>
