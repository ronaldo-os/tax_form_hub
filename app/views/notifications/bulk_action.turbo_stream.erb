<%= turbo_stream.replace "header_notification_dropdown_container" do %>
  <%= render "layouts/notification_dropdown", user: current_user %>
<% end %>

<%= turbo_stream.update "stat_total_count", @total_count %>
<%= turbo_stream.update "stat_unread_count", @unread_count %>
<%= turbo_stream.update "stat_invoices_count", @invoices_count %>
<%= turbo_stream.update "stat_taxes_count", @taxes_count %>
<%= turbo_stream.update "stat_system_count", @system_count %>
<%= turbo_stream.update "tab_all_badge", @total_count %>
<%= turbo_stream.update "tab_invoices_badge", @invoices_count %>
<%= turbo_stream.update "tab_taxes_badge", @taxes_count %>
<%= turbo_stream.update "tab_system_badge", @system_count %>

<%= turbo_stream.update "notifications_global_actions" do %>
  <%= link_to session[:notifications_back_url] || root_path, class: "btn btn-back btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-2 flex-fill flex-sm-grow-0 text-nowrap", data: { behavior: "back-button" } do %>
    <i class="fa-solid fa-arrow-left"></i> Back
  <% end %>
  <% if @unread_count > 0 %>
    <%= button_to mark_all_as_read_notifications_path(category: @tab),
                  method: :post,
                  class: "btn btn-primary btn-sm flex-fill flex-sm-grow-0 text-nowrap d-inline-flex align-items-center justify-content-center gap-2",
                  form: { class: "m-0 d-inline-block flex-fill flex-sm-grow-0", data: { turbo: true } },
                  id: "page_mark_all_read_btn" do %>
      <i class="fa-solid fa-check-double"></i>
      <span>Mark All Read</span>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream.replace "notifications_feed_container" do %>
  <div id="notifications_feed_container">
    <% if @notifications.any? %>
      <div id="notifications_feed">
        <% @notifications.each do |notification| %>
          <%= render "notifications/notification_row", notification: notification %>
        <% end %>
      </div>
    <% else %>
      <div class="card border-0 rounded-3 p-4 p-sm-5 text-center my-3 my-md-4 bg-sidebar">
        <div class="py-3 py-sm-4">
          <div class="mb-3">
            <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
              <i class="fa-solid fa-circle-check fs-4"></i>
            </div>
          </div>
          <h5 class="fw-bold text-main mb-1">All caught up!</h5>
          <p class="text-muted fs-7 mb-0">No notifications in this view.</p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
