<%
  icon_cfg = notification.icon_config
  is_unread = notification.unread?
%>
<a href="<%= click_notification_path(notification) %>"
   class="notification-item <%= 'unread' if is_unread %> text-decoration-none"
   id="dropdown_notification_<%= notification.id %>"
   data-notification-id="<%= notification.id %>"
   data-turbo="false"
   data-turbo-prefetch="false"
   data-action="click->notifications#markItemRead">
  <div class="notif-avatar <%= icon_cfg[:bg] %> <%= icon_cfg[:color] %> flex-shrink-0">
    <i class="<%= icon_cfg[:icon] %>"></i>
  </div>

  <div class="notification-item-content flex-grow-1 min-w-0">
    <div class="notification-item-text text-main">
      <span class="fw-semibold text-main fs-8"><%= notification.title %></span>
      <% if notification.message.present? %>
        <span class="text-muted d-block text-truncate-2 fs-8 mt-0.5"><%= notification.message %></span>
      <% end %>
    </div>
    <div class="notification-item-meta d-flex align-items-center gap-1.5 mt-1">
      <span class="notification-item-time fs-9 <%= is_unread ? 'text-primary fw-semibold' : 'text-muted' %>">
        <%= time_ago_in_words(notification.created_at) %> ago
      </span>
      <% if notification.action.present? %>
        <span class="fs-9 text-muted opacity-50">·</span>
        <span class="fs-9 text-muted notif-action-text text-truncate"><%= notification.action.humanize %></span>
      <% end %>
    </div>
  </div>

  <% if is_unread %>
    <span class="notification-unread-dot" title="Unread"></span>
  <% end %>
</a>
