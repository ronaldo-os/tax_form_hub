<%
  icon_cfg = notification.icon_config
  is_unread = notification.unread?
%>
<a href="<%= click_notification_path(notification) %>"
   class="notification-item <%= 'unread' if is_unread %> text-decoration-none"
   id="dropdown_notification_<%= notification.id %>"
   data-notification-id="<%= notification.id %>"
   data-turbo="false"
   data-turbo-prefetch="false"
   data-action="click->notifications#markItemRead">
  <div class="notification-item-icon <%= icon_cfg[:bg] %> <%= icon_cfg[:color] %>">
    <i class="<%= icon_cfg[:icon] %>"></i>
  </div>
  <div class="notification-item-content flex-grow-1 min-w-0">
    <div class="d-flex align-items-center justify-content-between mb-0.5">
      <span class="notification-title fw-semibold fs-7 text-main text-truncate pe-2">
        <%= notification.title %>
      </span>
      <span class="notification-time fs-9 text-muted ms-2 flex-shrink-0">
        <%= time_ago_in_words(notification.created_at) %> ago
      </span>
    </div>
    <% if notification.message.present? %>
      <p class="notification-desc fs-8 text-muted mb-1 text-truncate-2">
        <%= notification.message %>
      </p>
    <% end %>
    <div class="d-flex align-items-center gap-1.5 mt-0.5">
      <% if notification.category == "taxes" %>
        <span class="badge bg-success-subtle text-success fs-9 py-0.5 px-1.5 rounded">Taxes</span>
      <% elsif notification.category == "invoices" %>
        <span class="badge bg-primary-subtle text-primary fs-9 py-0.5 px-1.5 rounded">Invoices</span>
      <% else %>
        <span class="badge bg-secondary-subtle text-secondary fs-9 py-0.5 px-1.5 rounded">System</span>
      <% end %>
      <% if notification.action.present? %>
        <span class="fs-9 text-muted">• <%= notification.action.humanize %></span>
      <% end %>
    </div>
  </div>
  <% if is_unread %>
    <span class="notification-unread-dot" title="Unread"></span>
  <% end %>
</a>
