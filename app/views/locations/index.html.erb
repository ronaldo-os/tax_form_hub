<% content_for :page_title, "Locations" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "invoices", media: "all" %>
<% end %>

<div class="locations-page container-fluid px-2 px-sm-3 px-md-4 py-2.5">
  <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <div class="dropdown ms-auto">
      <button class="btn btn-primary btn-sm dropdown-toggle d-inline-flex align-items-center justify-content-center gap-2" type="button" id="addLocationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-plus me-1.5"></i>
        <span>Add a new location</span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="addLocationDropdown">
        <li><a class="dropdown-item location-option" href="#" data-location-type="Ship From" data-bs-toggle="modal" data-bs-target="#locationModal">Ship From</a></li>
        <li><a class="dropdown-item location-option" href="#" data-location-type="Remit To" data-bs-toggle="modal" data-bs-target="#locationModal">Remit To</a></li>
        <li><a class="dropdown-item location-option" href="#" data-location-type="Tax Representative" data-bs-toggle="modal" data-bs-target="#locationModal">Tax Representative</a></li>
      </ul>
    </div>
  </div>


  <!-- Bulk Action Bar -->
  <div class="card border-0 rounded-3 mb-3 d-none locations-bulk-bar shadow-sm" id="bulk_action_bar_location_table">
    <div class="card-body py-2 px-3">
      <%= form_with url: bulk_action_locations_path, method: :post, class: "bulk-locations-form", id: "bulk_form_location_table" do |f| %>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-2 gap-sm-3">
            <div class="form-check mb-0 d-flex align-items-center">
              <input class="form-check-input me-2 master-bulk-checkbox location-master-checkbox" type="checkbox" id="master_bulk_location_table" data-table-id="location-table">
              <label class="form-check-label fw-semibold fs-7 text-main" for="master_bulk_location_table">
                Select All
              </label>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fs-8 fw-semibold selected-count-badge">
              <span class="selected-count">0</span> selected
            </span>
          </div>

          <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end align-items-center">
            <button type="submit" name="bulk_action" value="destroy" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 bulk-action-btn" data-turbo-confirm="Are you sure you want to delete the selected locations?">
              <i class="fa-solid fa-trash"></i>
              <span>Delete</span>
            </button>

            <button type="button" class="btn btn-sm btn-link text-muted p-1 text-decoration-none clear-selection-btn" data-table-id="location-table" title="Clear selection">
              <i class="fa-solid fa-xmark fs-6"></i>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-2.5">
      <table class="table table-hover table_text_centered align-middle table-compact nowrap w-100" id="location-table">
        <thead class="table-light">
          <tr>
            <th class="text-center no-sort" style="width: 40px;" data-orderable="false">
              <div class="form-check d-flex justify-content-center mb-0">
                <input class="form-check-input table-header-checkbox" type="checkbox" id="header_checkbox_location_table" data-table-id="location-table" title="Select all on this page">
              </div>
            </th>
            <th>Type</th>
            <th>Location Name</th>
            <th>Address</th>
            <th>Company Name</th>
            <th class="text-center no-sort" data-orderable="false" style="width: 80px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @locations.each do |location| %>
            <tr data-location-id="<%= location.id %>">
              <td class="text-center">
                <div class="form-check d-flex justify-content-center mb-0">
                  <input class="form-check-input location-row-checkbox" type="checkbox" name="location_ids[]" value="<%= location.id %>" data-table-id="location-table" title="Select <%= location.location_name %>">
                </div>
              </td>
              <td>
                <span class="status-pill status-pill-primary"><%= location.location_type %></span>
              </td>
              <td class="fw-semibold"><%= location.location_name %></td>
              <td>
                <% street_and_number = [location.building, location.street].map(&:presence).compact.join(' ') %>
                <%= [street_and_number, location.additional_street, location.city]
                    .map(&:presence)
                    .compact
                    .join(', ') %>
              </td>
              <td><%= location.company_name %></td>
              <td>
                <div class="dropdown text-center">
                  <button class="btn btn-sm btn-action-dropdown text-muted" type="button" id="actionsDropdown-<%= location.id %>" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="actionsDropdown-<%= location.id %>">
                    <li>
                      <%= link_to 'Edit', '#',
                        class: 'dropdown-item edit-location',
                        data: {
                          id: location.id,
                          location_type: location.location_type,
                          location_name: location.location_name,
                          country: location.country,
                          company_name: location.company_name,
                          tax_number: location.tax_number,
                          post_box: location.post_box,
                          street: location.street,
                          building: location.building,
                          additional_street: location.additional_street,
                          zip_code: location.zip_code,
                          city: location.city
                      } %>
                    </li>
                    <li>
                      <%= link_to 'Delete', location_path(location),
                        data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' },
                        class: 'dropdown-item text-danger' %>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>


<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow-md border-0 rounded-4">
      <div class="modal-header border-0">
        <h4 class="modal-title fw-bold" id="locationModalLabel">Add Location</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with model: Location.new, url: locations_path, local: true do |f| %>
        <div class="modal-body p-4 pt-0 pb-2">
          <%= f.hidden_field :location_type, id: "modal_location_type" %>

          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :location_name, "Location Name", class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :location_name, class: "form-control rounded-3", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :country, class: "form-label fw-semibold small text-muted" %>
              <%= f.select :country,
                    ["Afghanistan", "Albania", "Algeria", "Andorra", "Angola", "Argentina", "Armenia", "Australia", "Austria", "Azerbaijan", "Bahamas", "Bahrain", "Bangladesh", "Barbados", "Belarus", "Belgium", "Belize", "Benin", "Bhutan", "Bolivia", "Bosnia and Herzegovina", "Botswana", "Brazil", "Brunei", "Bulgaria", "Burkina Faso", "Burundi", "Cambodia", "Cameroon", "Canada", "Cape Verde", "Central African Republic", "Chad", "Chile", "China", "Colombia", "Comoros", "Congo", "Costa Rica", "Croatia", "Cuba", "Cyprus", "Czech Republic", "Denmark", "Djibouti", "Dominica", "Dominican Republic", "Ecuador", "Egypt", "El Salvador", "Equatorial Guinea", "Eritrea", "Estonia", "Eswatini", "Ethiopia", "Fiji", "Finland", "France", "Gabon", "Gambia", "Georgia", "Germany", "Ghana", "Greece", "Grenada", "Guatemala", "Guinea", "Guinea-Bissau", "Guyana", "Haiti", "Honduras", "Hungary", "Iceland", "India", "Indonesia", "Iran", "Iraq", "Ireland", "Israel", "Italy", "Jamaica", "Japan", "Jordan", "Kazakhstan", "Kenya", "Kiribati", "Kuwait", "Kyrgyzstan", "Laos", "Latvia", "Lebanon", "Lesotho", "Liberia", "Libya", "Liechtenstein", "Lithuania", "Luxembourg", "Madagascar", "Malawi", "Malaysia", "Maldives", "Mali", "Malta", "Marshall Islands", "Mauritania", "Mauritius", "Mexico", "Micronesia", "Moldova", "Monaco", "Mongolia", "Montenegro", "Morocco", "Mozambique", "Myanmar", "Namibia", "Nauru", "Nepal", "Netherlands", "New Zealand", "Nicaragua", "Niger", "Nigeria", "North Korea", "North Macedonia", "Norway", "Oman", "Pakistan", "Palau", "Panama", "Papua New Guinea", "Paraguay", "Peru", "Philippines", "Poland", "Portugal", "Qatar", "Romania", "Russia", "Rwanda", "Saint Kitts and Nevis", "Saint Lucia", "Saint Vincent and the Grenadines", "Samoa", "San Marino", "Sao Tome and Principe", "Saudi Arabia", "Senegal", "Serbia", "Seychelles", "Sierra Leone", "Singapore", "Slovakia", "Slovenia", "Solomon Islands", "Somalia", "South Africa", "South Korea", "South Sudan", "Spain", "Sri Lanka", "Sudan", "Suriname", "Sweden", "Switzerland", "Syria", "Taiwan", "Tajikistan", "Tanzania", "Thailand", "Timor-Leste", "Togo", "Tonga", "Trinidad and Tobago", "Tunisia", "Turkey", "Turkmenistan", "Tuvalu", "Uganda", "Ukraine", "United Arab Emirates", "United Kingdom", "United States", "Uruguay", "Uzbekistan", "Vanuatu", "Vatican City", "Venezuela", "Vietnam", "Yemen", "Zambia", "Zimbabwe"],
                    {}, class: "form-select form-select rounded-3", required: true %>
            </div>

            <div class="col-md-6">
              <%= f.label :company_name, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :company_name, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-6">
              <%= f.label :tax_number, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :tax_number, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-4">
              <%= f.label :post_box, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :post_box, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-8">
              <%= f.label :street, "Street Name", class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :street, class: "form-control rounded-3", required: true %>
            </div>

            <div class="col-md-4">
              <%= f.label :building, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :building, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-8">
              <%= f.label :additional_street, "Additional Street Name", class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :additional_street, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-5">
              <%= f.label :zip_code, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :zip_code, class: "form-control rounded-3" %>
            </div>

            <div class="col-md-7">
              <%= f.label :city, class: "form-label fw-semibold small text-muted" %>
              <%= f.text_field :city, class: "form-control rounded-3", required: true %>
            </div>
          </div>
        </div>

        <div class="modal-footer border-0 d-flex justify-content-end gap-2 p-3">
          <button type="button" class="btn btn-back px-4" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Save Location", class: "btn btn-primary px-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

