<% content_for :page_title, "Edit Profile" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "profile", media: "all" %>
<% end %>

<div class="container py-4 py-md-3 profile-edit-container">
  
  <div class="profile-edit-card">
    
    <!-- Minimalist Page Title Header -->
    <div class="text-center mb-4">
      <h3 class="fw-bold mb-1">Edit Profile</h3>
      <p class="text-muted small mb-0">Manage your account credentials and security settings.</p>
    </div>

    <!-- Centered Avatar Section -->
    <div class="text-center mb-4">
      <div id="image-preview-wrapper" class="profile-avatar-wrapper" style="cursor: pointer;" title="Click photo to upload a new profile picture">
        
        <% has_attached_image = resource.profile_image.attached? && resource.profile_image.attachment&.persisted? %>
        <% email_prefix = resource.email.to_s.split("@").first %>
        <% initials = email_prefix.present? ? email_prefix.strip[0..1].upcase : "US" %>

        <% if has_attached_image %>
          <%= image_tag(
            url_for(resource.profile_image),
            id: "image-preview",
            class: "profile-avatar-img",
            alt: "Profile Avatar",
            loading: "lazy"
          ) %>
          <div id="initials-preview" class="profile-avatar-initials d-flex align-items-center justify-content-center fw-bold text-white" style="display: none !important;">
            <%= initials %>
          </div>
        <% else %>
          <%= image_tag(
            "",
            id: "image-preview",
            class: "profile-avatar-img",
            alt: "Profile Avatar",
            style: "display: none !important;",
            loading: "lazy"
          ) %>
          <div id="initials-preview" class="profile-avatar-initials d-flex align-items-center justify-content-center fw-bold text-white">
            <%= initials %>
          </div>
        <% end %>

        <!-- Floating Camera Button -->
        <label for="profile_image_input" class="profile-camera-btn" title="Upload new photo">
          <i class="fa-solid fa-camera"></i>
        </label>
      </div>

      <div class="fw-bold text-break text-main fs-6"><%= resource.email %></div>
      <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
        Click avatar to upload photo
      </small>
    </div>

    <!-- Main Form -->
    <%= form_for(resource,
         as: resource_name,
         url: profile_path,
         html: { method: :put, multipart: true }) do |f| %>

      <%= f.file_field :profile_image,
        accept: "image/*",
        id: "profile_image_input",
        style: "display: none;" %>

      <!-- Section 1: Account & Preferences -->
      <div class="mb-4">
        <div class="form-section-label">Account & Preferences</div>
        <div class="mb-3">
          <%= f.label :email, "Email Address", class: "form-label" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                required: true,
                class: "form-control #{'is-invalid' if resource.errors[:email].any?}" %>
          <% if resource.errors[:email].any? %>
            <div class="text-danger small mt-1">
              <%= resource.errors[:email].first.capitalize %>
            </div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :currency, "Preferred Dashboard Currency", class: "form-label" %>
          <%= f.select :currency,
                User::SUPPORTED_CURRENCIES.map { |code, name| ["#{code} — #{name}", code] },
                { selected: resource.currency.presence || "PHP" },
                class: "form-select #{'is-invalid' if resource.errors[:currency].any?}",
                id: "user_currency_select" %>
          <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
            Default currency used across your dashboard analytics, revenue charts, and KPI widgets.
          </small>
          <% if resource.errors[:currency].any? %>
            <div class="text-danger small mt-1">
              <%= resource.errors[:currency].first.capitalize %>
            </div>
          <% end %>
        </div>
      </div>

      <hr class="my-4 opacity-25">

      <!-- Section 2: Password & Security -->
      <div class="mb-4">
        <div class="form-section-label">Password Settings</div>
        
        <!-- New Password -->
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <%= f.label :password, "New Password", class: "form-label mb-0" %>
            <% if @minimum_password_length %>
              <span class="text-muted" style="font-size: 0.78rem;">(<%= @minimum_password_length %> chars min)</span>
            <% end %>
          </div>
          <div class="input-group flex-nowrap <%= 'has-validation' if resource.errors[:password].any? %>">
            <%= f.password_field :password,
                  autocomplete: "new-password",
                  class: "form-control toggle-password-input #{'is-invalid' if resource.errors[:password].any?}",
                  id: "password",
                  placeholder: "Leave blank to keep current" %>
            <span class="input-group-text" style="cursor: pointer;" title="Toggle Password Visibility">
              <i class="fa-solid fa-eye toggle-password-icon"></i>
            </span>
          </div>
          <% if resource.errors[:password].any? %>
            <div class="text-danger small mt-1">
              <%= resource.errors[:password].first.capitalize %>
            </div>
          <% end %>
        </div>

        <!-- Confirm Password -->
        <div class="mb-3">
          <%= f.label :password_confirmation, "Confirm New Password", class: "form-label" %>
          <div class="input-group flex-nowrap <%= 'has-validation' if resource.errors[:password_confirmation].any? %>">
            <%= f.password_field :password_confirmation,
                  autocomplete: "new-password",
                  class: "form-control toggle-password-input #{'is-invalid' if resource.errors[:password_confirmation].any?}",
                  id: "password_confirmation",
                  placeholder: "Confirm new password" %>
            <span class="input-group-text" style="cursor: pointer;" title="Toggle Password Visibility">
              <i class="fa-solid fa-eye toggle-password-icon"></i>
            </span>
          </div>
          <% if resource.errors[:password_confirmation].any? %>
            <div class="text-danger small mt-1">
              <%= resource.errors[:password_confirmation].first.capitalize %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Section 3: Current Password (Required only if changing password) -->
      <div class="security-note-box mb-4">
        <div class="mb-2">
          <%= f.label :current_password, "Current Password", class: "form-label fw-bold mb-1 text-main" %>
          <small class="text-muted d-block mb-2" style="font-size: 0.8rem;">
            Only required if you are setting a new password above.
          </small>
        </div>
        <div class="input-group flex-nowrap <%= 'has-validation' if resource.errors[:current_password].any? %>">
          <%= f.password_field :current_password,
                autocomplete: "current-password",
                class: "form-control toggle-password-input #{'is-invalid' if resource.errors[:current_password].any?}",
                id: "current_password",
                placeholder: "Enter current password (if changing password)" %>
          <span class="input-group-text" style="cursor: pointer;" title="Toggle Password Visibility">
            <i class="fa-solid fa-eye toggle-password-icon"></i>
          </span>
        </div>
        <% if resource.errors[:current_password].any? %>
          <div class="text-danger small mt-2">
            <%= resource.errors[:current_password].first.capitalize %>
          </div>
        <% end %>
      </div>

      <!-- Action Buttons -->
      <div class="d-flex justify-content-between align-items-center gap-3 mt-4 pt-1">
        <%= link_to session[:profile_back_url] || root_path, class: "btn btn-back rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" do %>
          <i class="fa-solid fa-arrow-left"></i> Back
        <% end %>
        
        <%= f.button type: "submit", class: "btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm", id: "update-profile-btn" do %>
          <i class="fa-solid fa-check"></i> Save Changes
        <% end %>
      </div>

    <% end %>

  </div>

</div>
