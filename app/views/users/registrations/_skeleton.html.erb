<!-- Profile Edit Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="profile-edit-skeleton" aria-hidden="true">
  <div class="profile-edit-card">
    <!-- Minimalist Page Title Header Skeleton -->
    <div class="text-center mb-4">
      <div class="skeleton-line skeleton-title mx-auto mb-1.5" style="width: 150px; height: 24px;"></div>
      <div class="skeleton-line skeleton-line-xs mx-auto mb-0" style="width: 260px; height: 12px;"></div>
    </div>

    <!-- Centered Avatar Section Skeleton -->
    <div class="text-center mb-4">
      <div class="skeleton-avatar-lg mx-auto mb-2" style="width: 88px; height: 88px;"></div>
      <div class="skeleton-line skeleton-line-sm mx-auto mb-1" style="width: 150px; height: 14px;"></div>
      <div class="skeleton-line skeleton-line-xs mx-auto mb-0" style="width: 110px; height: 10px;"></div>
    </div>

    <!-- Section 1: Account Preferences Skeleton -->
    <div class="mb-4">
      <div class="skeleton-line skeleton-line-xs mb-3" style="width: 130px; height: 11px;"></div>
      <div class="mb-3">
        <div class="skeleton-line skeleton-line-xs mb-2" style="width: 90px; height: 11px;"></div>
        <div class="skeleton-input" style="height: 38px;"></div>
      </div>
      <div class="mb-3">
        <div class="skeleton-line skeleton-line-xs mb-2" style="width: 140px; height: 11px;"></div>
        <div class="skeleton-input" style="height: 38px;"></div>
      </div>
    </div>

    <hr class="my-4 opacity-25" style="border-color: var(--skeleton-border) !important;">

    <!-- Section 2: Password Settings Skeleton -->
    <div class="mb-4">
      <div class="skeleton-line skeleton-line-xs mb-3" style="width: 120px; height: 11px;"></div>
      <div class="mb-3">
        <div class="skeleton-line skeleton-line-xs mb-2" style="width: 100px; height: 11px;"></div>
        <div class="skeleton-input" style="height: 38px;"></div>
      </div>
      <div class="mb-3">
        <div class="skeleton-line skeleton-line-xs mb-2" style="width: 140px; height: 11px;"></div>
        <div class="skeleton-input" style="height: 38px;"></div>
      </div>
    </div>

    <!-- Action Buttons Skeleton -->
    <div class="d-flex justify-content-between align-items-center gap-3 mt-4 pt-1">
      <div class="skeleton-btn-pill" style="width: 95px; height: 38px;"></div>
      <div class="skeleton-btn-pill" style="width: 145px; height: 38px;"></div>
    </div>
  </div>
</div>

