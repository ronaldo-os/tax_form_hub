<% content_for :email_title, "Tax Submission Status Updated" %>
<% content_for :email_category, "Tax Submission" %>
<% content_for :email_accent, "primary" %>
<% content_for :email_preheader, "Your tax submission has been updated: #{@status_message}" %>
<% content_for :email_footer_note, "If you have any questions about this status update, please contact the Tax Form Hub team." %>

<%= render "shared/mailer/header",
      title: "Your tax submission was updated",
      subtitle: "There is a new status update on your submitted tax documents.",
      status_label: "Status Updated",
      status_tone: :primary %>

<%= render "shared/mailer/details_table", rows: [
      { label: "Status", value: @status_message, emphasize: true },
      { label: "Submission ID", value: "##{@tax_submission.id}" }
    ] %>

<%= render "shared/mailer/button",
      label: "View Submission",
      url: root_url(open_submission: @tax_submission.id),
      tone: :primary %>
