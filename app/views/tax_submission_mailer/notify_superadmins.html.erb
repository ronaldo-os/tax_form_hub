<%
  rows = []
  rows << { label: "Submitted Email", value: @tax_submission.email, emphasize: true } if @tax_submission.email.present?
  rows << { label: "Notes", value: @tax_submission.details.presence || "None" }
  rows << { label: "Submitted On", value: (@tax_submission.created_at || Time.current).strftime("%B %d, %Y") }
%>
<% content_for :email_title, "New Tax Submission Received" %>
<% content_for :email_category, "Admin Alert" %>
<% content_for :email_accent, "primary" %>
<% content_for :email_preheader, "A new tax submission was received from #{@tax_submission.email.presence || 'a user'}." %>
<% content_for :email_footer_note, "You’re receiving this automated notification because you have administrator access to tax submissions on Tax Form Hub." %>

<%= render "shared/mailer/header",
      title: "New tax submission received",
      subtitle: "A new tax document submission is ready for review in the admin dashboard.",
      status_label: "Pending Review",
      status_tone: :primary %>

<%= render "shared/mailer/details_table", rows: rows %>

<%= render "shared/mailer/button",
      label: "Review in Dashboard",
      url: admin_tax_submissions_url(open_submission: @tax_submission.id),
      tone: :primary %>
