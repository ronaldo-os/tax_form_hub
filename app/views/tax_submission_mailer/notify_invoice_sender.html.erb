<% content_for :email_title, "New Tax Documents Submitted" %>
<% content_for :email_category, "Tax Submission" %>
<% content_for :email_accent, "primary" %>
<% content_for :email_preheader, "New tax documents were submitted for Invoice ##{@tax_submission.invoice&.invoice_number} by #{@tax_submission.email}." %>

<%= render "shared/mailer/header",
      title: "New tax documents submitted",
      subtitle: "#{@tax_submission.email} uploaded tax documents linked to your invoice.",
      status_label: "New Documents",
      status_tone: :primary %>

<%= render "shared/mailer/details_table", rows: [
      { label: "Invoice Number", value: @tax_submission.invoice&.invoice_number, emphasize: true },
      { label: "Submitted By", value: @tax_submission.email },
      { label: "Details", value: @tax_submission.details.presence || "No additional details" },
      { label: "Submission Date", value: @tax_submission.created_at&.strftime("%B %d, %Y") }
    ] %>

<%= render "shared/mailer/button",
      label: "View Dashboard",
      url: root_url,
      tone: :primary %>
