<%
  has_both_docs = @tax_submission.form_2307.attached? && @tax_submission.deposit_slip.attached?
  rows = [
    { label: "Submission Status", value: "Received", emphasize: true }
  ]
  rows << { label: "Submitted From", value: "[#{@sender_source}]" } if has_both_docs
  rows << { label: "Additional Notes", value: @tax_submission.details.presence || "None provided" }
%>
<% content_for :email_title, "Tax Document Submission Confirmation" %>
<% content_for :email_category, "Tax Submission" %>
<% content_for :email_accent, "success" %>
<% content_for :email_preheader, "We’ve received your tax documents and our team will review them shortly." %>
<% content_for :email_footer_note, "This confirmation was sent after uploading tax documents on Tax Form Hub. If you believe this was a mistake, please contact support." %>

<%= render "shared/mailer/header",
      title: "Thank you for your submission",
      subtitle: "We’ve received your tax documents and our team will review them shortly.",
      status_label: "Received",
      status_tone: :success %>

<%= render "shared/mailer/details_table", rows: rows %>

<%= render "shared/mailer/button",
      label: "View Submission",
      url: root_url(open_submission: @tax_submission.id),
      tone: :primary %>
