<% formatted_total = email_format_amount(@credit_note.grand_total, @credit_note.currency) %>
<% from_name = @credit_note.user.company&.name || @credit_note.user.email %>
<% content_for :email_title, "Credit Note Created" %>
<% content_for :email_category, "Credit Note" %>
<% content_for :email_accent, "warning" %>
<% content_for :email_preheader, "Credit Note ##{@credit_note.invoice_number} (#{formatted_total}) was issued for Invoice ##{@original_invoice&.invoice_number}." %>

<%= render "shared/mailer/header",
      title: "A credit note has been created",
      subtitle: "#{@credit_note.user.email} issued a credit note linked to your invoice.",
      status_label: "Credit Note Issued",
      status_tone: :warning %>

<%= render "shared/mailer/details_table", rows: [
      { label: "Credit Note Number", value: @credit_note.invoice_number, emphasize: true },
      { label: "Original Invoice", value: @original_invoice&.invoice_number },
      { label: "From", value: from_name },
      { label: "To", value: @credit_note.recipient_company&.name },
      { label: "Total Amount", value: formatted_total, emphasize: true },
      { label: "Date", value: @credit_note.created_at&.strftime("%b %d, %Y") }
    ] %>

<%= render "shared/mailer/button",
      label: "View Credit Note",
      url: invoices_url,
      tone: :primary %>
