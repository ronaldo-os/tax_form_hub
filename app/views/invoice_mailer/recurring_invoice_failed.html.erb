<%
  contract_number = @contract.respond_to?(:invoice_number) ? @contract.invoice_number : "##{@contract.id}"
  customer_name = (@contract.respond_to?(:recipient_company) && @contract.recipient_company&.name) || "Customer"
  primary_item = @contract.respond_to?(:primary_recurring_item) ? @contract.primary_recurring_item : nil
  cycle = (primary_item && primary_item[:cycle]) ? primary_item[:cycle].capitalize : "Monthly"
  destination_url = begin subscription_url(@contract) rescue invoices_url end
  billing_date = @on_date&.strftime("%b %d, %Y") || Date.current.strftime("%b %d, %Y")

  summary_rows = [
    { label: "Contract / Invoice Number", value: contract_number, emphasize: true },
    { label: "Customer", value: customer_name },
    { label: "Billing Cycle", value: cycle },
    { label: "Attempted Billing Date", value: billing_date }
  ]
  if @contract.respond_to?(:grand_total)
    currency = @contract.respond_to?(:currency) ? @contract.currency : "PHP"
    summary_rows << { label: "Contract Amount", value: email_format_amount(@contract.grand_total, currency), emphasize: true }
  end
%>
<% content_for :email_title, "Recurring Invoice Generation Failed" %>
<% content_for :email_category, "Billing Alert" %>
<% content_for :email_accent, "danger" %>
<% content_for :email_preheader, "Action required: Recurring invoice generation failed for #{contract_number}." %>

<%= render "shared/mailer/header",
      title: "Recurring invoice generation failed",
      subtitle: "An automated background billing cycle could not be completed for your recurring subscription.",
      status_label: "Action Required",
      status_tone: :danger %>

<%= render "shared/mailer/callout",
      title: "Error Details",
      body: @error_message,
      tone: :danger,
      monospace: true %>

<%= render "shared/mailer/details_table", rows: summary_rows %>

<p style="margin:0 0 24px 0;font-size:14px;line-height:22px;color:#475569;">
  Please review the contract details, verify that line items and customer settings are valid, and retry recurring invoice generation.
</p>

<%= render "shared/mailer/button",
      label: "View Subscription & Retry",
      url: destination_url,
      tone: :danger %>
