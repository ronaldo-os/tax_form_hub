<%
  doc_type = @invoice.quote? ? "Quotation" : "Invoice"
  action_config = {
    invoice_sent:     { title: "New Invoice Received",    status: "New",      accent: :primary, subtitle: "#{@sender_user&.email} sent you a new invoice on Tax Form Hub." },
    quote_sent:       { title: "New Quotation Received",  status: "New",      accent: :primary, subtitle: "#{@sender_user&.email} sent you a new quotation on Tax Form Hub." },
    invoice_approved: { title: "Invoice Approved",        status: "Approved", accent: :success, subtitle: "#{@sender_user&.email} approved your invoice." },
    invoice_rejected: { title: "Invoice Rejected",        status: "Rejected", accent: :danger,  subtitle: "#{@sender_user&.email} rejected your invoice." },
    quote_approved:   { title: "Quotation Approved",      status: "Approved", accent: :success, subtitle: "#{@sender_user&.email} approved your quotation." },
    quote_rejected:   { title: "Quotation Rejected",      status: "Rejected", accent: :danger,  subtitle: "#{@sender_user&.email} rejected your quotation." }
  }
  config = action_config[@action] || { title: "#{doc_type} Update", status: "Updated", accent: :primary, subtitle: "Action by #{@sender_user&.email}" }
  from_name = @original_sender_user&.company&.name || @original_sender_user&.email || @invoice.user.company&.name || @invoice.user.email
  formatted_total = email_format_amount(@invoice.grand_total, @invoice.currency)
%>
<% content_for :email_title, config[:title] %>
<% content_for :email_category, doc_type %>
<% content_for :email_accent, config[:accent].to_s %>
<% content_for :email_preheader, "#{config[:title]} — #{doc_type} ##{@invoice.invoice_number} (#{formatted_total})." %>

<%= render "shared/mailer/header",
      title: config[:title],
      subtitle: config[:subtitle],
      status_label: config[:status],
      status_tone: config[:accent] %>

<%= render "shared/mailer/details_table", rows: [
      { label: "#{doc_type} Number", value: @invoice.invoice_number, emphasize: true },
      { label: "From", value: from_name },
      { label: "To", value: @invoice.recipient_company&.name },
      { label: "Total Amount", value: formatted_total, emphasize: true },
      { label: "Date", value: @invoice.created_at&.strftime("%b %d, %Y") }
    ] %>

<%= render "shared/mailer/button",
      label: "View #{doc_type}",
      url: invoices_url,
      tone: :primary %>
