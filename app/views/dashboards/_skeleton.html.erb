<!-- Dashboard Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="analytics-dashboard-skeleton" aria-hidden="true">
  <!-- Bento Control Bar Skeleton -->
  <div class="dashboard-header-card mb-3 mb-md-3.5">
    <div class="d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center justify-content-between gap-2.5">
      <div>
        <div class="skeleton-line skeleton-title mb-1" style="width: 240px; height: 22px;"></div>
        <div class="skeleton-line skeleton-line-xs mb-0" style="width: 320px; height: 12px;"></div>
      </div>
      <div class="d-flex flex-wrap align-items-center justify-content-between justify-content-xl-end gap-2">
        <div class="dashboard-filter-btn-group p-1" style="min-width: 330px; height: 34px;">
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
          <div class="skeleton-pill flex-grow-1" style="height: 26px;"></div>
        </div>
        <div class="d-flex align-items-center gap-1.5 flex-nowrap">
          <div class="skeleton-btn" style="width: 34px; height: 31px; border-radius: 0.5rem;"></div>
          <div class="skeleton-btn" style="width: 72px; height: 31px; border-radius: 0.5rem;"></div>
          <div class="skeleton-btn" style="width: 125px; height: 31px; border-radius: 0.5rem;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Executive Financial Bento Grid (4-Tile Core Metrics) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5">
    <% 4.times do %>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="bento-card h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="bento-card-header mb-2.5">
              <div class="skeleton-line skeleton-title-sm mb-0" style="width: 55%; height: 14px;"></div>
              <div class="skeleton-pill" style="width: 48px; height: 20px;"></div>
            </div>
            <div class="mb-3">
              <div class="skeleton-value mb-2" style="width: 70%; height: 32px;"></div>
              <div class="d-flex justify-content-between mb-1.5">
                <div class="skeleton-line skeleton-line-xs mb-0" style="width: 35%; height: 10px;"></div>
                <div class="skeleton-line skeleton-line-xs mb-0" style="width: 20%; height: 10px;"></div>
              </div>
              <div class="skeleton-progress" style="height: 5px;"></div>
            </div>
          </div>
          <div class="d-flex gap-2 pt-2 border-top mt-auto" style="border-color: var(--skeleton-border) !important;">
            <div class="flex-grow-1">
              <div class="skeleton-line skeleton-line-xs mb-1" style="width: 60%; height: 9px;"></div>
              <div class="skeleton-line skeleton-line-sm mb-0" style="width: 80%; height: 12px;"></div>
            </div>
            <div class="flex-grow-1">
              <div class="skeleton-line skeleton-line-xs mb-1" style="width: 60%; height: 9px;"></div>
              <div class="skeleton-line skeleton-line-sm mb-0" style="width: 80%; height: 12px;"></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Central Bento Analytics Section (8-Col Chart + 4-Col Urgent Actions) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5">
    <!-- Chart Skeleton (8-Col) -->
    <div class="col-12 col-xl-8">
      <div class="bento-card h-100">
        <div class="bento-card-header flex-wrap mb-3">
          <div>
            <div class="skeleton-line skeleton-title mb-1" style="width: 170px; height: 16px;"></div>
            <div class="skeleton-line skeleton-line-xs mb-0" style="width: 130px; height: 11px;"></div>
          </div>
          <div class="dashboard-filter-btn-group p-1" style="width: 260px; height: 30px;">
            <div class="skeleton-pill flex-grow-1" style="height: 22px;"></div>
            <div class="skeleton-pill flex-grow-1" style="height: 22px;"></div>
            <div class="skeleton-pill flex-grow-1" style="height: 22px;"></div>
            <div class="skeleton-pill flex-grow-1" style="height: 22px;"></div>
          </div>
        </div>
        <div class="skeleton-chart-container" style="height: 270px;">
          <div class="skeleton-chart-bar" style="height: 40%;"></div>
          <div class="skeleton-chart-bar" style="height: 65%;"></div>
          <div class="skeleton-chart-bar" style="height: 82%;"></div>
          <div class="skeleton-chart-bar" style="height: 48%;"></div>
          <div class="skeleton-chart-bar" style="height: 72%;"></div>
          <div class="skeleton-chart-bar" style="height: 88%;"></div>
          <div class="skeleton-chart-bar" style="height: 76%;"></div>
          <div class="skeleton-chart-bar" style="height: 58%;"></div>
          <div class="skeleton-chart-bar" style="height: 84%;"></div>
          <div class="skeleton-chart-bar" style="height: 94%;"></div>
          <div class="skeleton-chart-bar" style="height: 68%;"></div>
          <div class="skeleton-chart-bar" style="height: 85%;"></div>
        </div>
        <div class="d-flex justify-content-between pt-2 border-top mt-2" style="border-color: var(--skeleton-border) !important;">
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 25px;"></div>
        </div>
      </div>
    </div>

    <!-- Urgent Actions Skeleton (4-Col) -->
    <div class="col-12 col-xl-4">
      <div class="bento-card h-100 d-flex flex-column">
        <div class="bento-card-header mb-3">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 150px; height: 16px;"></div>
          <div class="skeleton-badge" style="width: 28px; height: 18px;"></div>
        </div>
        <div class="d-flex flex-column gap-2.5 flex-grow-1">
          <% 3.times do %>
            <div class="p-2.5 rounded-3 d-flex align-items-center justify-content-between gap-2" style="background-color: var(--skeleton-card-bg); border: 1px solid var(--skeleton-border);">
              <div class="flex-grow-1 min-w-0">
                <div class="skeleton-line skeleton-line-sm mb-1" style="width: 75%; height: 13px;"></div>
                <div class="skeleton-line skeleton-line-xs mb-0" style="width: 90%; height: 10px;"></div>
              </div>
              <div class="skeleton-btn" style="width: 65px; height: 26px; border-radius: 0.375rem;"></div>
            </div>
          <% end %>
        </div>
        <div class="pt-3 border-top mt-3" style="border-color: var(--skeleton-border) !important;">
          <div class="skeleton-line skeleton-line-xs mb-2" style="width: 60px;"></div>
          <div class="d-flex gap-2">
            <div class="skeleton-pill" style="width: 75px; height: 26px;"></div>
            <div class="skeleton-pill" style="width: 85px; height: 26px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lower Bento Section: Counterparties (6-Col) & Tax Compliance / Status Donut (6-Col) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5">
    <!-- Counterparties Bento (6-Col) -->
    <div class="col-12 col-lg-6">
      <div class="bento-card h-100">
        <div class="bento-card-header mb-3">
          <div class="skeleton-line skeleton-title mb-0" style="width: 150px; height: 16px;"></div>
          <div class="dashboard-filter-btn-group p-1" style="width: 160px; height: 28px;">
            <div class="skeleton-pill flex-grow-1" style="height: 20px;"></div>
            <div class="skeleton-pill flex-grow-1" style="height: 20px;"></div>
          </div>
        </div>
        <div class="d-flex flex-column gap-2.5 py-1">
          <% 5.times do |i| %>
            <div class="d-flex align-items-center justify-content-between gap-2.5">
              <div class="skeleton-box" style="width: 16px; height: 14px; border-radius: 3px;"></div>
              <div class="skeleton-circle skeleton-circle-sm" style="width: 28px; height: 28px;"></div>
              <div class="flex-grow-1 min-w-0">
                <div class="skeleton-line skeleton-line-sm mb-1" style="width: 55%; height: 12px;"></div>
                <div class="skeleton-progress" style="height: 4px;"></div>
              </div>
              <div class="skeleton-line skeleton-line-sm mb-0 text-end" style="width: 75px; height: 12px;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Status Donut / Realization Bento (6-Col) -->
    <div class="col-12 col-lg-6">
      <div class="bento-card h-100 text-center">
        <div class="bento-card-header mb-2">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 160px; height: 16px;"></div>
          <div class="skeleton-pill" style="width: 90px; height: 26px;"></div>
        </div>
        <div class="skeleton-donut-wrapper my-2">
          <div class="skeleton-donut"></div>
        </div>
        <div class="d-flex justify-content-around mt-3 pt-2 border-top" style="border-color: var(--skeleton-border) !important;">
          <div class="d-flex align-items-center gap-1.5">
            <div class="skeleton-circle" style="width: 10px; height: 10px;"></div>
            <div class="skeleton-line skeleton-line-xs mb-0" style="width: 55px; height: 10px;"></div>
          </div>
          <div class="d-flex align-items-center gap-1.5">
            <div class="skeleton-circle" style="width: 10px; height: 10px;"></div>
            <div class="skeleton-line skeleton-line-xs mb-0" style="width: 55px; height: 10px;"></div>
          </div>
          <div class="d-flex align-items-center gap-1.5">
            <div class="skeleton-circle" style="width: 10px; height: 10px;"></div>
            <div class="skeleton-line skeleton-line-xs mb-0" style="width: 55px; height: 10px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bento: Recent Transactions (8-Col) & Shortcuts/Tasks (4-Col) -->
  <div class="row g-3 g-md-3.5">
    <div class="col-12 col-xl-8">
      <div class="bento-card h-100">
        <div class="bento-card-header mb-3">
          <div>
            <div class="skeleton-line skeleton-title mb-1" style="width: 160px; height: 16px;"></div>
            <div class="skeleton-line skeleton-line-xs mb-0" style="width: 200px; height: 11px;"></div>
          </div>
          <div class="skeleton-btn" style="width: 85px; height: 26px; border-radius: 0.375rem;"></div>
        </div>
        <div class="table-responsive">
          <table class="skeleton-table">
            <thead>
              <tr>
                <th style="width: 18%;"><div class="skeleton-line skeleton-line-xs mb-0" style="width: 60px;"></div></th>
                <th style="width: 14%;"><div class="skeleton-line skeleton-line-xs mb-0" style="width: 45px;"></div></th>
                <th style="width: 28%;"><div class="skeleton-line skeleton-line-xs mb-0" style="width: 75px;"></div></th>
                <th style="width: 16%;"><div class="skeleton-line skeleton-line-xs mb-0" style="width: 50px;"></div></th>
                <th style="width: 14%; text-align: right;"><div class="skeleton-line skeleton-line-xs ms-auto mb-0" style="width: 55px;"></div></th>
                <th style="width: 10%; text-align: center;"><div class="skeleton-line skeleton-line-xs mx-auto mb-0" style="width: 40px;"></div></th>
              </tr>
            </thead>
            <tbody>
              <% 5.times do %>
                <tr>
                  <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 75%;"></div></td>
                  <td><div class="skeleton-pill mb-0" style="width: 48px; height: 18px;"></div></td>
                  <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 85%;"></div></td>
                  <td><div class="skeleton-line skeleton-line-xs mb-0" style="width: 65%;"></div></td>
                  <td class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 70px;"></div></td>
                  <td class="text-center"><div class="skeleton-pill mx-auto mb-0" style="width: 52px; height: 18px;"></div></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4">
      <div class="bento-card h-100 d-flex flex-column justify-content-between">
        <div>
          <div class="bento-card-header mb-3">
            <div class="skeleton-line skeleton-title-sm mb-0" style="width: 140px; height: 16px;"></div>
            <div class="skeleton-pill" style="width: 55px; height: 20px;"></div>
          </div>
          <div class="d-flex flex-column gap-2.5">
            <% 3.times do %>
              <div class="d-flex align-items-center gap-2 p-2 rounded-2" style="background-color: var(--skeleton-card-bg); border: 1px solid var(--skeleton-border);">
                <div class="skeleton-circle" style="width: 24px; height: 24px;"></div>
                <div class="flex-grow-1">
                  <div class="skeleton-line skeleton-line-sm mb-1" style="width: 70%; height: 11px;"></div>
                  <div class="skeleton-line skeleton-line-xs mb-0" style="width: 50%; height: 9px;"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="pt-3 border-top mt-3" style="border-color: var(--skeleton-border) !important;">
          <div class="skeleton-line skeleton-line-xs mb-2" style="width: 55px;"></div>
          <div class="d-flex flex-wrap gap-2">
            <div class="skeleton-pill" style="width: 80px; height: 28px;"></div>
            <div class="skeleton-pill" style="width: 80px; height: 28px;"></div>
            <div class="skeleton-pill" style="width: 75px; height: 28px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
