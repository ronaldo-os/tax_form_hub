<% 
  company_name = current_user.company&.name
  full_title = company_name.present? ? "#{company_name} — Financial Intelligence" : "Financial Intelligence & KPIs"
  currency_symbol = case @dashboard_data[:currency]
                    when "USD" then "$"
                    when "EUR" then "€"
                    when "PHP" then "₱"
                    when "GBP" then "£"
                    else "$"
                    end
  kpis = @dashboard_data[:kpis]
%>
<% content_for :page_title, "Dashboard & Analytics" %>
<% content_for :title, "Dashboard — Tax Form Hub" %>

<div class="analytics-dashboard-page container-fluid px-2 px-sm-3 px-md-4 py-3" id="analytics_dashboard_container" data-initial-data="<%= html_escape(@dashboard_data.to_json) %>">
  
  <!-- Bento Control Bar -->
  <div class="dashboard-header-card mb-3 mb-md-3.5">
    <div class="d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center justify-content-between gap-2.5">
      
      <!-- Greeting & Scope -->
      <div class="min-w-0">
        <h2 class="h5 mb-0.5 fw-bold text-main text-truncate">
          <%= company_name.present? ? company_name : "Financial Intelligence" %>
        </h2>
        <p class="text-muted fs-8 mb-0" id="header_date_range_text">
          <%= @dashboard_data[:range_label] || "Executive financial metrics, sales realization, and cash flow." %>
        </p>
      </div>

      <!-- Segmented Controls & Quick Action Buttons -->
      <div class="d-flex flex-wrap align-items-center justify-content-between justify-content-xl-end gap-2">
        
        <!-- Segmented Timeframe Switcher (Scrollable on phones & tablets) -->
        <div class="dashboard-filter-scroll-wrapper">
          <div class="dashboard-filter-btn-group" role="group" aria-label="Timeframe selector" id="dashboard_timeframe_group">
            <button type="button" class="btn <%= 'active' if @time_frame == '7d' %>" data-time-frame="7d">7D</button>
            <button type="button" class="btn <%= 'active' if @time_frame == '30d' %>" data-time-frame="30d">30D</button>
            <button type="button" class="btn <%= 'active' if @time_frame == 'this_month' %>" data-time-frame="this_month">This Month</button>
            <button type="button" class="btn <%= 'active' if @time_frame == 'last_month' %>" data-time-frame="last_month">Last Month</button>
            <button type="button" class="btn <%= 'active' if @time_frame == 'this_quarter' %>" data-time-frame="this_quarter">Quarter</button>
            <button type="button" class="btn <%= 'active' if @time_frame == 'ytd' %>" data-time-frame="ytd">YTD</button>
            <button type="button" class="btn <%= 'active' if @time_frame == 'all_time' %>" data-time-frame="all_time">All Time</button>
          </div>
        </div>

        <!-- Action Cluster: Refresh + Currency + Seamless Split Action Button -->
        <div class="d-flex align-items-center gap-1.5 ms-auto ms-xl-0">
          
          <!-- Instant Refresh Button -->
          <button type="button" class="btn btn-outline-secondary btn-sm header-action-btn px-2 me-2" id="btn_refresh_dashboard" title="Refresh Live Data" aria-label="Refresh Dashboard Data">
            <i class="fa-solid fa-rotate fs-9" id="btn_refresh_icon"></i>
          </button>

          <!-- Currency Selector -->
          <% if @dashboard_data[:available_currencies].size > 1 %>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle header-action-btn px-2.5 py-1 fs-8 fw-medium" type="button" id="dashboardCurrencyDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <span id="selected_currency_label"><%= @currency.upcase %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-1.5 rounded-3 fs-8" aria-labelledby="dashboardCurrencyDropdown">
                <li class="dropdown-header text-uppercase fs-10 fw-semibold text-muted px-2.5 py-1">Currency</li>
                <li><a class="dropdown-item currency-select-item rounded-2 <%= 'active fw-bold' if @currency == 'all' %>" href="#" data-currency="all">All Currencies</a></li>
                <li><hr class="dropdown-divider my-1 opacity-25"></li>
                <% @dashboard_data[:available_currencies].each do |curr| %>
                  <li><a class="dropdown-item currency-select-item rounded-2 <%= 'active fw-bold' if @currency == curr %>" href="#" data-currency="<%= curr %>"><%= curr %></a></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Primary Action: Seamless Split Dropdown -->
          <div class="btn-group header-split-btn-group">
            <%= link_to new_invoice_path, class: "btn btn-primary btn-sm d-inline-flex align-items-center gap-1.5 text-nowrap" do %>
              <i class="fa-solid fa-plus fs-9"></i> New Invoice
            <% end %>
            <button type="button" class="btn btn-primary btn-sm dropdown-toggle dropdown-toggle-split px-2" data-bs-toggle="dropdown" aria-expanded="false" title="More Actions">
              <span class="visually-hidden">Toggle Dropdown</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-1.5 rounded-3 fs-8">
              <li class="dropdown-header text-uppercase fs-10 fw-semibold text-muted px-2.5 py-1">Create Records</li>
              <li>
                <%= link_to new_invoice_path(invoice_type: 'sale'), class: "dropdown-item rounded-2 d-flex align-items-center gap-2 py-1.5" do %>
                  <i class="fa-solid fa-file-invoice text-success"></i> Sales Invoice
                <% end %>
              </li>
              <li>
                <%= link_to new_invoice_path(invoice_type: 'purchase'), class: "dropdown-item rounded-2 d-flex align-items-center gap-2 py-1.5" do %>
                  <i class="fa-solid fa-file-lines text-info"></i> Purchase Bill
                <% end %>
              </li>
              <li><hr class="dropdown-divider my-1 opacity-25"></li>
              <li class="dropdown-header text-uppercase fs-10 fw-semibold text-muted px-2.5 py-1">Quick Navigation</li>
              <li>
                <%= link_to tax_submissions_home_path, class: "dropdown-item rounded-2 d-flex align-items-center gap-2 py-1.5" do %>
                  <i class="fa-solid fa-file-invoice-dollar text-primary"></i> Taxes Hub
                <% end %>
              </li>
              <li>
                <%= link_to invoices_path, class: "dropdown-item rounded-2 d-flex align-items-center gap-2 py-1.5" do %>
                  <i class="fa-solid fa-list-check text-muted"></i> All Invoices & Bills
                <% end %>
              </li>
              <li>
                <%= link_to subscriptions_path, class: "dropdown-item rounded-2 d-flex align-items-center gap-2 py-1.5" do %>
                  <i class="fa-solid fa-repeat text-warning"></i> Subscriptions
                <% end %>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Zero-State Onboarding Banner (When no data exists) -->
  <% if kpis[:total_sales_count] == 0 && kpis[:total_purchases_count] == 0 %>
    <div class="zero-state-banner mb-3 mb-md-3.5">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <h6 class="fw-bold text-main mb-0.5">Welcome to your Financial Intelligence Hub</h6>
          <p class="text-muted fs-8 mb-0">
            Create sales invoices or submit your BIR Form 2307 documents to unlock real-time financial tracking and calculations.
          </p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to new_invoice_path, class: "btn btn-primary btn-sm rounded-2 px-3 py-1 fs-8 fw-semibold" do %>
            Create Invoice
          <% end %>
          <%= link_to tax_submissions_home_path, class: "btn btn-outline-secondary btn-sm rounded-2 px-3 py-1 fs-8 fw-semibold" do %>
            Taxes Hub
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Primary Executive Financial Bento Grid (4-Tile Core Metrics) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5" id="financial_kpi_grid">
    
    <!-- 1. Total Sales Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Total Sales Revenue</span>
          <span class="bento-trend <%= kpis[:sales_revenue_growth] >= 0 ? 'bento-trend-up' : 'bento-trend-down' %>" id="kpi_sales_growth_tag">
            <i class="fa-solid <%= kpis[:sales_revenue_growth] >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %> fs-10"></i>
            <%= kpis[:sales_revenue_growth].abs %>%
          </span>
        </div>
        <div class="mb-2.5">
          <div class="bento-value bento-financial-value tabular-nums text-truncate" id="kpi_sales_revenue_val">
            <%= number_to_currency(kpis[:total_sales_revenue], unit: currency_symbol) %>
          </div>
          <div class="d-flex align-items-center justify-content-between mt-1.5">
            <small class="text-muted fs-9">Collection Rate</small>
            <small class="fw-semibold text-main fs-9 tabular-nums" id="kpi_sales_coll_rate"><%= kpis[:sales_collection_rate] %>%</small>
          </div>
          <div class="partner-progress-bar mt-1">
            <div class="partner-progress-fill bg-success" id="kpi_sales_coll_bar" style="width: <%= [kpis[:sales_collection_rate], 100].min %>%;"></div>
          </div>
        </div>
        <div class="bento-substats-row mt-auto">
          <div class="substat-item">
            <span class="substat-label">Collected</span>
            <span class="substat-value text-success tabular-nums" id="kpi_paid_sales_rev">
              <%= number_to_currency(kpis[:paid_sales_revenue], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Receivables</span>
            <span class="substat-value text-warning tabular-nums" id="kpi_sales_receivables">
              <%= number_to_currency(kpis[:total_receivables], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Avg / Sale</span>
            <span class="substat-value text-main tabular-nums" id="kpi_avg_sale_val">
              <%= number_to_currency(kpis[:avg_sale_invoice_value], unit: currency_symbol) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Total Purchases / Spend -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Total Purchases / Spend</span>
          <span class="bento-trend <%= kpis[:purchases_growth] <= 0 ? 'bento-trend-up' : 'bento-trend-down' %>" id="kpi_purchases_growth_tag">
            <i class="fa-solid <%= kpis[:purchases_growth] >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %> fs-10"></i>
            <%= kpis[:purchases_growth].abs %>%
          </span>
        </div>
        <div class="mb-2.5">
          <div class="bento-value bento-financial-value tabular-nums text-truncate" id="kpi_purchases_expense_val">
            <%= number_to_currency(kpis[:total_purchases_expense], unit: currency_symbol) %>
          </div>
          <div class="d-flex align-items-center justify-content-between mt-1.5">
            <small class="text-muted fs-9">Settlement Rate</small>
            <small class="fw-semibold text-main fs-9 tabular-nums" id="kpi_purch_settle_rate"><%= kpis[:purchases_settlement_rate] %>%</small>
          </div>
          <div class="partner-progress-bar mt-1">
            <div class="partner-progress-fill bg-info" id="kpi_purch_settle_bar" style="width: <%= [kpis[:purchases_settlement_rate], 100].min %>%;"></div>
          </div>
        </div>
        <div class="bento-substats-row mt-auto">
          <div class="substat-item">
            <span class="substat-label">Settled</span>
            <span class="substat-value text-info tabular-nums" id="kpi_paid_purch_exp">
              <%= number_to_currency(kpis[:paid_purchases_expense], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Payables</span>
            <span class="substat-value text-danger tabular-nums" id="kpi_purch_payables">
              <%= number_to_currency(kpis[:total_payables], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Avg / Bill</span>
            <span class="substat-value text-main tabular-nums" id="kpi_avg_purch_val">
              <%= number_to_currency(kpis[:avg_purchase_bill_value], unit: currency_symbol) %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Net Operating Profit & Margin -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Net Operating Profit</span>
          <span class="bento-chip <%= kpis[:profit_margin] >= 0 ? 'bento-chip-paid' : 'bento-chip-rejected' %> fs-10" id="kpi_profit_margin_tag">
            <%= kpis[:profit_margin] %>% Margin
          </span>
        </div>
        <div class="mb-2.5">
          <div class="bento-value bento-financial-value tabular-nums text-truncate <%= kpis[:net_operating_income] >= 0 ? 'text-success' : 'text-danger' %>" id="kpi_net_income_val">
            <%= number_to_currency(kpis[:net_operating_income], unit: currency_symbol) %>
          </div>
          <div class="d-flex align-items-center justify-content-between mt-1.5">
            <small class="text-muted fs-9">Period Cash Realized</small>
            <small class="fw-semibold <%= kpis[:net_cash_flow] >= 0 ? 'text-success' : 'text-danger' %> fs-9 tabular-nums" id="kpi_net_cash_flow">
              <%= number_to_currency(kpis[:net_cash_flow], unit: currency_symbol) %>
            </small>
          </div>
          <div class="partner-progress-bar mt-1">
            <div class="partner-progress-fill <%= kpis[:profit_margin] >= 0 ? 'bg-success' : 'bg-danger' %>" id="kpi_profit_margin_bar" style="width: <%= [[kpis[:profit_margin].abs, 0].max, 100].min %>%;"></div>
          </div>
        </div>
        <div class="bento-substats-row mt-auto">
          <div class="substat-item">
            <span class="substat-label">Net Flow</span>
            <span class="substat-value <%= kpis[:net_cash_flow] >= 0 ? 'text-success' : 'text-danger' %> tabular-nums" id="kpi_net_cash_flow_sub">
              <%= number_to_currency(kpis[:net_cash_flow], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Working Cap</span>
            <span class="substat-value text-main tabular-nums" id="kpi_working_capital">
              <%= number_to_currency(kpis[:net_working_capital], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Growth</span>
            <span class="substat-value <%= kpis[:net_income_growth] >= 0 ? 'text-success' : 'text-danger' %> tabular-nums" id="kpi_net_growth">
              <%= kpis[:net_income_growth] >= 0 ? "+#{kpis[:net_income_growth]}%" : "#{kpis[:net_income_growth]}%" %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Subscriptions & Recurring Revenue (MRR/ARR) -->
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Recurring Revenue (MRR)</span>
          <span class="bento-chip bento-chip-sent fs-10" id="kpi_arr_tag">
            ARR <%= number_to_currency(kpis[:total_arr], unit: currency_symbol) %>
          </span>
        </div>
        <div class="mb-2.5">
          <div class="bento-value bento-financial-value tabular-nums text-truncate" id="kpi_mrr_val">
            <%= number_to_currency(kpis[:total_mrr], unit: currency_symbol) %><span class="fs-9 text-muted fw-normal ms-1">/mo</span>
          </div>
          <div class="d-flex align-items-center justify-content-between mt-1.5">
            <small class="text-muted fs-9">Active Recurring Contracts</small>
            <small class="fw-semibold text-main fs-9 tabular-nums" id="kpi_active_subs_count"><%= kpis[:active_subscriptions_count] %> active</small>
          </div>
          <div class="partner-progress-bar mt-1">
            <div class="partner-progress-fill" style="background-color: #6366f1; width: <%= kpis[:active_subscriptions_count] > 0 ? 100 : 0 %>%;"></div>
          </div>
        </div>
        <div class="bento-substats-row mt-auto">
          <div class="substat-item">
            <span class="substat-label">ARPU (Avg)</span>
            <span class="substat-value text-main tabular-nums" id="kpi_arpu_val">
              <%= number_to_currency(kpis[:avg_mrr_per_subscription], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Tax Base</span>
            <span class="substat-value text-muted tabular-nums" id="kpi_tax_sales_val">
              <%= number_to_currency(kpis[:total_tax_sales], unit: currency_symbol) %>
            </span>
          </div>
          <div class="substat-item">
            <span class="substat-label">Credit Notes</span>
            <span class="substat-value text-muted tabular-nums" id="kpi_credit_notes_total">
              <%= number_to_currency(kpis[:credit_notes_total], unit: currency_symbol) %>
            </span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Secondary Modular Operational Ribbon (6-Tile Modular Record Counts: 2-Col on Phones, 3-Col on Tablets, 6-Col on Desktop) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5" id="kpi_cards_ribbon">
    
    <!-- Tile 1: Sales Invoices -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Sales Invoices</span>
          <span class="bento-chip bento-chip-paid fs-10" id="kpi_paid_sales_chip">
            <%= kpis[:paid_sales_count] %> Paid
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_sales_count_val">
            <%= kpis[:total_sales_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1" id="kpi_pending_sales"><%= kpis[:pending_sales_count] %> pending</small>
          <%= link_to "View", invoices_path(tab: "sales-invoices"), class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

    <!-- Tile 2: Purchase Bills -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Purchase Bills</span>
          <span class="bento-chip bento-chip-approved fs-10" id="kpi_paid_purchases_chip">
            <%= kpis[:paid_purchases_count] %> Paid
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_purchases_count_val">
            <%= kpis[:total_purchases_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1" id="kpi_unsettled_purchases"><%= [kpis[:total_purchases_count] - kpis[:paid_purchases_count], 0].max %> unsettled</small>
          <%= link_to "View", invoices_path(tab: "purchase-invoices"), class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

    <!-- Tile 3: Tax Submissions -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Tax 2307</span>
          <span class="bento-chip <%= kpis[:tax_pending_count] > 0 ? 'bento-chip-pending' : 'bento-chip-processed' %> fs-10" id="kpi_tax_chip">
            <%= kpis[:tax_pending_count] > 0 ? "#{kpis[:tax_pending_count]} P" : 'Clean' %>
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_tax_count_val">
            <%= kpis[:tax_total_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1" id="kpi_tax_processed_sub"><%= kpis[:tax_processed_count] %> proc (<%= kpis[:tax_compliance_rate] %>%)</small>
          <%= link_to "Taxes", tax_submissions_home_path, class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

    <!-- Tile 4: Credit Notes & Adjustments -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Credit Notes</span>
          <span class="bento-chip bento-chip-draft fs-10" id="kpi_credit_notes_chip">
            <%= kpis[:credit_notes_count] %> Notes
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_credit_notes_count_val">
            <%= kpis[:credit_notes_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1" id="kpi_credit_notes_sub"><%= number_to_currency(kpis[:credit_notes_total], unit: currency_symbol) %> adj</small>
          <%= link_to "Invoices", invoices_path, class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

    <!-- Tile 5: Business Locations -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Locations</span>
          <span class="bento-chip bento-chip-draft fs-10">
            Branches
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_locations_count_val">
            <%= kpis[:locations_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1">Branch sites</small>
          <%= link_to "View", locations_path, class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

    <!-- Tile 6: Network Partners -->
    <div class="col-6 col-md-4 col-xl-4 col-xxl-2">
      <div class="bento-card">
        <div class="bento-card-header">
          <span class="bento-card-title">Network</span>
          <span class="bento-chip bento-chip-approved fs-10">
            Connected
          </span>
        </div>
        <div class="mb-1.5">
          <div class="bento-value tabular-nums text-truncate" id="kpi_networks_count_val">
            <%= kpis[:networks_count] %>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between pt-1 mt-auto">
          <small class="text-muted fs-9 text-truncate me-1">Partners</small>
          <%= link_to "Network", networks_path, class: "text-decoration-none fs-9 text-primary fw-medium flex-shrink-0" %>
        </div>
      </div>
    </div>

  </div>

  <!-- Central Bento Analytics Section (8-Col Chart + 4-Col Side Stack) -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5">
    
    <!-- Bento Chart (8-Col) -->
    <div class="col-12 col-xl-8">
      <div class="bento-card position-relative">
        <div class="dashboard-loading-overlay" id="trend_chart_loader">
          <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>

        <div class="bento-card-header flex-wrap">
          <div>
            <h6 class="fw-bold text-main mb-0 fs-7">Financial Trajectory</h6>
            <small class="text-muted fs-8" id="trend_chart_subtitle"><%= @dashboard_data[:range_label] %></small>
          </div>
          <div class="dashboard-filter-scroll-wrapper">
            <div class="dashboard-filter-btn-group" role="group" id="trend_series_toggle">
              <button type="button" class="btn active" data-series="all">Combined</button>
              <button type="button" class="btn" data-series="revenue">Sales</button>
              <button type="button" class="btn" data-series="expenses">Purchases</button>
              <button type="button" class="btn" data-series="net">Net Flow</button>
            </div>
          </div>
        </div>

        <div class="chart-container-wrapper">
          <canvas id="performanceTrendChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Bento Settlements & Operational Health Stack (4-Col) -->
    <div class="col-12 col-xl-4">
      <div class="bento-card">
        <div class="bento-card-header">
          <div>
            <h6 class="fw-bold text-main mb-0 fs-7">Settlements & Status</h6>
            <small class="text-muted fs-8">Invoice status distribution</small>
          </div>
          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-2 px-2 py-0.5 fs-9" type="button" id="statusChartTypeDropdown" data-bs-toggle="dropdown">
              <span id="status_chart_view_label">Sales Invoices</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-1 rounded-3 fs-8">
              <li><a class="dropdown-item status-chart-type-item rounded-2 active" href="#" data-type="sales">Sales Invoices</a></li>
              <li><a class="dropdown-item status-chart-type-item rounded-2" href="#" data-type="purchases">Purchase Bills</a></li>
            </ul>
          </div>
        </div>

        <div class="chart-container-wrapper chart-container-donut d-flex align-items-center justify-content-center">
          <canvas id="statusDonutChart"></canvas>
        </div>

        <!-- Quick Efficiency Metrics Meter -->
        <div class="pt-2 mt-2">
          <div class="row g-2 text-center">
            <div class="col-4">
              <span class="text-muted fs-10 d-block">Collection</span>
              <span class="fw-bold text-success fs-8 tabular-nums" id="health_collection_rate"><%= kpis[:sales_collection_rate] %>%</span>
            </div>
            <div class="col-4">
              <span class="text-muted fs-10 d-block">Settlement</span>
              <span class="fw-bold text-info fs-8 tabular-nums" id="health_settlement_rate"><%= kpis[:purchases_settlement_rate] %>%</span>
            </div>
            <div class="col-4">
              <span class="text-muted fs-10 d-block">Compliance</span>
              <span class="fw-bold text-primary fs-8 tabular-nums" id="health_tax_rate"><%= kpis[:tax_compliance_rate] %>%</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Lower Bento Section: Partners & Tax Compliance Grid -->
  <div class="row g-3 g-md-3.5 mb-3 mb-md-3.5">
    
    <!-- Top Partners Bento (Col-6) -->
    <div class="col-12 col-lg-6">
      <div class="bento-card">
        <div class="bento-card-header">
          <h6 class="fw-bold text-main mb-0 fs-7">Top Counterparties</h6>
          <div class="dashboard-filter-btn-group" role="group" id="partner_ranking_toggle">
            <button type="button" class="btn active" data-partner-type="customers">Customers</button>
            <button type="button" class="btn" data-partner-type="vendors">Vendors</button>
          </div>
        </div>

        <div class="partner-rankings-container py-0.5" id="partner_rankings_list">
          <% if @dashboard_data[:charts][:top_customers].any? %>
            <% @dashboard_data[:charts][:top_customers].each_with_index do |partner, idx| %>
              <div class="partner-rank-item">
                <div class="d-flex align-items-center justify-content-between mb-0.5">
                  <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 me-2">
                    <span class="text-muted fs-9 fw-semibold tabular-nums flex-shrink-0" style="width: 14px;">
                      <%= idx + 1 %>
                    </span>
                    <span class="fw-medium text-main fs-8 partner-name-truncate"><%= partner[:name] %></span>
                  </div>
                  <div class="text-end flex-shrink-0">
                    <span class="fw-semibold text-main fs-8 tabular-nums"><%= number_to_currency(partner[:amount], unit: currency_symbol) %></span>
                    <small class="text-muted ms-1 fs-9">(<%= partner[:percentage] %>%)</small>
                  </div>
                </div>
                <div class="partner-progress-bar">
                  <div class="partner-progress-fill" style="width: <%= partner[:percentage] %>%;"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-3 text-muted">
              <small class="fs-8">No partner transaction volume recorded for this period.</small>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Tax Form 2307 Compliance Health (Col-6) -->
    <div class="col-12 col-lg-6">
      <div class="bento-card">
        <div class="bento-card-header">
          <div>
            <div class="d-flex align-items-center gap-2 mb-0.5">
              <h6 class="fw-bold text-main mb-0 fs-7">Tax Form 2307 Compliance</h6>
              <span class="bento-chip <%= kpis[:tax_pending_count] > 0 ? 'bento-chip-pending' : 'bento-chip-paid' %> fs-10" id="tax_status_chip">
                <i class="fa-solid <%= kpis[:tax_pending_count] > 0 ? 'fa-triangle-exclamation' : 'fa-check' %> fs-11"></i>
                <%= kpis[:tax_pending_count] > 0 ? "#{kpis[:tax_pending_count]} Pending" : "100% Compliant" %>
              </span>
            </div>
            <small class="text-muted fs-8">BIR certificate verification & processing health</small>
          </div>
          <%= link_to tax_submissions_home_path, class: "btn btn-sm btn-outline-secondary rounded-2 px-2.5 py-0.5 fs-9 fw-medium d-inline-flex align-items-center gap-1.5" do %>
            Taxes Hub <i class="fa-solid fa-chevron-right fs-11"></i>
          <% end %>
        </div>

        <div class="row align-items-center g-3 my-auto py-1">
          <!-- Donut Ring with Centered Compliance Rate -->
          <div class="col-12 col-sm-5">
            <div class="tax-donut-wrapper">
              <div class="chart-container-wrapper chart-container-tax-donut">
                <canvas id="taxComplianceChart"></canvas>
              </div>
              <div class="tax-donut-center">
                <div class="tax-donut-pct tabular-nums" id="tax_donut_score"><%= kpis[:tax_compliance_rate] %>%</div>
                <div class="tax-donut-sub" id="tax_donut_sub_label">Score</div>
              </div>
            </div>
          </div>

          <!-- Minimalist Status Metric Rows -->
          <div class="col-12 col-sm-7">
            <div class="d-flex flex-column gap-2">
              
              <!-- 1. Processed -->
              <div class="tax-status-item">
                <div class="tax-status-header">
                  <div class="tax-status-label-group">
                    <span class="status-indicator-dot bg-success"></span>
                    <span class="fw-medium text-main fs-8">Processed & Filed</span>
                  </div>
                  <div class="text-end">
                    <span class="fw-bold text-main fs-8 tabular-nums" id="tax_badge_processed"><%= kpis[:tax_processed_count] %></span>
                    <small class="text-muted ms-1 fs-9 tabular-nums" id="tax_badge_processed_pct">(<%= kpis[:tax_total_count].positive? ? ((kpis[:tax_processed_count].to_f / kpis[:tax_total_count]) * 100).round : 100 %>%)</small>
                  </div>
                </div>
                <div class="partner-progress-bar">
                  <div class="partner-progress-fill bg-success" id="tax_bar_processed" style="width: <%= kpis[:tax_total_count].positive? ? ((kpis[:tax_processed_count].to_f / kpis[:tax_total_count]) * 100).round : 100 %>%;"></div>
                </div>
              </div>

              <!-- 2. Reviewed -->
              <div class="tax-status-item">
                <div class="tax-status-header">
                  <div class="tax-status-label-group">
                    <span class="status-indicator-dot bg-info"></span>
                    <span class="fw-medium text-main fs-8">Reviewed</span>
                  </div>
                  <div class="text-end">
                    <span class="fw-bold text-main fs-8 tabular-nums" id="tax_badge_reviewed"><%= [kpis[:tax_reviewed_count] - kpis[:tax_processed_count], 0].max %></span>
                    <small class="text-muted ms-1 fs-9 tabular-nums" id="tax_badge_reviewed_pct">(<%= kpis[:tax_total_count].positive? ? (([kpis[:tax_reviewed_count] - kpis[:tax_processed_count], 0].max.to_f / kpis[:tax_total_count]) * 100).round : 0 %>%)</small>
                  </div>
                </div>
                <div class="partner-progress-bar">
                  <div class="partner-progress-fill bg-info" id="tax_bar_reviewed" style="width: <%= kpis[:tax_total_count].positive? ? (([kpis[:tax_reviewed_count] - kpis[:tax_processed_count], 0].max.to_f / kpis[:tax_total_count]) * 100).round : 0 %>%;"></div>
                </div>
              </div>

              <!-- 3. Pending -->
              <div class="tax-status-item">
                <div class="tax-status-header">
                  <div class="tax-status-label-group">
                    <span class="status-indicator-dot bg-warning"></span>
                    <span class="fw-medium text-main fs-8">Pending Review</span>
                  </div>
                  <div class="text-end">
                    <span class="fw-bold text-main fs-8 tabular-nums <%= 'text-danger' if kpis[:tax_pending_count] > 0 %>" id="tax_badge_pending"><%= kpis[:tax_pending_count] %></span>
                    <small class="text-muted ms-1 fs-9 tabular-nums" id="tax_badge_pending_pct">(<%= kpis[:tax_total_count].positive? ? ((kpis[:tax_pending_count].to_f / kpis[:tax_total_count]) * 100).round : 0 %>%)</small>
                  </div>
                </div>
                <div class="partner-progress-bar">
                  <div class="partner-progress-fill <%= kpis[:tax_pending_count] > 0 ? 'bg-warning' : 'bg-secondary' %>" id="tax_bar_pending" style="width: <%= kpis[:tax_total_count].positive? ? ((kpis[:tax_pending_count].to_f / kpis[:tax_total_count]) * 100).round : 0 %>%;"></div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Footer Metric Strip -->
        <div class="tax-footer-strip mt-auto pt-2">
          <div class="d-flex align-items-center justify-content-between text-muted fs-9 px-1">
            <span>Total Submissions: <strong class="text-main tabular-nums" id="tax_total_footer_val"><%= kpis[:tax_total_count] %></strong></span>
            <span>Tax Withheld: <strong class="text-main tabular-nums" id="tax_withheld_footer_val"><%= number_to_currency(kpis[:total_tax_sales], unit: currency_symbol) %></strong></span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Bento: Recent Transactions & Tasks -->
  <div class="row g-3 g-md-3.5">
    
    <!-- Recent Transactions Table & Mobile Stream (Col-8) -->
    <div class="col-12 col-xl-8">
      <div class="bento-card">
        <div class="bento-card-header">
          <div>
            <h6 class="fw-bold text-main mb-0 fs-7">Recent Transactions</h6>
            <small class="text-muted fs-8">Latest billing and payment activities</small>
          </div>
          <%= link_to invoices_path, class: "btn btn-sm btn-outline-secondary rounded-2 px-2.5 py-0.5 fs-9 fw-medium" do %>
            View All <i class="fa-solid fa-arrow-right ms-1 fs-10"></i>
          <% end %>
        </div>

        <!-- Desktop & Tablet Data Table (>= 768px) -->
        <div class="table-responsive d-none d-md-block mt-1">
          <table class="table dashboard-activity-table align-middle mb-0">
            <thead>
              <tr>
                <th>Invoice</th>
                <th>Type</th>
                <th>Party</th>
                <th>Date</th>
                <th class="text-end">Amount</th>
                <th class="text-center">Status</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody id="recent_transactions_table_body">
              <% if @dashboard_data[:recent_invoices].any? %>
                <% @dashboard_data[:recent_invoices].each do |inv| %>
                  <% 
                    partner_name = if inv["invoice_type"] == "sale"
                                     inv.dig("recipient_company", "name") || "Direct Customer"
                                   else
                                     inv.dig("sale_from", "name") || "Direct Vendor"
                                   end
                    chip_class = case inv["status"]
                                 when "paid" then "bento-chip-paid"
                                 when "approved" then "bento-chip-approved"
                                 when "sent" then "bento-chip-sent"
                                 when "pending" then "bento-chip-pending"
                                 when "rejected" then "bento-chip-rejected"
                                 else "bento-chip-draft"
                                 end
                  %>
                  <tr>
                    <td>
                      <%= link_to invoice_path(inv["id"]), class: "fw-semibold text-main text-decoration-none hover-primary" do %>
                        <%= inv["invoice_number"] %>
                      <% end %>
                    </td>
                    <td>
                      <span class="text-muted text-uppercase fs-9 fw-medium">
                        <%= inv["invoice_type"] %>
                      </span>
                    </td>
                    <td class="fw-medium text-main text-truncate" style="max-width: 170px;">
                      <%= partner_name %>
                    </td>
                    <td class="text-muted fs-8 tabular-nums">
                      <%= Date.parse(inv["issue_date"]).strftime("%b %d, %Y") rescue (Date.parse(inv["created_at"]).strftime("%b %d, %Y") rescue "—") %>
                    </td>
                    <td class="text-end fw-semibold text-main tabular-nums">
                      <%= number_to_currency(inv["grand_total"], unit: inv["currency"] || currency_symbol) %>
                    </td>
                    <td class="text-center">
                      <span class="bento-chip <%= chip_class %> text-capitalize fs-9">
                        <%= inv["status"] %>
                      </span>
                    </td>
                    <td class="text-end">
                      <%= link_to invoice_path(inv["id"]), class: "btn btn-sm btn-link text-muted p-0 text-decoration-none", title: "View" do %>
                        <i class="fa-solid fa-chevron-right fs-9"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="7" class="text-center py-3 text-muted fs-8">
                    No recent invoices recorded yet.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Mobile-Native Transaction Cards (< 768px) -->
        <div class="dashboard-mobile-tx-list d-md-none mt-2" id="recent_transactions_mobile_list">
          <% if @dashboard_data[:recent_invoices].any? %>
            <% @dashboard_data[:recent_invoices].each do |inv| %>
              <% 
                partner_name = if inv["invoice_type"] == "sale"
                                 inv.dig("recipient_company", "name") || "Direct Customer"
                               else
                                 inv.dig("sale_from", "name") || "Direct Vendor"
                               end
                chip_class = case inv["status"]
                             when "paid" then "bento-chip-paid"
                             when "approved" then "bento-chip-approved"
                             when "sent" then "bento-chip-sent"
                             when "pending" then "bento-chip-pending"
                             when "rejected" then "bento-chip-rejected"
                             else "bento-chip-draft"
                             end
                formatted_date = Date.parse(inv["issue_date"]).strftime("%b %d, %Y") rescue (Date.parse(inv["created_at"]).strftime("%b %d, %Y") rescue "—")
              %>
              <%= link_to invoice_path(inv["id"]), class: "mobile-tx-item" do %>
                <div class="mobile-tx-header">
                  <div class="d-flex align-items-center gap-1.5 min-w-0">
                    <span class="fw-semibold text-main fs-8 text-truncate"><%= inv["invoice_number"] %></span>
                    <span class="text-muted text-uppercase fs-10 fw-medium">(<%= inv["invoice_type"] %>)</span>
                  </div>
                  <span class="bento-chip <%= chip_class %> text-capitalize fs-10">
                    <%= inv["status"] %>
                  </span>
                </div>
                <div class="mobile-tx-meta">
                  <span class="partner-name-truncate me-2"><%= partner_name %></span>
                  <span class="tabular-nums"><%= formatted_date %></span>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-1 pt-1 border-top border-opacity-10">
                  <span class="text-muted fs-10">Total Amount</span>
                  <span class="mobile-tx-amount tabular-nums"><%= number_to_currency(inv["grand_total"], unit: inv["currency"] || currency_symbol) %></span>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="text-center py-3 text-muted fs-8">
              No recent invoices recorded yet.
            </div>
          <% end %>
        </div>

      </div>
    </div>

    <!-- Action Items & Launcher Bento (Col-4) -->
    <div class="col-12 col-xl-4">
      <div class="bento-card">
        <div class="bento-card-header">
          <div>
            <h6 class="fw-bold text-main mb-0 fs-7">Action Items</h6>
            <small class="text-muted fs-8">Pending tasks</small>
          </div>
          <span class="bento-chip bento-chip-rejected fs-10" id="urgent_actions_count">
            <%= @dashboard_data[:urgent_actions].size %>
          </span>
        </div>

        <div class="d-flex flex-column gap-1.5 mt-1" id="urgent_actions_list">
          <% if @dashboard_data[:urgent_actions].any? %>
            <% @dashboard_data[:urgent_actions].each do |action| %>
              <div class="bento-action-item d-flex align-items-center justify-content-between gap-2">
                <div>
                  <h6 class="fw-semibold text-main mb-0 fs-8"><%= action[:title] %></h6>
                  <small class="text-muted fs-9 d-block"><%= action[:description] %></small>
                </div>
                <%= link_to action[:link_url], class: "btn btn-sm btn-outline-secondary rounded-2 px-2.5 py-0.5 fs-9 text-nowrap fw-medium flex-shrink-0" do %>
                  <%= action[:link_text] %>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-2.5 text-muted">
              <i class="fa-solid fa-check fs-4 text-muted mb-0.5 d-block opacity-50"></i>
              <small class="fs-8">All tasks and reviews are complete.</small>
            </div>
          <% end %>
        </div>

        <!-- Shortcuts -->
        <hr class="dashboard-shortcuts-divider my-3 opacity-25">
        <div class="dashboard-shortcuts-wrapper">
          <span class="fs-9 fw-semibold text-muted text-uppercase tracking-wider d-block mb-2">Shortcuts</span>
          <div class="dashboard-shortcuts-container d-flex flex-wrap gap-2">
            <%= link_to tax_submissions_home_path, class: "quick-action-pill" do %>
              <i class="fa-solid fa-file-invoice-dollar fs-9 text-muted"></i> Tax 2307
            <% end %>
            <%= link_to new_invoice_path, class: "quick-action-pill" do %>
              <i class="fa-solid fa-plus fs-9 text-muted"></i> New Sale
            <% end %>
            <%= link_to subscriptions_path, class: "quick-action-pill" do %>
              <i class="fa-solid fa-repeat fs-9 text-muted"></i> MRR
            <% end %>
            <%= link_to networks_path, class: "quick-action-pill" do %>
              <i class="fa-solid fa-network-wired fs-9 text-muted"></i> Network
            <% end %>
          </div>
        </div>

      </div>
    </div>

  </div>

</div>
