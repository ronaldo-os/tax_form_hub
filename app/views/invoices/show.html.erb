<% content_for :page_title, show_invoice_page_title(@invoice) %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "invoices", media: "all" %>
<% end %>

<%= hidden_field_tag :payment_terms, @invoice.payment_terms.to_json.html_safe, id: 'view_invoicepayment_terms_json' %>
<%= hidden_field_tag 'invoice[invoice_category]', @invoice.invoice_category %>
<div class="container mt-4 mt-md-5">
  <div class="invoice-view-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <%= link_to session[:invoices_back_url] || invoices_path(tab: params[:tab]), class: "btn btn-back rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center", data: { behavior: "back-button" } do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back</span>
      <% end %>
    </div>

    <div class="d-flex gap-2">
      <button id="download_button" class="btn btn-outline-primary btn-md d-inline-flex align-items-center justify-content-center">
        <i class="fas fa-download"></i>
        <span>PDF</span>
      </button>
      <button type="button" 
              class="btn btn-outline-secondary btn-md d-inline-flex align-items-center gap-1.5 open-activity-timeline-btn"
              data-trackable-type="Invoice"
              data-trackable-id="<%= @invoice.id %>"
              data-resource-title="Invoice #<%= @invoice.invoice_number %>"
              title="View History Timeline">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>History</span>
      </button>
    <% if @invoice.subscription_contract? %>
      <%= link_to subscription_path(@invoice), class: "btn btn-outline-primary btn-md d-inline-flex align-items-center gap-1.5" do %>
        <i class="fa-solid fa-arrows-rotate"></i>
        <span>Subscription</span>
      <% end %>
    <% end %>
    <% if @invoice.invoice_type == "sale" && !["sent", "approved", "rejected", "partially_paid", "paid"].include?(@invoice.status) %>
        <%= link_to "Modify", edit_invoice_path(@invoice, tab: params[:tab]), class: "btn btn-secondary btn-md" %>

        <%= button_to "Send",
            duplicate_as_purchase_invoice_path(@invoice),
            method: :post,
            params: { invoice: { id: @invoice.id } },
            class: "btn btn-primary btn-md d-inline",
            id: "view_invoice_send_btn",
            name: "commit_action",
            value: "send" %>

    <% elsif @invoice.standard? && @invoice.invoice_type == "sale" && ["sent", "approved", "partially_paid", "paid"].include?(@invoice.status) %>
        <% if %w[sent approved partially_paid].include?(@invoice.status) && !@invoice.has_associated_credit_note? %>
          <button type="button" 
                  class="btn btn-primary btn-md d-inline-flex align-items-center gap-1.5"
                  data-bs-toggle="modal" 
                  data-bs-target="#recordPaymentModal-<%= @invoice.id %>">
            <i class="fa-solid fa-file-invoice-dollar"></i>
            <span><%= @invoice.payments.any? ? "Add Payment" : "Mark as Partially Paid" %></span>
          </button>
        <% end %>

        <%= link_to "Create Credit Note", 
            new_invoice_path(original_invoice_id: @invoice.id, category: "credit_note", tab: params[:tab]), 
            class: "btn btn-outline-primary btn-md" %>
    <% end %>
    </div>

  </div>

  <% if @invoice.invoice_info.is_a?(Hash) && (recurring_err = @invoice.invoice_info['recurring_generation_error']) %>
    <div class="alert alert-danger border-0 shadow-sm rounded-4 p-3.5 mb-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
      <div class="d-flex align-items-start gap-3">
        <i class="fa-solid fa-triangle-exclamation text-danger fs-4 mt-1"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-1 text-danger">Recurring Invoice Generation Failed</h6>
          <p class="mb-0 text-danger-emphasis small"><%= recurring_err['message'] %></p>
        </div>
      </div>
      <div>
        <%= button_to retry_invoicing_subscription_path(@invoice), method: :post, class: "btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-2" do %>
          <i class="fa-solid fa-rotate-right"></i>
          <span>Retry Generation</span>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "invoices/partials/invoice_card", invoice: @invoice %>

  <%= render "invoices/partials/record_payment_modal", invoice: @invoice if @invoice.invoice_type == "sale" && %w[sent approved partially_paid].include?(@invoice.status) && !@invoice.has_associated_credit_note? %>

</div>
