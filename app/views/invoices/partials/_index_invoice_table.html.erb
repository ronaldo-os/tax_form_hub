<% cache [table_id, invoices.map(&:id), invoices.map(&:updated_at).max, current_user.id] do %>
  <% 
    is_purchase = table_id.to_s.include?('purchase') || table_id.to_s.include?('received')
    counterparty_label = is_purchase ? 'Supplier Name' : 'Customer Name'
  %>
  <table class="table table-hover" id="<%= table_id %>">
    <thead class="table-light">
      <tr>
        <th><%= local_assigns[:title] || 'Invoice' %> #</th>
        <th><%= counterparty_label %></th>
        <th>Total</th>
        <th>Issue Date</th>
        <th>Attachment</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.each do |invoice| %>
        <tr>
        <td>
          <%= link_to invoice.invoice_number, invoice_path(invoice, tab: local_assigns[:active_tab]), class: 'preview-invoice preview-invoice-mobile', data: { id: invoice.id } %>
          <% if invoice.credit_note? %>
            <span class="badge badge_cn ms-1">CN</span>
          <% elsif invoice.has_associated_credit_note? %>
            <span class="badge badge_has_cn ms-1">Has CN</span>
          <% end %>
        </td>
        <td style="max-width: 200px;">
          <% name = is_purchase ? (invoice.sale_from&.name || "—") : (invoice.recipient_company&.name || "—") %>
          <div class="text-truncate" title="<%= name %>">
            <%= name %>
          </div>
        </td>
        <td>
          <%= currency_symbol(invoice) + ' ' + number_with_precision(invoice.total["grand_total"].to_f, precision: 2, delimiter: ",") %>
        </td>
        <td><%= invoice.issue_date&.strftime('%b %d, %Y') || '—' %></td>
        <td>
        <% if !invoice.recurring_sub_invoice? && invoice.attachments.attached? %>
        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#attachmentModal-<%= invoice.id %>">View Files</button>
        <% else %>
        <span class="text-muted">No File</span>
        <% end %>
        <% if !invoice.recurring_sub_invoice? && invoice.attachments.attached? %>
            <div class="modal fade attachment-modal" id="attachmentModal-<%= invoice.id %>" tabindex="-1" aria-labelledby="attachmentModalLabel-<%= invoice.id %>" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-md">
                    <div class="modal-content shadow-sm border-0 rounded-4">
                    <div class="modal-header border-0 pb-2 pt-4 px-4 d-flex align-items-center justify-content-between">
                        <h5 class="modal-title fw-semibold text-main fs-5 mb-0" id="attachmentModalLabel-<%= invoice.id %>">Attachments</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 pt-2">
                        <div class="attachment-list d-flex flex-column gap-2.5" style="max-height: 65vh; overflow-y: auto;">
                        <% invoice.attachments.each do |file| %>
                            <% 
                              filename = file.filename.to_s
                              content_type = file.content_type.to_s
                              bytes = file.blob&.byte_size || (file.byte_size rescue nil)
                              formatted_size = (bytes && bytes > 0) ? number_to_human_size(bytes) : nil
                              uploaded_date = (file.created_at || file.blob&.created_at)&.strftime('%b %d, %Y')
                              view_url = rails_blob_path(file, disposition: "inline")
                              download_url = rails_blob_path(file, disposition: "attachment")
                            %>
                            <% if content_type.start_with?("image/") %>
                                <div class="col-12 mb-3">
                                  <div class="d-flex flex-column align-items-center justify-content-center bg-light border rounded p-2" style="min-height: 200px;">
                                    <%= link_to url_for(file), target: "_blank", class: "d-block text-center w-100 mb-2" do %>
                                      <img src="<%= url_for(file) %>" class="img-fluid rounded shadow-sm" style="max-height: 70vh; object-fit: contain;" alt="Attachment" loading="lazy">
                                    <% end %>
                                    <div class="w-100 d-flex align-items-center justify-content-between pt-2 border-top gap-2" style="min-width: 0;">
                                      <div class="min-w-0 flex-grow-1 text-start me-2" style="min-width: 0;">
                                        <div class="text-truncate small text-muted text-start flex-grow-1 me-2" style="min-width: 0;" title="<%= filename %>">
                                          <%= filename %>
                                        </div>
                                        <div class="extra-small text-muted mt-0.5">
                                          <%= [(content_type.split('/').last.upcase.presence || 'IMAGE'), formatted_size, uploaded_date].reject(&:blank?).join(' • ') %>
                                        </div>
                                      </div>
                                      <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <%= link_to url_for(file), target: "_blank", class: "btn btn-sm btn-primary rounded-pill px-2.5 py-1 extra-small fw-medium text-nowrap", title: "View #{filename}" do %>
                                          <i class="fa-solid fa-eye me-1"></i><span>View</span>
                                        <% end %>
                                        <%= link_to download_url, target: "_blank", download: filename, class: "btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 extra-small fw-medium text-nowrap", title: "Download #{filename}" do %>
                                          <i class="fa-solid fa-download me-1"></i><span>Download</span>
                                        <% end %>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                            <% else %>
                                <% 
                                  is_pdf = content_type == 'application/pdf' || filename.downcase.end_with?('.pdf')
                                  file_type = is_pdf ? 'PDF' : (filename.split('.').last.upcase.presence || 'FILE')
                                  icon_class = is_pdf ? 'fa-file-pdf' : 'fa-file-lines'
                                  icon_bg_class = is_pdf ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary'
                                  meta_text = [file_type, formatted_size, uploaded_date].reject(&:blank?).join(' • ')
                                %>
                                <div class="attachment-card p-3 rounded-3 border d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                  <div class="d-flex align-items-center gap-3 min-w-0 flex-grow-1" style="min-width: 0;">
                                    <div class="attachment-icon-box <%= icon_bg_class %> rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
                                      <i class="fa-solid <%= icon_class %> fs-4"></i>
                                    </div>
                                    <div class="min-w-0 flex-grow-1 text-start" style="min-width: 0;">
                                      <div class="attachment-filename fw-semibold text-truncate text-main" title="<%= filename %>">
                                        <%= filename %>
                                      </div>
                                      <div class="attachment-meta small text-muted mt-0.5">
                                        <%= meta_text %>
                                      </div>
                                    </div>
                                  </div>
                                  <div class="attachment-actions d-flex align-items-center gap-2 flex-shrink-0 ms-auto ms-sm-0">
                                    <%= link_to view_url, target: "_blank", class: "btn btn-sm btn-primary d-inline-flex align-items-center px-3 py-1.5 rounded-pill fw-medium text-nowrap", title: "View #{filename}" do %>
                                      <i class="fa-solid fa-eye me-1.5"></i><span>View</span>
                                    <% end %>
                                    <%= link_to download_url, target: "_blank", download: filename, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center px-3 py-1.5 rounded-pill fw-medium text-nowrap", title: "Download #{filename}" do %>
                                      <i class="fa-solid fa-download me-1.5"></i><span>Download</span>
                                    <% end %>
                                  </div>
                                </div>
                            <% end %>
                        <% end %>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        <% end %>
        <td>
          <% if invoice.quote? && invoice.invoice_type == "purchase" && invoice.status == "sent" %>
            Received
          <% else %>
            <%= invoice.status.to_s.capitalize %>
          <% end %>
        </td>
        <td>
          <div class="dropdown text-center">
            <button class="btn btn-link text-muted p-0 text-decoration-none fs-3" type="button" id="actionsDropdown_<%= invoice.id %>" data-bs-toggle="dropdown" aria-expanded="false">
              &#8942;
            </button>
            <ul class="dropdown-menu" aria-labelledby="actionsDropdown_<%= invoice.id %>">
              <li>
                <a href="#" class="dropdown-item preview-invoice" data-id="<%= invoice.id %>">
                  Preview
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>

              <li>
                <a href="#" class="dropdown-item download-pdf" data-id="<%= invoice.id %>">
                  Download PDF
                </a>
              </li>

              <% if invoice.status == "draft" %>
                <li>
                  <%= link_to "Edit", edit_invoice_path(invoice, tab: local_assigns[:active_tab]), class: "dropdown-item" %>
                </li>
                <li><hr class="dropdown-divider"></li>
              <% end %>

              <% if invoice.status != "draft" && !["purchases-table", "purchases-archived-table", "received-quotes-table", "received-quotes-archived-table"].include?(table_id) %>
                <li>
                  <%= link_to "Use as Draft",
                      new_invoice_path(template_id: invoice.id, tab: local_assigns[:active_tab]),
                      class: "dropdown-item" %>
                </li>
              <% end %>

              <% if invoice.invoice_type == "sale" && (invoice.status == "approved" || invoice.status == "sent" || invoice.status == "partially_paid") && !["purchases-table", "purchases-archived-table", "received-quotes-table", "received-quotes-archived-table"].include?(table_id) && !invoice.has_associated_credit_note? %>
                <li>
                  <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#recordPaymentModal-<%= invoice.id %>">
                    Mark as Partially Paid
                  </a>
                </li>
                <li>
                  <%= link_to "Mark as Paid", mark_as_paid_invoice_path(invoice, tab: local_assigns[:active_tab]),
                      data: { turbo_method: :patch, turbo_confirm: "Mark this invoice as paid?" },
                      class: "dropdown-item" %>
                </li>

                <% if invoice.standard? && invoice.invoice_type == "sale" && ["sent", "approved", "partially_paid", "paid"].include?(invoice.status) %>
                  <li>
                    <%= link_to "Create Credit Note", 
                        new_invoice_path(original_invoice_id: invoice.id, category: "credit_note", tab: local_assigns[:active_tab]), 
                        class: "dropdown-item" %>
                  </li>
                <% end %>

                <li><hr class="dropdown-divider"></li>
              <% end %>

              <% if invoice.invoice_type == "purchase" && invoice.status == "pending" && !invoice.has_associated_credit_note? %>
                <li>
                  <%= link_to "Approve", approve_invoice_path(invoice, tab: local_assigns[:active_tab]),
                      data: { turbo_method: :patch, turbo_confirm: "Approve this purchase invoice?" },
                      class: "dropdown-item" %>
                </li>
                <li>
                  <%= link_to "Reject", reject_invoice_path(invoice, tab: local_assigns[:active_tab]),
                      data: { turbo_method: :patch, turbo_confirm: "Reject this purchase invoice?" },
                      class: "dropdown-item" %>
                </li>
                <li><hr class="dropdown-divider"></li>
              <% end %>

              <% if table_id == "purchases-table" && invoice.status == "approved" && !invoice.has_associated_credit_note? %>
                 <li>
                   <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#submitTaxModal-<%= invoice.id %>">
                     Submit Tax Documents
                   </a>
                 </li>
              <% end %>

              <% unless invoice.has_associated_credit_note? %>
                <% if invoice.archived? %>
                  <li>
                    <%= link_to "Unarchive", unarchive_invoice_path(invoice, tab: local_assigns[:active_tab]), data: { turbo_method: :patch }, class: "dropdown-item" %>
                  </li>
                <% else %>
                  <li>
                    <%= link_to "Archive", archive_invoice_path(invoice, tab: local_assigns[:active_tab]), data: { turbo_method: :patch, turbo_confirm: "Archive this invoice?" }, class: "dropdown-item" %>
                  </li>
                <% end %>
              <% end %>

              <% if invoice.status == "draft" %>
                <li>
                  <%= link_to "Delete", invoice_path(invoice, tab: local_assigns[:active_tab]),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this invoice?" },
                      class: "dropdown-item text-danger" %>
                </li>
              <% end %>

            </ul>
          </div>
          <% if table_id == "purchases-table" && invoice.status == "approved" %>
            <%= render partial: 'invoices/partials/submit_tax_documents_modal', locals: { invoice: invoice } %>
          <% end %>
          <% if invoice.invoice_type == "sale" && ["approved", "sent", "partially_paid"].include?(invoice.status) && !invoice.has_associated_credit_note? %>
            <%= render partial: 'invoices/partials/record_payment_modal', locals: { invoice: invoice } %>
          <% end %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>
<% end %>
