<div class="modal fade" id="submitTaxModal-<%= invoice.id %>" tabindex="-1" aria-labelledby="submitTaxModalLabel-<%= invoice.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow-md border-0 rounded-4">
      
      <div class="modal-header border-0">
        <h4 class="modal-title fw-bold" id="submitTaxModalLabel-<%= invoice.id %>">Submit Tax Documents</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 pt-0">
        <%= form_with model: TaxSubmission.new, url: tax_submissions_path, local: true, multipart: true do |f| %>
          <%= f.hidden_field :invoice_id, value: invoice.id %>
          <%= hidden_field_tag :redirect_url, invoices_path(request.query_parameters.merge(tab: invoice.invoice_type == 'purchase' ? 'purchase-invoices' : 'sales-invoices')) %>


          <div class="row g-3">

            <div class="col-12">
              <label class="form-label fw-semibold small text-muted" for="company_name_<%= invoice.id %>">Company Name</label>
              <% 
                 target_company = invoice.invoice_type == 'purchase' ? (invoice.sale_from || invoice.recipient_company) : invoice.recipient_company
              %>
              <input class="form-control rounded-3" type="text" value="<%= target_company&.name || 'Unknown Company' %>" readonly disabled>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold small text-muted" for="invoice_number_<%= invoice.id %>">Invoice Number</label>
              <input class="form-control rounded-3" type="text" value="<%= invoice.invoice_number %>" readonly disabled>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold small text-muted" for="tax_submission_form_2307_<%= invoice.id %>">Form 2307</label>
              <div class="file-dropzone tax-file-dropzone" data-target-input="#tax_submission_form_2307_<%= invoice.id %>" role="button" tabindex="0" aria-label="Upload Form 2307">
                <%= f.file_field :form_2307,
                      class: "file-upload-input",
                      id: "tax_submission_form_2307_#{invoice.id}",
                      accept: "image/*,application/pdf",
                      required: true,
                      tabindex: -1,
                      data: { list_target: "#form_2307_list_#{invoice.id}", multiple: false } %>
                <div class="dropzone-content text-center py-3 px-2">
                  <div class="dropzone-icon mb-2">
                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary"></i>
                  </div>
                  <div class="dropzone-default-text">
                    <div class="dropzone-text mb-1">
                      <span class="fw-semibold text-body">Drag &amp; drop Form 2307 here</span>, or <span class="text-primary text-decoration-underline browse-link">browse</span>
                    </div>
                    <div class="dropzone-hint text-muted small">
                      Supports JPG, PNG, and PDF (Single file)
                    </div>
                  </div>
                </div>
              </div>
              <ul id="form_2307_list_<%= invoice.id %>" class="list-group mt-2"></ul>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold small text-muted" for="tax_submission_deposit_slip_<%= invoice.id %>">Deposit Slip or Bank Transfer Details</label>
              <div class="file-dropzone tax-file-dropzone" data-target-input="#tax_submission_deposit_slip_<%= invoice.id %>" role="button" tabindex="0" aria-label="Upload Deposit Slip or Bank Transfer Details">
                <%= f.file_field :deposit_slip,
                      multiple: true,
                      class: "file-upload-input",
                      id: "tax_submission_deposit_slip_#{invoice.id}",
                      accept: "image/*,application/pdf",
                      required: true,
                      tabindex: -1,
                      data: { list_target: "#deposit_slip_list_#{invoice.id}", multiple: true } %>
                <div class="dropzone-content text-center py-3 px-2">
                  <div class="dropzone-icon mb-2">
                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary"></i>
                  </div>
                  <div class="dropzone-default-text">
                    <div class="dropzone-text mb-1">
                      <span class="fw-semibold text-body">Drag &amp; drop deposit slips or bank transfers here</span>, or <span class="text-primary text-decoration-underline browse-link">browse</span>
                    </div>
                    <div class="dropzone-hint text-muted small">
                      Upload one or more images (JPG, PNG) or PDFs
                    </div>
                  </div>
                </div>
              </div>
              <ul id="deposit_slip_list_<%= invoice.id %>" class="list-group mt-2"></ul>
            </div>

            <div class="col-12">
              <label class="form-label fw-semibold small text-muted" for="tax_submission_details_<%= invoice.id %>">Additional Notes</label>
              <%= f.text_area :details, class: "form-control rounded-3", rows: 4, id: "tax_submission_details_#{invoice.id}" %>
            </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-back px-4" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Submit", class: "btn btn-primary px-4", data: { disable_with: "Submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
