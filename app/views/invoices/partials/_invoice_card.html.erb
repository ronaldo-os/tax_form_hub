<div class="invoice-container p-4 p-md-5 mb-5" id="invoice_card">
  
  <!-- Top Header Bar -->
  <div class="d-flex justify-content-between align-items-end pb-4 mb-4 border-bottom pdf-no-break">
    <div>
      <span class="text-uppercase text-muted fw-bold extra-small tracking-wider d-block mb-1">Invoice</span>
      <h2 class="fw-bold mb-0 text-body">
        <%= if invoice.quote?
              'Quote'
            elsif invoice.credit_note?
              'Credit Note'
            else
              'Invoice Details'
            end %>
      </h2>
    </div>
    <div class="text-end">
      <span class="badge px-3 py-2 fs-6 rounded-pill fw-semibold
        <%= case invoice.status
            when "sent"     then "bg-primary-subtle text-primary border border-primary-subtle"
            when "approved" then "bg-success-subtle text-success border border-success-subtle"
            when "rejected" then "bg-danger-subtle text-danger border border-danger-subtle"
            when "paid"     then "bg-info-subtle text-info border border-info-subtle"
            when "draft"    then "bg-secondary-subtle text-body border border-secondary-subtle"
            else "bg-light text-muted border"
        end %>">
        <%= invoice.status.to_s.upcase %>
      </span>
    </div>
  </div>

  <%= form_with model: invoice, local: true, html: { multipart: true, class: "" } do |f| %>
    
    <!-- Parties & Details Header Grid -->
    <div class="row g-4 mb-4 pb-4 border-bottom pdf-no-break">
      <% sender = invoice.sale_from || invoice.user.company %>
      <% recipient = invoice.recipient_company %>

      <!-- TO / Recipient -->
      <div class="col-sm-4">
        <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-2">Billed To</p>
        <% if recipient.present? %>
          <h6 class="fw-bold text-body mb-1"><%= recipient.name %></h6>
          <% if recipient.address.present? %>
            <p class="mb-1 text-secondary small"><%= recipient.address %></p>
          <% end %>
          <p class="mb-2 text-secondary small"><%= recipient.country.presence || 'Philippines' %></p>
          
          <% company_num = invoice_company_number(recipient) %>
          <% if company_num.present? && company_num != '-' %>
            <p class="mb-1 extra-small text-muted">
              <%= recipient.company_id_type.presence || 'Company' %> ID: <strong class="text-body"><%= company_num %></strong>
            </p>
          <% end %>
          <% tax_num = invoice_tax_number(recipient) %>
          <% if tax_num.present? && tax_num != '-' %>
            <p class="mb-0 extra-small text-muted">
              <%= recipient.tax_id_type.presence || 'Tax' %> ID: <strong class="text-body"><%= tax_num %></strong>
            </p>
          <% end %>
        <% else %>
          <p class="text-muted small mb-0">—</p>
        <% end %>
      </div>

      <!-- FROM / Sender -->
      <div class="col-sm-4">
        <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-2">Issued By</p>
        <% if sender.present? %>
          <h6 class="fw-bold text-body mb-1"><%= sender.name %></h6>
          <% if sender.address.present? %>
            <p class="mb-1 text-secondary small"><%= sender.address %></p>
          <% end %>
          <p class="mb-2 text-secondary small"><%= sender.country.presence || 'Philippines' %></p>

          <% company_num = invoice_company_number(sender) %>
          <% if company_num.present? && company_num != '-' %>
            <p class="mb-1 extra-small text-muted">
              <%= sender.company_id_type.presence || 'Company' %> ID: <strong class="text-body"><%= company_num %></strong>
            </p>
          <% end %>
          <% tax_num = invoice_tax_number(sender) %>
          <% if tax_num.present? && tax_num != '-' %>
            <p class="mb-0 extra-small text-muted">
              <%= sender.tax_id_type.presence || 'Tax' %> ID: <strong class="text-body"><%= tax_num %></strong>
            </p>
          <% end %>
        <% else %>
          <p class="text-muted small mb-0">—</p>
        <% end %>
      </div>

      <!-- INVOICE METADATA -->
      <div class="col-sm-4">
        <div class="ps-sm-3">
          <div class="mb-2">
            <span class="text-uppercase text-muted fw-bold extra-small d-block mb-1">
              <%= invoice.quote? ? "Quote Number" : (invoice.credit_note? ? "Credit Note Number" : "Invoice Number") %>
            </span>
            <span class="fw-bold text-body fs-5"><%= invoice.invoice_number %></span>
          </div>

          <% if invoice.credit_note? %>
            <% original = invoice.contextual_original_invoice %>
            <% if original.present? %>
              <div class="mb-2">
                <span class="text-uppercase text-muted fw-bold extra-small d-block mb-1">Original Invoice</span>
                <span class="fw-semibold text-primary"><%= link_to original.invoice_number, invoice_path(original), class: "text-decoration-none" %></span>
              </div>
            <% end %>
          <% end %>

          <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light">
            <div>
              <span class="text-uppercase text-muted fw-bold extra-small d-block">Issue Date</span>
              <span class="fw-medium small text-body"><%= format_invoice_date(invoice.issue_date) %></span>
            </div>
            <div class="text-end">
              <span class="text-uppercase text-muted fw-bold extra-small d-block">Currency</span>
              <span class="fw-semibold small text-body"><%= invoice.currency %></span>
            </div>
          </div>

          <% if invoice.invoice_info.is_a?(Hash) && invoice.invoice_info.present? %>
            <% 
              input_types = %w[text date select number checkbox radio textarea]
              grouped = invoice.invoice_info.group_by { |k, _| k.split('.').first }
            %>
            <div class="mt-2 pt-2 border-top border-light">
              <% grouped.each do |group_name, fields| %>
                <% fields.each do |key, value| %>
                  <% next if value.blank? %>
                  <% parts = key.split('.') %>
                  <% label = parts[1].to_s.gsub('_', ' ').titleize %>
                  <div class="d-flex justify-content-between extra-small text-muted mb-1">
                    <span><%= label %>:</span>
                    <strong class="text-body">
                      <% if key.to_s.include?('date') %>
                        <%= format_invoice_date(value) %>
                      <% else %>
                        <%= value %>
                      <% end %>
                    </strong>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Line Items Table -->
    <div class="table-responsive mb-4 pdf-no-break">
      <table class="table align-middle text-nowrap table-borderless invoice-items-table border-bottom">
        <% if invoice.line_items.present? %>
          <thead class="border-top border-bottom border-secondary-subtle">
            <tr>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold" style="width: 100px;">Item ID</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold" style="width: 320px;">Description</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold text-center" style="width: 80px;">Qty</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold text-center" style="width: 80px;">Unit</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold text-end" style="width: 130px;">Price / Unit</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold text-center" style="width: 90px;">Tax</th>
              <th class="py-3 text-uppercase text-muted extra-small fw-bold text-end" style="width: 140px;">Total</th>
            </tr>
          </thead>
        <% end %>
        <tbody id="line-items">
          <% invoice.line_items_data.each_with_index do |item, index| %>
            <% 
               optional = item["optional_fields"] || {}
               next if optional["hidden_on_parent"] || optional[:hidden_on_parent]
            %>
            <tr class="line-item border-bottom border-light">
              <td class="py-3 small fw-semibold text-secondary"><%= item["item_id"].presence || '—' %></td>
              <td class="py-3 fw-medium text-body text-wrap" style="max-width: 320px;">
                <div><%= safe_join(item["description"].to_s.split("\n"), tag.br) %></div>
                
                <% if item["optional_fields"].present? %>
                  <% item["optional_fields"].each do |group_name, fields| %>
                    <% next unless fields.is_a?(Hash) %>
                    <div class="extra-small text-muted mt-1">
                      <% if group_name == "discount" || group_name == "charge" %>
                        <span class="badge bg-secondary-subtle text-body fw-semibold me-1"><%= group_name.capitalize %></span>
                        <% fields.each do |k, v| %>
                          <% next if v.blank? || k.to_s.include?('edit_type') %>
                          <% label = k.split('.').first.titleize %>
                          <span class="me-2"><%= label %>: <strong class="text-body"><%= k.to_s.include?('date') ? format_invoice_date(v) : v %></strong></span>
                        <% end %>
                      <% else %>
                        <% visible_fields = fields.reject { |_, v| v.blank? } %>
                        <% 
                          billing_key = visible_fields.keys.find { |k| k.to_s.include?('billing_cycle') }
                          start_key   = visible_fields.keys.find { |k| k.to_s.include?('start_date') }
                          end_key     = visible_fields.keys.find { |k| k.to_s.include?('end_date') || k.to_s.include?('overall_end_date') }

                          billing_val = visible_fields[billing_key] if billing_key
                          start_val   = visible_fields[start_key] if start_key
                          end_val     = visible_fields[end_key] if end_key

                          handled_keys = [billing_key, start_key, end_key].compact
                          extra_fields = visible_fields.except(*handled_keys)
                        %>
                        <% if billing_val.present? %>
                          <div class="mb-1">
                            Billing: <strong class="text-body"><%= billing_val.to_s.capitalize %></strong>
                          </div>
                        <% end %>
                        <% if start_val.present? || end_val.present? %>
                          <div>
                            <% if start_val.present? %>
                              <span>Start: <strong class="text-body"><%= format_invoice_date(start_val) %></strong></span>
                            <% end %>
                            <% if start_val.present? && end_val.present? %>
                              <span class="mx-1">•</span>
                            <% end %>
                            <% if end_val.present? %>
                              <span>End: <strong class="text-body"><%= format_invoice_date(end_val) %></strong></span>
                            <% end %>
                          </div>
                        <% end %>
                        <% if extra_fields.present? %>
                          <div class="mt-1">
                            <% extra_fields.each do |k, v| %>
                              <% 
                                parts = k.to_s.split('.')
                                label_part = parts.detect { |p| p !~ /^\d+$/ && !%w[text date select number].include?(p) && p != group_name }
                                label = label_part.present? ? label_part.titleize : k.to_s.humanize
                              %>
                              <span class="me-2"><%= label %>: <strong class="text-body"><%= k.to_s.include?('date') ? format_invoice_date(v) : v %></strong></span>
                            <% end %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </td>
              <td class="py-3 text-center small"><%= invoice_display_quantity(item) %></td>
              <td class="py-3 text-center small text-muted"><%= item["unit"] %></td>
              <td class="py-3 text-end small"><%= number_with_precision(item["price"].to_s.gsub(',', '').to_f, precision: 2, delimiter: ',') %></td>
              <td class="py-3 text-center small text-muted"><%= item["tax"].present? ? "#{item['tax']}%" : "-" %></td>
              <td class="py-3 text-end fw-semibold text-body"><%= number_with_precision(item["total"].to_s.gsub(',', '').to_f, precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>

          <!-- Price Adjustments Section -->
          <% if invoice.price_adjustments.present? %>
            <tr class="pdf-no-break">
              <td colspan="7" class="pt-4 pb-2 border-bottom border-secondary-subtle">
                <span class="text-uppercase text-muted fw-bold extra-small tracking-wider">Price Adjustments</span>
              </td>
            </tr>

            <% invoice.price_adjustments.each do |adjustment| %>
              <% 
                 optional = adjustment["optional_fields"] || {}
                 next if optional["hidden_on_parent"] || optional[:hidden_on_parent]
                 
                 adj_type = adjustment["type"].to_s.downcase.presence || "adjustment"
                 adj_badge_class = case adj_type
                                   when "discount" then "adj-badge-discount"
                                   when "charge", "monthly_charge" then "adj-badge-charge"
                                   when "fixedtax", "tax", "fixed_tax" then "adj-badge-fixedtax"
                                   when "fee" then "adj-badge-fee"
                                   else "adj-badge-default"
                                   end
                 
                 freq = adjustment["frequency"].presence || adjustment[:frequency].presence || ((adjustment["type"] == "monthly_charge" || adjustment["unit"] == "monthly_charge") ? "monthly" : nil)
                 start_d = adjustment["charge_start_date"].presence || adjustment[:charge_start_date].presence || adjustment["start_date"].presence || adjustment[:start_date].presence
                 end_d = adjustment["charge_end_date"].presence || adjustment[:charge_end_date].presence || adjustment["end_date"].presence || adjustment[:end_date].presence
                 is_recurring_adj = freq.present? && %w[monthly annually yearly].include?(freq.to_s.downcase) || adjustment["type"] == "monthly_charge" || start_d.present?
              %>
              <tr class="price-adjustment-row border-bottom border-light pdf-no-break">
                <td class="py-3 align-middle">
                  <span class="adj-badge <%= adj_badge_class %>"><%= (adjustment["type"].presence || "adjustment").humanize.capitalize %></span>
                </td>
                <td colspan="4" class="py-3 align-middle">
                  <div class="fw-medium text-body small">
                    <%= adjustment["description_edit"].presence || adjustment["description"].presence || "Adjustment" %>
                  </div>
                  <% if is_recurring_adj %>
                    <div class="extra-small text-muted mt-1">
                      <div class="mb-1">
                        Billing: <strong class="text-body"><%= (freq.presence || "monthly").to_s.capitalize %></strong>
                      </div>
                      <% if start_d.present? || end_d.present? %>
                        <div>
                          <% if start_d.present? %>
                            <span>Start: <strong class="text-body"><%= format_invoice_date(start_d) %></strong></span>
                          <% end %>
                          <% if start_d.present? && end_d.present? %>
                            <span class="mx-1">•</span>
                          <% end %>
                          <% if end_d.present? %>
                            <span>End: <strong class="text-body"><%= format_invoice_date(end_d) %></strong></span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="py-3 align-middle text-center small text-muted">
                  <%= adjustment["unit"].presence || invoice.currency %>
                </td>
                <td class="py-3 align-middle text-end fw-semibold small text-body">
                  <%= number_with_precision((adjustment["total"].presence || adjustment["amount"]).to_s.gsub(',', '').to_f, precision: 2, delimiter: ',') %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Summary / Totals Box -->
    <div class="row justify-content-end mb-4 pb-2 pdf-no-break totals-section">
      <div class="col-sm-6 col-md-5">
        <div class="pt-2">
          <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
            <span>Subtotal excl. taxes:</span>
            <strong class="text-body"><%= number_with_precision(invoice.total.dig("subtotal").to_f, precision: 2, delimiter: ',') %> <%= invoice.currency %></strong>
          </div>

          <% if invoice.total["tax_breakdown"].present? && invoice.total["tax_breakdown"].is_a?(Hash) %>
            <% invoice.total["tax_breakdown"].each do |name, data| %>
              <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
                <span>
                  <% if data.is_a?(Hash) %>
                    <%= name %> <em class="extra-small text-muted">(of <%= number_with_precision(data["basis"].to_f, precision: 2, delimiter: ',') %> <%= invoice.currency %>)</em>
                  <% else %>
                    <%= name %>
                  <% end %>
                </span>
                <strong class="text-body">
                  <%= number_with_precision((data.is_a?(Hash) ? data["tax"] : data).to_f, precision: 2, delimiter: ',') %> <%= invoice.currency %>
                </strong>
              </div>
            <% end %>
          <% else %>
            <div class="d-flex justify-content-between align-items-center mb-2 small text-secondary">
              <span>Total taxes:</span>
              <strong class="text-body"><%= number_with_precision(invoice.total.dig("tax").to_f, precision: 2, delimiter: ',') %> <%= invoice.currency %></strong>
            </div>
          <% end %>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top border-body-emphasis mt-3">
            <span class="fw-bold text-body fs-6">Total (<%= invoice.currency %>):</span>
            <h3 class="fw-bold text-primary mb-0">
              <%= number_with_precision(invoice.total.dig("grand_total").to_f, precision: 2, delimiter: ',') %>
            </h3>
          </div>
          <% if invoice.total.dig("tax").to_f != 0 || invoice.total["tax_breakdown"].present? %>
            <p class="text-muted text-end extra-small mb-0 mt-1">
              Incl. taxes <%= number_with_precision(invoice.total.dig("tax").to_f, precision: 2, delimiter: ',') %> <%= invoice.currency %>
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Payment Terms, Message, Attachments Section -->
    <div class="row g-4 pt-4 border-top border-secondary-subtle pdf-no-break">
      <% unless invoice.quote? %>
        <div class="col-md-6 payment-terms-box pdf-no-break">
          <% if invoice.payment_terms.present? %>
            <div class="pe-md-3">
              <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-3">Payment Terms</p>

              <% payment_labels = {
                "cash" => "Cash Payment",
                "check" => "Check Payment",
                "bank" => "Bank Transfer",
                "bank_card" => "Bank Card Payment"
              } %>

              <% invoice.payment_terms.each do |group_key, fields| %>
                <% if fields.present? || payment_labels.key?(group_key) %>
                  <div class="mb-3">
                    <span class="badge bg-secondary-subtle text-body extra-small mb-2 fw-semibold">
                      <%= payment_labels[group_key] || group_key.titleize %>
                    </span>

                    <% if fields.present? %>
                      <div class="row g-2">
                        <% fields.each do |field_key, field_value| %>
                          <% next if field_key.ends_with?("_edit") || field_value.blank? %>
                          <% parts = field_key.split('.') %>
                          <% label_part = parts.detect { |p| p !~ /^\d+$/ && !%w[text date select].include?(p) && p != group_key } %>
                          <% label = label_part.present? ? label_part.titleize : field_key.titleize %>

                          <div class="col-6">
                            <span class="text-muted extra-small d-block"><%= label %>:</span>
                            <strong class="text-body small">
                              <% if field_key.to_s.include?('date') && field_value.present? %>
                                <%= format_invoice_date(field_value) %>
                              <% else %>
                                <%= field_value %>
                              <% end %>
                            </strong>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <!-- Delivery Details -->
          <% if [
                invoice.delivery_details_postbox,
                invoice.delivery_details_street,
                invoice.delivery_details_number,
                invoice.delivery_details_locality_name,
                invoice.delivery_details_zip_code,
                invoice.delivery_details_city,
                invoice.delivery_details_country,
                invoice.delivery_details_gln,
                invoice.delivery_details_company_name,
                invoice.delivery_details_tax_id,
                invoice.delivery_details_tax_number
              ].any?(&:present?) %>
            <div class="mt-3 pe-md-3">
              <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-2">Delivery Details</p>
              <p class="small text-secondary mb-1">
                <%= [
                      invoice.delivery_details_postbox,
                      invoice.delivery_details_street,
                      invoice.delivery_details_number,
                      invoice.delivery_details_locality_name,
                      invoice.delivery_details_zip_code,
                      invoice.delivery_details_city,
                      invoice.delivery_details_country
                    ].compact.reject(&:blank?).join(', ') %>
              </p>
              <% if invoice.delivery_details_company_name.present? %>
                <p class="extra-small text-muted mb-0">Company: <strong><%= invoice.delivery_details_company_name %></strong></p>
              <% end %>
            </div>
          <% end %>

          <%= render partial: "invoices/partials/view_invoice_location_details", locals: { location: @ship_from_location, type_name: "Ship From Location" } if @ship_from_location.present? %>
          <%= render partial: "invoices/partials/view_invoice_location_details", locals: { location: @remit_to_location_id, type_name: "Remit To Location" } if @remit_to_location_id.present? %>
          <%= render partial: "invoices/partials/view_invoice_location_details", locals: { location: @tax_representative_location_id, type_name: "Tax Representative Location" } if @tax_representative_location_id.present? %>
        </div>
      <% end %>

      <div class="<%= invoice.quote? ? 'col-md-12' : 'col-md-6' %> message-box pdf-no-break">
        <% if invoice.recipient_note.present? %>
          <div class="ps-3 border-start border-2 border-primary-subtle mb-3">
            <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-2">Message / Notes</p>
            <div class="small text-secondary leading-relaxed mb-0">
              <%= simple_format(invoice.recipient_note) %>
            </div>
          </div>
        <% end %>

        <!-- Attachments -->
        <% persisted_attachments = invoice.recurring_sub_invoice? ? [] : invoice.attachments.select(&:persisted?) %>
        <div id="attachments-section" class="mt-3 pdf-no-break <%= 'd-none' if persisted_attachments.empty? %>">
          <p class="text-uppercase text-muted fw-bold extra-small tracking-wider mb-2">Attachments</p>
          <div id="persisted-attachments-container">
            <div class="row g-3 no-break">
              <% persisted_attachments.each do |attachment| %>
                <div class="col-6">
                  <div class="text-center p-2 border rounded-1 attachment-item">
                    <div class="d-flex align-items-center justify-content-center" style="min-height: 100px;">
                      <% if attachment.image? %>
                        <%= link_to url_for(attachment), target: "_blank" do %>
                          <%= image_tag attachment, class: "img-fluid rounded", style: "max-height: 110px; object-fit: contain;" %>
                        <% end %>
                      <% elsif attachment.content_type == "application/pdf" %>
                        <%= link_to url_for(attachment), target: "_blank" do %>
                          <embed src="<%= url_for(attachment) %>" type="application/pdf" class="w-100" style="height: 90px;" />
                        <% end %>
                      <% else %>
                        <span class="fs-2 text-muted">&#128196;</span>
                      <% end %>
                    </div>
                    <div class="text-truncate extra-small text-muted mt-2 px-1" title="<%= attachment.filename.to_s %>">
                      <%= attachment.filename.to_s %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% unless invoice.quote? %>
      <% if invoice.footer_notes.present? %>
        <div class="mt-4 pt-3 border-top pdf-no-break text-muted extra-small">
          <p class="mb-0"><%= simple_format(invoice.footer_notes) %></p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>