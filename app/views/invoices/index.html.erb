<% content_for :page_title, "Invoices" %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "invoices", media: "all" %>
<% end %>

<div class="container invoices-page py-2 py-md-3">
  <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mb-3 invoice-header-bar">
    <!-- Tab Navigation Container -->
    <div class="tabs-scroll-container">
      <ul class="custom_nav_tabs nav nav-tabs border-0" id="submissionTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if @active_tab == 'sales-invoices' %>" id="sales-invoices-tab" data-bs-toggle="tab" data-bs-target="#sales-invoices" type="button" role="tab" aria-controls="sales-invoices" aria-selected="<%= @active_tab == 'sales-invoices' %>">
            Sales Invoices
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if @active_tab == 'purchase-invoices' %>" id="purchase-invoices-tab" data-bs-toggle="tab" data-bs-target="#purchase-invoices" type="button" role="tab" aria-controls="purchase-invoices" aria-selected="<%= @active_tab == 'purchase-invoices' %>">
            Purchase Invoices
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if @active_tab == 'sent-quotes' %>" id="sent-quotes-tab" data-bs-toggle="tab" data-bs-target="#sent-quotes" type="button" role="tab" aria-controls="sent-quotes" aria-selected="<%= @active_tab == 'sent-quotes' %>">
            Sent Quotes
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if @active_tab == 'received-quotes' %>" id="received-quotes-tab" data-bs-toggle="tab" data-bs-target="#received-quotes" type="button" role="tab" aria-controls="received-quotes" aria-selected="<%= @active_tab == 'received-quotes' %>">
            Received Quotes
          </button>
        </li>
      </ul>
    </div>

    <!-- Create Invoice buttons aligned right / stacked on mobile -->
    <div class="invoice-action-buttons d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end">
      <%= link_to 'Create Quote', new_invoice_path(category: 'quote', tab: @active_tab), class: 'btn btn-outline-primary flex-fill flex-sm-grow-0 text-nowrap' %>
      <%= link_to 'Create Credit Note', new_invoice_path(category: 'credit_note', tab: @active_tab), class: 'btn btn-outline-secondary flex-fill flex-sm-grow-0 text-nowrap' %>
      <%= link_to 'Create Invoice', new_invoice_path(tab: @active_tab), class: 'btn btn-primary flex-fill flex-sm-grow-0 text-nowrap' %>
    </div>
  </div>

  <!-- Tab Content -->
  <div class="tab-content" 
       id="invoiceTabsContent"
       data-sale-trends="<%= @invoice_trends_sale.to_json %>"
       data-purchase-trends="<%= @invoice_trends_purchase.to_json %>">

    <!-- Sales Invoices -->
    <div class="tab-pane fade <%= 'show active' if @active_tab == 'sales-invoices' %>" id="sales-invoices" role="tabpanel" aria-labelledby="sales-invoices-tab">
      <div class="row g-2 g-md-3 mb-3">
        <% ["total", "draft", "sent", "paid"].each do |status| %>
          <% totals = @invoice_totals_sale[status] %>
          <div class="col-6 col-md-3">
            <div class="card card-filter shadow-sm h-100 <%= 'active' if status == 'total' %>" 
                data-table="#sales-table" 
                data-status="<%= (status == "total" ? "" : status) %>">
              <div class="card-body d-flex flex-column justify-content-between p-3">
                <div class="d-flex justify-content-between align-items-center mb-1 mb-md-2">
                  <p class="text-muted mb-0 text-capitalize small fw-medium"><%= status %></p>
                  <i class="fa-solid fa-filter text-secondary extra-small"></i>
                </div>

                <div class="d-flex align-items-center justify-content-between my-1">
                  <h4 class="fw-bold mb-0 me-1 stat-card-number"><%= totals["overall"] %></h4>
                  <div class="chart-wrapper">
                    <canvas id="chart-sale-<%= status %>"></canvas>
                  </div>
                </div>

                <small class="text-muted extra-small">
                  <span class="<%= totals["percent_change"] > 0 ? 'text-success' : totals["percent_change"] < 0 ? 'text-danger' : 'text-muted' %> fw-semibold">
                    <%= "#{totals["percent_change"] > 0 ? '+' : ''}#{totals["percent_change"]}%" %>
                  </span>
                  <span class="d-none d-sm-inline">from last month</span>
                </small>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="card mb-4">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Active Sales Invoices</h5>
          <%# Server-side DataTable for large datasets - loads data via AJAX %>
          <%= render partial: 'invoices/partials/server_side_table',
                     locals: { table_id: 'sales-table', invoice_type: 'sale', archived: false, quote: false, active_tab: 'sales-invoices' } %>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Archived Sales Invoices</h5>
          <% cache [current_user, @invoices_sale_archived, 'sales_archived'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @invoices_sale_archived, table_id: 'sales-archived-table', active_tab: 'sales-invoices' } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sent Quotes -->
    <div class="tab-pane fade <%= 'show active' if @active_tab == 'sent-quotes' %>" id="sent-quotes" role="tabpanel" aria-labelledby="sent-quotes-tab">
      <div class="card mb-4">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Active Sent Quotes</h5>
          <% cache [current_user, @quotes_sale, 'quotes_sale_active'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @quotes_sale, table_id: 'sent-quotes-table', title: 'Quote', active_tab: 'sent-quotes' } %>
          <% end %>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Archived Sent Quotes</h5>
          <% cache [current_user, @quotes_sale_archived, 'quotes_sale_archived'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @quotes_sale_archived, table_id: 'sent-quotes-archived-table', title: 'Quote', active_tab: 'sent-quotes' } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Purchase Invoices -->
    <div class="tab-pane fade <%= 'show active' if @active_tab == 'purchase-invoices' %>" id="purchase-invoices" role="tabpanel" aria-labelledby="purchase-invoices-tab">
      <div class="row g-2 g-md-3 mb-3">
        <% ["total", "draft", "sent", "paid"].each do |status| %>
          <% totals = @invoice_totals_purchase[status] %>
          <div class="col-6 col-md-3">
            <div class="card card-filter shadow-sm h-100 <%= 'active' if status == 'total' %>" 
                data-table="#purchases-table" 
                data-status="<%= (status == "total" ? "" : status) %>">
              <div class="card-body d-flex flex-column justify-content-between p-3">
                <div class="d-flex justify-content-between align-items-center mb-1 mb-md-2">
                  <p class="text-muted mb-0 text-capitalize small fw-medium"><%= status %></p>
                  <i class="fa-solid fa-filter text-secondary extra-small"></i>
                </div>

                <div class="d-flex align-items-center justify-content-between my-1">
                  <h4 class="fw-bold mb-0 me-1 stat-card-number"><%= totals["overall"] %></h4>
                  <div class="chart-wrapper">
                    <canvas id="chart-purchase-<%= status %>"></canvas>
                  </div>
                </div>

                <small class="text-muted extra-small">
                  <span class="<%= totals["percent_change"] > 0 ? 'text-success' : totals["percent_change"] < 0 ? 'text-danger' : 'text-muted' %> fw-semibold">
                    <%= "#{totals["percent_change"] > 0 ? '+' : ''}#{totals["percent_change"]}%" %>
                  </span>
                  <span class="d-none d-sm-inline">from last month</span>
                </small>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="card mb-4">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Active Purchase Invoices</h5>
          <% cache [current_user, @invoices_purchase, 'purchase_active'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @invoices_purchase, table_id: 'purchases-table', active_tab: 'purchase-invoices' } %>
          <% end %>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Archived Purchase Invoices</h5>
          <% cache [current_user, @invoices_purchase_archived, 'purchase_archived'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @invoices_purchase_archived, table_id: 'purchases-archived-table', active_tab: 'purchase-invoices' } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Received Quotes -->
    <div class="tab-pane fade <%= 'show active' if @active_tab == 'received-quotes' %>" id="received-quotes" role="tabpanel" aria-labelledby="received-quotes-tab">
      <div class="card mb-4">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Active Received Quotes</h5>
          <% cache [current_user, @quotes_purchase, 'quotes_purchase_active'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @quotes_purchase, table_id: 'received-quotes-table', title: 'Quote', active_tab: 'received-quotes' } %>
          <% end %>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-3">
          <h5 class="fw-bold mb-3">Archived Received Quotes</h5>
          <% cache [current_user, @quotes_purchase_archived, 'quotes_purchase_archived'] do %>
            <%= render partial: 'invoices/partials/index_invoice_table',
                       locals: { invoices: @quotes_purchase_archived, table_id: 'received-quotes-archived-table', title: 'Quote', active_tab: 'received-quotes' } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="invoicePreviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="modal-title fw-bold me-auto mb-0">Preview</h5>
        <div class="d-flex align-items-center gap-1 pdf-zoom-controls ms-auto me-2">
          <button type="button" class="btn btn-sm btn-outline-secondary pdf-zoom-out" title="Zoom Out">
            <i class="fa-solid fa-minus"></i>
          </button>
          <span class="badge bg-secondary-subtle text-secondary px-2 py-1 pdf-zoom-level">Fit</span>
          <button type="button" class="btn btn-sm btn-outline-secondary pdf-zoom-in" title="Zoom In">
            <i class="fa-solid fa-plus"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary pdf-zoom-fit" title="Fit to Screen">
            <i class="fa-solid fa-expand"></i>
          </button>
        </div>
        <button type="button" class="btn-close m-0" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="pdf-preview-container">
          <div class="pdf-preview-scaler">
            <div class="pdf-preview-wrapper">
              <div id="invoicePreviewCard"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
