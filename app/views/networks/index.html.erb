<% content_for :page_title, "My Network" %>

<div class="container py-3 py-md-4 networks-page">
  <!-- Search & Add Company Section -->
  <div class="card shadow-sm border-0 mb-4 network-search-card rounded-4">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <label for="company_search_input" class="form-label fw-bold small text-body-secondary mb-0">
          <i class="fa-solid fa-user-plus text-primary me-2"></i>Add Company to Network
        </label>
        <% if params[:query].present? %>
          <span class="badge bg-light text-secondary small">Searching "<%= params[:query] %>"</span>
        <% end %>
      </div>
      
      <div class="position-relative search-input-wrapper">
        <%= form_with url: networks_path, method: :get, class: "w-100", id: "network_search_form", data: { turbo_frame: "search_results" } do |f| %>
          <div class="input-group input-group-lg search-input-group">
            <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-muted d-flex align-items-center justify-content-center">
              <i class="fa-solid fa-magnifying-glass fs-6"></i>
            </span>
            <%= f.text_field :query, 
                value: params[:query], 
                class: "form-control border-0 ps-1 fs-6 shadow-none", 
                id: "company_search_input",
                placeholder: "Search company by name or industry...",
                autocomplete: "off" %>
          </div>
          <%= f.submit "Search", class: "d-none" %>
        <% end %>

        <turbo-frame id="search_results">
          <% if @search_results.present? %>
            <div class="network-autocomplete-popover position-absolute w-100 bg-body shadow-lg rounded-3 border mt-2">
              <div class="d-flex align-items-center justify-content-between p-3 border-bottom bg-body-tertiary rounded-top-3">
                <span class="text-muted small fw-semibold">Matches Found (<%= @search_results.count %>)</span>
                <span class="badge bg-primary-subtle text-primary small fs-8">Tap Add to Connect</span>
              </div>
              <div class="list-group list-group-flush network-search-list overflow-auto" style="max-height: 360px;">
                <% @search_results.each do |company| %>
                  <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-bottom">
                    <div class="d-flex align-items-center gap-3 min-w-0 me-2">
                      <div class="company-avatar-square flex-shrink-0 rounded-3 border bg-light d-flex align-items-center justify-content-center">
                         <% if company.profile_image.attached? %>
                            <%= image_tag company.profile_image, class: "img-fluid rounded-3 w-100 h-100", style: "object-fit: cover;" %>
                         <% else %>
                            <i class="fa-solid fa-building text-primary fs-5"></i>
                         <% end %>
                      </div>
                      <div class="min-w-0">
                        <h6 class="mb-0 fw-bold text-truncate text-body fs-6"><%= company.name %></h6>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                          <span class="badge bg-secondary-subtle text-body-secondary fs-8 text-truncate" style="max-width: 140px;">
                            <%= company.industry.presence || "General Industry" %>
                          </span>
                          <% if company.address.present? %>
                            <small class="text-muted text-truncate fs-8" style="max-width: 150px;">
                              <i class="fa-solid fa-location-dot me-1"></i><%= company.address %>
                            </small>
                          <% end %>
                        </div>
                      </div>
                    </div>
                    <%= button_to networks_path(company_id: company.id, query: params[:query]), method: :post, class: "btn btn-primary btn-sm px-3 py-2 rounded-pill fw-semibold flex-shrink-0 text-nowrap", data: { turbo_frame: "_top" } do %>
                      <i class="fa-solid fa-plus me-1"></i>Add
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% elsif params[:query].present? %>
            <div class="network-autocomplete-popover position-absolute w-100 bg-body shadow-lg rounded-3 border mt-2 p-4 text-center">
              <div class="avatar-circle-icon bg-light text-muted mx-auto mb-2">
                <i class="fa-solid fa-building-circle-xmark fs-4"></i>
              </div>
              <p class="fw-semibold mb-1 text-body">No matching companies found</p>
              <p class="text-muted small mb-0">No unconnected companies match "<%= params[:query] %>".</p>
            </div>
          <% end %>
        </turbo-frame>
      </div>
    </div>
  </div>

  <!-- Connected Companies Section Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="fw-bold mb-0 text-body">
      Connected Companies
    </h5>
    <span class="badge rounded-pill bg-primary-subtle text-primary px-2.5 py-1.5 fs-7 fw-semibold">
      <i class="fa-solid fa-building me-1"></i><%= @networks.count %> Connected
    </span>
  </div>

  <!-- Network List Section -->
  <% if @networks.any? %>
    <div class="row g-3 network-cards-grid">
      <% @networks.each do |network| %>
        <% company = network.company %>
        <div class="col-12 col-sm-6 col-md-6 col-xl-4">
          <div class="card shadow-sm border-0 h-100 network-company-card rounded-4">
            <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
              <div>
                <!-- Top Card Bar: Logo + Text + Action Menu -->
                <div class="d-flex align-items-start justify-content-between mb-3 gap-2">
                  <div class="company-avatar-box rounded-3 border d-flex justify-content-center align-items-center flex-shrink-0">
                    <% if company.profile_image.attached? %>
                      <%= image_tag company.profile_image, class: "img-fluid rounded-3 w-100 h-100", style: "object-fit: cover;", onerror: "this.style.display='none'; this.nextElementSibling.style.display='flex';" %>
                      <div class="avatar-initials-badge text-primary fw-bold" style="display: none;">
                        <%= company.name.first(2).upcase %>
                      </div>
                    <% else %>
                      <div class="avatar-initials-badge text-primary fw-bold">
                        <%= company.name.first(2).upcase %>
                      </div>
                    <% end %>
                  </div>

                  <div class="flex-grow-1 me-2" style="width: 0; min-width: 0; overflow: hidden;">
                    <h6 class="card-title fw-bold text-body text-truncate mb-1" title="<%= company.name %>" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; display: block;">
                      <%= link_to company.name, company_path(company), class: "text-decoration-none text-body text-truncate d-block company-title-link", title: company.name, style: "overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; width: 100%;" %>
                    </h6>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 fs-8 fw-semibold d-inline-flex align-items-center gap-1">
                      <span class="status-dot-active"></span> Connected
                    </span>
                  </div>

                  <div class="dropdown flex-shrink-0 ms-auto">
                    <button class="btn btn-icon-touch btn-light text-secondary rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Company options">
                      <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3 border-0 py-1">
                      <li>
                        <%= link_to company_path(company), class: "dropdown-item py-2 px-3 fs-7" do %>
                          <i class="fa-solid fa-eye me-2 text-primary"></i> View Details
                        <% end %>
                      </li>
                      <li><hr class="dropdown-divider my-1"></li>
                      <li>
                        <%= button_to network_path(network), method: :delete, class: "dropdown-item text-danger py-2 px-3 fs-7", data: { turbo_confirm: "Are you sure you want to remove #{company.name} from your network?" } do %>
                          <i class="fa-solid fa-trash-can me-2"></i> Remove Network
                        <% end %>
                      </li>
                    </ul>
                  </div>
                </div>

                <!-- Company Details Metadata -->
                <div class="network-details-list d-flex flex-column gap-2 my-3">
                  <div class="d-flex align-items-center text-muted small">
                    <div class="meta-icon-wrapper me-2 flex-shrink-0 text-center">
                      <i class="fa-solid fa-industry text-primary opacity-75"></i>
                    </div>
                    <span class="text-truncate"><%= company.industry.presence || "General Industry" %></span>
                  </div>

                  <div class="d-flex align-items-center text-muted small">
                    <div class="meta-icon-wrapper me-2 flex-shrink-0 text-center">
                      <i class="fa-solid fa-phone text-primary opacity-75"></i>
                    </div>
                    <span class="text-truncate">
                      <% if company.phone.present? %>
                        <%= link_to company.phone, "tel:#{company.phone.gsub(/[^\d+]/, '')}", class: "text-decoration-none text-body-secondary" %>
                      <% else %>
                        <span class="text-secondary opacity-75">No phone number</span>
                      <% end %>
                    </span>
                  </div>

                  <div class="d-flex align-items-center text-muted small">
                    <div class="meta-icon-wrapper me-2 flex-shrink-0 text-center">
                      <i class="fa-solid fa-globe text-primary opacity-75"></i>
                    </div>
                    <span class="text-truncate">
                      <% if company.website.present? %>
                        <%= link_to company.website, company.website.start_with?('http') ? company.website : "https://#{company.website}", target: "_blank", class: "text-decoration-none link-primary" %>
                      <% else %>
                        <span class="text-secondary opacity-75">No website added</span>
                      <% end %>
                    </span>
                  </div>

                  <% if company.address.present? %>
                    <div class="d-flex align-items-center text-muted small">
                      <div class="meta-icon-wrapper me-2 flex-shrink-0 text-center">
                        <i class="fa-solid fa-location-dot text-primary opacity-75"></i>
                      </div>
                      <span class="text-truncate"><%= company.address %></span>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Footer Pills & Action -->
              <div class="pt-3 border-top d-flex align-items-center justify-content-between gap-2 mt-2">
                <span class="badge bg-body-tertiary text-body-secondary rounded-pill px-2.5 py-1.5 fs-8">
                  <%= company.ownership.presence || "Private" %>
                </span>
                
                <%= link_to company_path(company), class: "btn btn-outline-primary btn-sm rounded-pill px-3 py-1.5 fs-7 fw-semibold" do %>
                  View Profile <i class="fa-solid fa-arrow-right ms-1"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State for Networks -->
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 bg-body">
      <div class="card-body py-4">
        <div class="empty-network-illustration bg-primary-subtle text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">
          <i class="fa-solid fa-network-wired fs-2"></i>
        </div>
        <h5 class="fw-bold text-body mb-2">Your Network is Empty</h5>
        <p class="text-muted small mx-auto mb-4" style="max-width: 420px;">
          Connect with companies to manage invoices, tax forms, and track vendor relationships effortlessly. Use the search bar above to start building your network.
        </p>
      </div>
    </div>
  <% end %>
</div>
