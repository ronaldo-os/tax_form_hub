<%
  tax_sub = local_assigns[:tax_submission] || @tax_submission
  @tax_submission ||= tax_sub
  my_company_ids = current_user ? ((current_user.companies.pluck(:id) << current_user.company_id).compact.uniq) : []
  is_reviewer = current_user&.superadmin? || (tax_sub&.company_id.present? && my_company_ids.include?(tax_sub.company_id))

  is_admin = controller_path.to_s.start_with?("admin/") || (defined?(@is_admin) && @is_admin)
  update_url = is_admin ? admin_tax_submission_path(tax_sub) : tax_submission_path(tax_sub)

  fallback_path = is_admin ? admin_tax_submissions_path : tax_submissions_path
  tab_param = tax_sub.archived? ? "archived" : nil

  redirect_target = if request.referer.present?
    begin
      uri = URI.parse(request.referer)
      query_params = uri.query.present? ? Rack::Utils.parse_nested_query(uri.query) : {}
      query_params["open_submission"] = tax_sub.id.to_s
      query_params["tab"] = tab_param if tab_param && !query_params.key?("tab")
      uri.query = Rack::Utils.build_query(query_params)
      uri.path + (uri.query.present? ? "?#{uri.query}" : "")
    rescue URI::InvalidURIError
      "#{fallback_path}?open_submission=#{tax_sub.id}#{tab_param ? "&tab=#{tab_param}" : ""}"
    end
  else
    "#{fallback_path}?open_submission=#{tax_sub.id}#{tab_param ? "&tab=#{tab_param}" : ""}"
  end
%>

<% if is_reviewer %>
  <div class="card shadow-sm border-0 mb-4 reviewer-quick-actions-card">
    <div class="card-body p-3 p-sm-4">
      <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="reviewer-icon-wrapper rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width: 42px; height: 42px; min-width: 42px;">
            <i class="fa-solid fa-user-check fs-5"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0 text-body">Reviewer Quick Actions</h6>
            <span class="text-muted small">Update submission status directly from this overview</span>
          </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 reviewer-quick-actions-buttons">
          <!-- Toggle Reviewed Form -->
          <%= form_with model: tax_sub, url: update_url, method: :patch, local: false, data: { remote: true }, class: "d-inline reviewer-quick-action-form" do |f| %>
            <%= f.hidden_field :reviewed, value: tax_sub.reviewed? ? 0 : 1 %>
            <%= hidden_field_tag :redirect_to, redirect_target %>
            <% if tax_sub.reviewed? %>
              <button type="submit" class="btn btn-reviewer-action btn-reviewer-unmark" title="Unmark this submission as reviewed" id="unmarkReviewedBtn">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Unmark Reviewed</span>
              </button>
            <% else %>
              <button type="submit" class="btn btn-reviewer-action btn-reviewer-review" title="Mark this submission as reviewed" id="markReviewedBtn">
                <i class="fa-solid fa-check"></i>
                <span>Mark as Reviewed</span>
              </button>
            <% end %>
          <% end %>

          <!-- Toggle Processed Form -->
          <%= form_with model: tax_sub, url: update_url, method: :patch, local: false, data: { remote: true }, class: "d-inline reviewer-quick-action-form" do |f| %>
            <%= f.hidden_field :processed, value: tax_sub.processed? ? 0 : 1 %>
            <%= hidden_field_tag :redirect_to, redirect_target %>
            <% if tax_sub.processed? %>
              <button type="submit" class="btn btn-reviewer-action btn-reviewer-unmark" title="Unmark this submission as processed" id="unmarkProcessedBtn">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Unmark Processed</span>
              </button>
            <% else %>
              <button type="submit" class="btn btn-reviewer-action btn-reviewer-process" title="Mark this submission as processed" id="markProcessedBtn">
                <i class="fa-solid fa-check-double"></i>
                <span>Mark as Processed</span>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-4">

    <div class="row g-4">
      <!-- Submission ID -->
      <div class="col-md-3">
        <p class="text-muted mb-1">Submission ID</p>
        <p class="fw-semibold fs-6"><%= @tax_submission.company_submission_id.presence || @tax_submission.user_transaction_id %></p>
      </div>

      <!-- Invoice # -->
      <div class="col-md-3">
        <p class="text-muted mb-1">Invoice #</p>
        <p class="fw-semibold fs-6">
          <% if @tax_submission.invoice %>
            <%= link_to @tax_submission.invoice.invoice_number, invoice_path(@tax_submission.invoice), class: "text-decoration-none text-primary", target: "_blank" %>
          <% else %>
            N/A
          <% end %>
        </p>
      </div>

      <!-- Status -->
      <div class="col-md-3">
        <p class="text-muted mb-1">Status</p>
        <% if @tax_submission.reviewed? && @tax_submission.processed? %>
          <span class="badge rounded-pill bg-success px-3 py-2">Processed &amp; Reviewed</span>
        <% elsif @tax_submission.reviewed? %>
          <span class="badge rounded-pill bg-info px-3 py-2">Reviewed</span>
        <% elsif @tax_submission.processed? %>
          <span class="badge rounded-pill bg-warning text-dark px-3 py-2">Processed</span>
        <% else %>
          <span class="badge rounded-pill bg-secondary px-3 py-2">Pending</span>
        <% end %>
      </div>

      <!-- Email -->
      <div class="col-md-3">
        <p class="text-muted mb-1">Email</p>
        <p class="fw-semibold fs-6"><%= @tax_submission.email.presence || @tax_submission.invoice&.user&.email || "N/A" %></p>
      </div>

      <!-- Submitted By -->
      <div class="col-md-6">
        <p class="text-muted mb-1">Submitted By</p>
        <p class="fw-semibold fs-6"><%= @tax_submission.invoice&.sale_from&.name || @tax_submission.invoice&.user&.company&.name || "N/A" %></p>
      </div>

      <!-- Submitted To -->
      <div class="col-md-6">
        <p class="text-muted mb-1">Submitted To</p>
        <p class="fw-semibold fs-6"><%= @tax_submission.company&.name || @tax_submission.invoice&.recipient_company&.name || @tax_submission.company_name || "N/A" %></p>
      </div>
      <!-- Details -->
      <div class="col-md-12">
        <p class="text-muted mb-1">Details</p>
        <div class="p-3 bg-light rounded small text-muted">
          <%= simple_format(@tax_submission.details.presence || "No additional details provided.") %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Attachments -->
<div class="row g-4">
  <!-- Form 2307 -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header bg-light border-0">
        <h6 class="fw-bold mb-0">Form 2307</h6>
      </div>
      <div class="card-body d-flex flex-column align-items-center justify-content-center">
        <% if @tax_submission.form_2307.attached? %>
          <span class="fw-semibold text-muted mb-2 text-truncate d-inline-block mw-100 text-center" title="<%= @tax_submission.form_2307.filename.to_s %>" data-bs-toggle="tooltip">
            <%= @tax_submission.form_2307.filename.to_s %>
          </span>
          <%= link_to url_for(@tax_submission.form_2307), target: "_blank", class: "d-block w-100 text-center" do %>
            <% if @tax_submission.form_2307.content_type == "application/pdf" %>
              <embed src="<%= url_for(@tax_submission.form_2307) %>"
                    type="application/pdf"
                    class="w-100 rounded border mb-2"
                    style="height: 450px;" />
            <% else %>
              <%= image_tag url_for(@tax_submission.form_2307),
                  class: "img-fluid rounded border shadow-sm",
                  style: "max-height: 450px; object-fit: contain;" %>
            <% end %>
          <% end %>
        <% else %>
          <p class="text-muted fst-italic">No attachment</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Deposit Slips -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-header bg-light border-0">
        <h6 class="fw-bold mb-0">Deposit Slip<%= 's' if @tax_submission.deposit_slip.count > 1 %></h6>
      </div>
      <div class="card-body">
        <% if @tax_submission.deposit_slip.attached? %>
          <% if @tax_submission.deposit_slip.count == 1 %>
            <% file = @tax_submission.deposit_slip.first %>
            <div class="text-center mb-2">
              <span class="fw-semibold text-muted text-truncate d-inline-block mw-100" title="<%= file.filename.to_s %>" data-bs-toggle="tooltip">
                <%= file.filename.to_s %>
              </span>
            </div>
            <%= link_to url_for(file), target: "_blank", class: "d-block text-center" do %>
              <% if file.content_type == "application/pdf" %>
                <embed src="<%= url_for(file) %>"
                      type="application/pdf"
                      class="w-100 rounded border mb-2"
                      style="height: 450px;" />
              <% else %>
                <%= image_tag url_for(file), class: "img-fluid rounded border shadow-sm", style: "max-height: 450px; object-fit: contain;" %>
              <% end %>
            <% end %>
          <% else %>
            <div class="row g-3">
              <% @tax_submission.deposit_slip.each do |file| %>
                <div class="col-6">
                  <div class="text-center mb-1">
                    <span class="fw-semibold text-muted text-truncate d-inline-block mw-100 small" title="<%= file.filename.to_s %>" data-bs-toggle="tooltip">
                      <%= file.filename.to_s %>
                    </span>
                  </div>
                  <%= link_to url_for(file), target: "_blank", class: "d-block text-center" do %>
                    <% if file.content_type == "application/pdf" %>
                      <embed src="<%= url_for(file) %>"
                            type="application/pdf"
                            class="w-100 rounded border mb-2"
                            style="height: 350px;" />
                    <% else %>
                      <%= image_tag url_for(file), class: "img-fluid rounded border shadow-sm", style: "max-height: 200px; object-fit: contain;" %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted fst-italic">No attachment</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
  