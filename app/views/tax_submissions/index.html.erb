<% 
  company_name = current_user.company&.name
  full_title_incoming = company_name.present? ? "#{company_name} Incoming Submissions" : "Incoming Submissions"
  display_company = company_name.present? ? truncate(company_name, length: 30) : nil
  display_title_incoming = display_company ? "#{display_company} Incoming Submissions" : "Incoming Submissions"
%>
<% content_for :page_title, full_title_incoming %>

<div class="tax-submissions-page container py-2 py-md-3">
  <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mb-3">
    <!-- Tab Navigation Container -->
    <div class="tabs-scroll-container">
      <ul class="custom_nav_tabs nav nav-tabs mb-0 border-0" id="submissionTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeSubmissions" type="button" role="tab" aria-controls="activeSubmissions" aria-selected="true">
            Active Submissions
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="archived-tab" data-bs-toggle="tab" data-bs-target="#archivedSubmissions" type="button" role="tab" aria-controls="archivedSubmissions" aria-selected="false">
            Archived Submissions
          </button>
        </li>
      </ul>
    </div>

    <!-- Back button on the right -->
    <div class="d-flex justify-content-end">
      <%= link_to root_path, class: "btn btn-back btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-2 flex-fill flex-sm-grow-0 text-nowrap" do %>
        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
      <% end %>
    </div>
  </div>

  <div class="tab-content" id="submissionTabsContent">
    <!-- Active Tab -->
    <div class="tab-pane fade show active" id="activeSubmissions" role="tabpanel" aria-labelledby="active-tab">
      <%= render partial: "submission_table_incoming", locals: { submissions: @unarchived_submissions, table_id: "taxSubmissionsTableActive", archived_table: false } %>
    </div>

    <!-- Archived Tab -->
    <div class="tab-pane fade" id="archivedSubmissions" role="tabpanel" aria-labelledby="archived-tab">
      <%= render partial: "submission_table_incoming", locals: { submissions: @archived_submissions, table_id: "taxSubmissionsTableArchived", archived_table: true } %>
    </div>
  </div>
</div>

<!-- View tax Modal -->
<div class="modal fade" id="submissionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">Submission Overview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="submissionModalBody">
        <div class="text-center p-5">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-3">Loading...</p>
        </div>
      </div>
    </div>
  </div>
</div>
