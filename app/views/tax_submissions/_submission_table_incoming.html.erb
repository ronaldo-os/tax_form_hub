<!-- Bulk Action Bar -->
<div class="card border-0 rounded-3 mb-2.5 d-none tax-submissions-bulk-bar shadow-sm" id="bulk_action_bar_<%= table_id %>">
  <div class="card-body py-2 px-3">
    <%= form_with url: bulk_action_tax_submissions_path, method: :post, class: "bulk-submissions-form", id: "bulk_form_#{table_id}" do |f| %>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2 gap-sm-3">
          <div class="form-check mb-0 d-flex align-items-center">
            <input class="form-check-input me-2 master-bulk-checkbox" type="checkbox" id="master_bulk_<%= table_id %>" data-table-id="<%= table_id %>">
            <label class="form-check-label fw-semibold fs-7 text-main" for="master_bulk_<%= table_id %>">
              Select All
            </label>
          </div>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fs-8 fw-semibold selected-count-badge">
            <span class="selected-count">0</span> selected
          </span>
        </div>

        <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end align-items-center">
          <% if archived_table %>
            <button type="submit" name="bulk_action" value="unarchive" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 bulk-action-btn" data-turbo-confirm="Are you sure you want to unarchive the selected submissions?">
              <i class="fa-solid fa-box-open"></i>
              <span>Unarchive</span>
            </button>
          <% else %>
            <button type="submit" name="bulk_action" value="archive" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 bulk-action-btn" data-turbo-confirm="Are you sure you want to archive the selected submissions?">
              <i class="fa-solid fa-box-archive"></i>
              <span>Archive</span>
            </button>
          <% end %>

          <button type="submit" name="bulk_action" value="destroy" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 bulk-action-btn" data-turbo-confirm="Are you sure you want to delete the selected submissions?">
            <i class="fa-solid fa-trash"></i>
            <span>Delete</span>
          </button>

          <button type="button" class="btn btn-sm btn-link text-muted p-1 text-decoration-none clear-selection-btn" data-table-id="<%= table_id %>" title="Clear selection">
            <i class="fa-solid fa-xmark fs-6"></i>
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
  <div class="card-body p-2.5">
    <table id="<%= table_id %>" class="table table-hover table_text_centered align-middle table-compact nowrap w-100">
      <thead class="table-light">
        <tr>
          <th class="text-center no-sort" style="width: 40px;" data-orderable="false">
            <div class="form-check d-flex justify-content-center mb-0">
              <input class="form-check-input table-header-checkbox" type="checkbox" id="header_checkbox_<%= table_id %>" data-table-id="<%= table_id %>" title="Select all on this page">
            </div>
          </th>
          <th>Transaction ID</th>
          <th>Email</th>
          <th>Company</th>
          <th>Invoice #</th>
          <th>Details</th>
          <th>Form 2307</th>
          <th>Deposit Slip</th>
          <th>Status</th>
          <th>Date Submitted</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% submissions.each do |submission| %>
          <%
            target_company = submission.invoice&.recipient_company || submission.invoice&.user&.company || submission.company
            company_name = target_company&.name.presence || submission.company_name.presence || "N/A"
            company_tin = target_company&.tax_id_number.presence || "N/A"
            inv = submission.invoice
            inv_subtotal = inv&.total.is_a?(Hash) ? inv.total["subtotal"].to_s : ""
            inv_tax = inv&.total.is_a?(Hash) ? inv.total["tax"].to_s : ""
            deposit_slip_names = submission.deposit_slip.attached? ? submission.deposit_slip.map { |f| f.filename.to_s }.join("; ") : ""
            status_text = tax_submission_status_text(submission)
          %>
          <tr data-transaction-id="<%= submission.company_submission_id || submission.user_transaction_id %>"
              data-email="<%= submission.email.presence || inv&.user&.email || 'N/A' %>"
              data-company-name="<%= company_name %>"
              data-company-tin="<%= company_tin %>"
              data-invoice-number="<%= inv&.invoice_number || 'N/A' %>"
              data-invoice-date="<%= inv&.issue_date&.strftime('%Y-%m-%d') || 'N/A' %>"
              data-currency="<%= inv&.currency || 'PHP' %>"
              data-subtotal="<%= inv_subtotal %>"
              data-tax-amount="<%= inv_tax %>"
              data-grand-total="<%= inv ? ('%.2f' % inv.grand_total) : '' %>"
              data-invoice-status="<%= inv&.status&.titleize || 'N/A' %>"
              data-status="<%= status_text %>"
              data-form-2307-attached="<%= submission.form_2307.attached? ? 'Yes' : 'No' %>"
              data-form-2307-filename="<%= submission.form_2307.attached? ? submission.form_2307.filename.to_s : '' %>"
              data-deposit-slip-attached="<%= submission.deposit_slip.attached? ? 'Yes' : 'No' %>"
              data-deposit-slip-count="<%= submission.deposit_slip.attached? ? submission.deposit_slip.count : 0 %>"
              data-deposit-slip-filenames="<%= deposit_slip_names %>"
              data-details="<%= submission.details.to_s %>"
              data-date-submitted="<%= submission.created_at.strftime('%Y-%m-%d %H:%M:%S') %>"
              data-archived="<%= archived_table ? 'Archived' : 'Active' %>">
            <td class="text-center">
              <div class="form-check d-flex justify-content-center mb-0">
                <input class="form-check-input submission-row-checkbox" type="checkbox" value="<%= submission.id %>" data-table-id="<%= table_id %>">
              </div>
            </td>
            <!-- ID -->
            <td>
              <%= link_to submission.company_submission_id,
    tax_submission_path(submission, format: :js),
    remote: true,
    data: { turbo: false, bs_toggle: "modal", bs_target: "#submissionModal" },
    class: "text-decoration-none" %>


            </td>

            <td><%= submission.email.presence || submission.invoice&.user&.email || "N/A" %></td>
            <td><%= submission.invoice&.recipient_company&.name || submission.invoice&.user&.company&.name || submission.company_name %></td>
            <td><%= submission.invoice&.invoice_number %></td>
            <td><%= truncate(submission.details, length: 50) %></td>

            <!-- Form 2307 -->
            <td>
              <% if submission.form_2307.attached? %>
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal" data-bs-target="#form2307Modal-<%= submission.id %>">
                  View Form 2307
                </button>

                <!-- Form 2307 Modal -->
                <div class="modal fade" id="form2307Modal-<%= submission.id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                      <div class="modal-header border-0">
                        <h5 class="modal-title">Form 2307</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="d-flex flex-column align-items-center text-center">
                          <span class="fw-semibold text-muted mb-2 text-truncate d-inline-block mw-100" title="<%= submission.form_2307.filename.to_s %>" data-bs-toggle="tooltip">
                            <%= submission.form_2307.filename.to_s %>
                          </span>
                          <% if submission.form_2307.content_type.start_with?("image/") %>
                            <%= link_to url_for(submission.form_2307), target: "_blank" do %>
                              <%= image_tag submission.form_2307, class: "img-fluid rounded border", alt: "Form 2307" %>
                            <% end %>
                          <% elsif submission.form_2307.content_type == "application/pdf" %>
                            <%= link_to url_for(submission.form_2307), target: "_blank", class: "w-100" do %>
                              <embed src="<%= url_for(submission.form_2307) %>" type="application/pdf" class="w-100 rounded border" style="height: 650px; min-height: 75vh;" />
                            <% end %>
                          <% else %>
                            <div class="border p-3 rounded w-100 mt-1">
                              <%= link_to "View PDF", rails_blob_path(submission.form_2307, disposition: "inline"),
                                    target: "_blank", class: "btn btn-sm btn-outline-secondary" %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% else %>
                <span class="text-muted">None</span>
              <% end %>
            </td>

            <!-- Deposit Slips -->
            <td>
              <% if submission.deposit_slip.attached? %>
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal" data-bs-target="#depositModal-<%= submission.id %>">
                  View Deposit Slips
                </button>

                <!-- Deposit Slips Modal -->
                <div class="modal fade" id="depositModal-<%= submission.id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                      <div class="modal-header border-0">
                        <h5 class="modal-title">Deposit Slips</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="row justify-content-center">
                          <% submission.deposit_slip.each do |file| %>
                            <div class="<%= submission.deposit_slip.count > 1 ? 'col-md-6' : 'col-12' %> mb-3 d-flex justify-content-center">
                              <div class="d-flex flex-column align-items-center text-center w-100">
                                <span class="fw-semibold text-muted mb-2 text-truncate d-inline-block mw-100" title="<%= file.filename.to_s %>" data-bs-toggle="tooltip">
                                  <%= file.filename.to_s %>
                                </span>
                                <% if file.content_type.start_with?("image/") %>
                                  <%= link_to url_for(file), target: "_blank" do %>
                                    <%= image_tag file, class: "img-fluid rounded border", alt: "Deposit Slip" %>
                                  <% end %>
                                <% elsif file.content_type == "application/pdf" %>
                                  <%= link_to url_for(file), target: "_blank", class: "w-100" do %>
                                    <embed src="<%= url_for(file) %>" type="application/pdf" class="w-100 rounded border" style="height: 600px; min-height: 70vh;" />
                                  <% end %>
                                <% else %>
                                  <div class="border p-3 rounded w-100 mt-1">
                                    <%= link_to "View PDF", rails_blob_path(file, disposition: "inline"),
                                          target: "_blank", class: "btn btn-sm btn-outline-secondary" %>
                                  </div>
                                <% end %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% else %>
                <span class="text-muted">None</span>
              <% end %>
            </td>

            <!-- Status -->
            <td>
              <% if submission.reviewed? && submission.processed? %>
                <span class="badge bg-success">Processed & Reviewed</span>
              <% elsif submission.reviewed? %>
                <span class="badge bg-info">Reviewed</span>
              <% elsif submission.processed? %>
                <span class="badge bg-warning text-dark">Processed</span>
              <% else %>
                <span class="badge bg-secondary">Pending</span>
              <% end %>
            </td>

            <td><%= submission.created_at.strftime("%B %d, %Y %I:%M %p") %></td>

            <!-- Actions Dropdown -->
            <td style="min-width: 150px; position: relative;">
              <div class="dropdown text-center">
                <button class="btn btn-link text-muted p-0 text-decoration-none fs-3" type="button" id="statusDropdown_<%= submission.id %>" data-bs-toggle="dropdown" aria-expanded="false">
                  &#8942;
                </button>
                <ul class="dropdown-menu text-center" aria-labelledby="statusDropdown_<%= submission.id %>">
                  <% unless archived_table %>
                    <li>
                      <%= form_with model: submission, url: tax_submission_path(submission), method: :patch, local: true do |f| %>
                        <%= f.hidden_field :reviewed, value: submission.reviewed? ? 0 : 1 %>
                        <%= f.submit submission.reviewed? ? "Unmark Reviewed" : "Mark as Reviewed", class: "border-none dropdown-item" %>
                      <% end %>
                    </li>
                    <li>
                      <%= form_with model: submission, url: tax_submission_path(submission), method: :patch, local: true do |f| %>
                        <%= f.hidden_field :processed, value: submission.processed? ? 0 : 1 %>
                        <%= f.submit submission.processed? ? "Unmark Processed" : "Mark as Processed", class: "border-none dropdown-item" %>
                      <% end %>
                    </li>
                    <li>
                      <%= form_with model: submission, url: tax_submission_path(submission), method: :patch, local: true do |f| %>
                        <%= f.hidden_field :archived, value: true %>
                        <%= f.submit "Archive", class: "dropdown-item border-none text-danger" %>
                      <% end %>
                    </li>
                  <% else %>
                    <li>
                      <%= form_with model: submission, url: tax_submission_path(submission), method: :patch, local: true do |f| %>
                        <%= f.hidden_field :archived, value: false %>
                        <%= f.submit "Unarchive", class: "dropdown-item border-none" %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
