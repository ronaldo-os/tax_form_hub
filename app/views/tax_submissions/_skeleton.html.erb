<!-- Tax Submissions Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="tax-submissions-skeleton" aria-hidden="true">
  <!-- Tabs & Action Bar Skeleton -->
  <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-2 mb-3">
    <!-- Tab Navigation Container -->
    <div class="tabs-scroll-container">
      <ul class="custom_nav_tabs nav nav-tabs mb-0 border-0">
        <li class="nav-item">
          <span class="nav-link active d-inline-flex align-items-center" style="pointer-events: none; padding: 0.5rem 1rem;">
            <div class="skeleton-pill mb-0" style="width: 120px; height: 16px;"></div>
          </span>
        </li>
        <li class="nav-item">
          <span class="nav-link d-inline-flex align-items-center" style="pointer-events: none; padding: 0.5rem 1rem;">
            <div class="skeleton-pill mb-0" style="width: 135px; height: 16px;"></div>
          </span>
        </li>
      </ul>
    </div>

    <!-- Action buttons aligned right -->
    <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end">
      <div class="skeleton-btn" style="width: 160px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
      <div class="skeleton-btn" style="width: 100px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
      <div class="skeleton-btn" style="width: 140px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
    </div>
  </div>

  <!-- Table Card Skeleton (1:1 with real table container) -->
  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-2.5">
      <!-- Custom Filter Bar Skeleton -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-1">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div class="skeleton-btn" style="width: 65px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
          <div class="skeleton-btn" style="width: 140px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
          <div class="skeleton-btn" style="width: 125px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
          <div class="skeleton-btn" style="width: 105px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
        </div>
        <div class="skeleton-btn" style="width: 210px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
      </div>

      <!-- Table Skeleton -->
      <div class="table-responsive">
        <table class="table table-hover table_text_centered align-middle table-compact nowrap skeleton-table w-100">
          <thead class="table-light">
            <tr>
              <th style="width: 40px;" class="text-center">
                <div class="skeleton-box mx-auto" style="width: 16px; height: 16px; border-radius: 4px;"></div>
              </th>
              <th style="width: 130px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 90px; height: 12px;"></div></th>
              <th><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px; height: 12px;"></div></th>
              <th style="width: 100px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 65px; height: 12px;"></div></th>
              <th><div class="skeleton-line skeleton-line-sm mb-0" style="width: 60px; height: 12px;"></div></th>
              <th style="width: 90px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 75px; height: 12px;"></div></th>
              <th style="width: 95px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 75px; height: 12px;"></div></th>
              <th style="width: 100px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 55px; height: 12px;"></div></th>
              <th style="width: 125px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 95px; height: 12px;"></div></th>
              <th style="width: 70px;" class="text-center"><div class="skeleton-line skeleton-line-sm mx-auto mb-0" style="width: 45px; height: 12px;"></div></th>
              <th style="width: 70px;" class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 45px; height: 12px;"></div></th>
            </tr>
          </thead>
          <tbody>
            <% 8.times do |i| %>
              <tr>
                <td class="text-center">
                  <div class="skeleton-box mx-auto" style="width: 16px; height: 16px; border-radius: 4px;"></div>
                </td>
                <td>
                  <div class="skeleton-pill mb-0" style="width: 105px; height: 20px;"></div>
                </td>
                <td>
                  <div class="skeleton-line skeleton-line-sm mb-0" style="width: <%= [65, 80, 50, 75, 90, 60, 85, 70][i] %>%; height: 12px;"></div>
                </td>
                <td>
                  <div class="skeleton-line skeleton-line-sm mb-0" style="width: 75px; height: 12px;"></div>
                </td>
                <td>
                  <div class="skeleton-line skeleton-line-sm mb-0" style="width: <%= [80, 55, 70, 90, 60, 75, 50, 65][i] %>%; height: 12px;"></div>
                </td>
                <td>
                  <div class="skeleton-pill mb-0" style="width: 65px; height: 22px;"></div>
                </td>
                <td>
                  <div class="skeleton-pill mb-0" style="width: 70px; height: 22px;"></div>
                </td>
                <td>
                  <div class="skeleton-pill mb-0" style="width: 75px; height: 22px;"></div>
                </td>
                <td>
                  <div class="skeleton-line skeleton-line-sm mb-0" style="width: 85px; height: 12px;"></div>
                </td>
                <td class="text-center">
                  <div class="skeleton-circle skeleton-circle-sm mx-auto" style="width: 28px; height: 28px;"></div>
                </td>
                <td class="text-end">
                  <div class="skeleton-btn ms-auto" style="width: 32px; height: 28px; border-radius: 0.375rem;"></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer Skeleton -->
      <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 mt-3 p-1 border-top pt-2" style="border-color: var(--skeleton-border) !important;">
        <div class="skeleton-line skeleton-line-xs mb-0" style="width: 190px; height: 12px;"></div>
        <div class="d-flex gap-1">
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 0.375rem;"></div>
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 0.375rem;"></div>
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 0.375rem;"></div>
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 0.375rem;"></div>
        </div>
      </div>
    </div>
  </div>
</div>
