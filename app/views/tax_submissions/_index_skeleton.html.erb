<!-- Tax Submissions Index Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="tax-submissions-index-skeleton" aria-hidden="true">
  <!-- Tabs & Action Bar -->
  <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-3 mb-3">
    <div class="tabs-scroll-container">
      <ul class="custom_nav_tabs nav nav-tabs mb-0 border-0">
        <li class="nav-item">
          <span class="nav-link active d-inline-flex align-items-center" style="pointer-events: none; padding: 0.5rem 1rem;">
            <div class="skeleton-pill mb-0" style="width: 130px; height: 16px;"></div>
          </span>
        </li>
        <li class="nav-item">
          <span class="nav-link d-inline-flex align-items-center" style="pointer-events: none; padding: 0.5rem 1rem;">
            <div class="skeleton-pill mb-0" style="width: 145px; height: 16px;"></div>
          </span>
        </li>
      </ul>
    </div>

    <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end">
      <div class="skeleton-btn-pill" style="width: 85px; height: 31px;"></div>
      <div class="skeleton-btn" style="width: 110px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
    </div>
  </div>

  <!-- Table Card Skeleton -->
  <div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-2.5">
      <!-- Filter Bar -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-1">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <div class="skeleton-btn" style="width: 65px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
          <div class="skeleton-btn" style="width: 140px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
          <div class="skeleton-btn" style="width: 120px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
        </div>
        <div class="skeleton-btn" style="width: 200px; height: 31px; border-radius: var(--form-field-radius, 0.5rem);"></div>
      </div>

      <!-- Table Skeleton -->
      <div class="table-responsive">
        <table class="table table-hover table_text_centered align-middle table-compact nowrap skeleton-table w-100">
          <thead class="table-light">
            <tr>
              <th style="width: 130px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 90px; height: 12px;"></div></th>
              <th><div class="skeleton-line skeleton-line-sm mb-0" style="width: 100px; height: 12px;"></div></th>
              <th style="width: 110px;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 70px; height: 12px;"></div></th>
              <th><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px; height: 12px;"></div></th>
              <th style="width: 95px;" class="text-center"><div class="skeleton-line skeleton-line-sm mx-auto mb-0" style="width: 55px; height: 12px;"></div></th>
              <th style="width: 110px;" class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 75px; height: 12px;"></div></th>
              <th style="width: 80px;" class="text-center"><div class="skeleton-line skeleton-line-sm mx-auto mb-0" style="width: 50px; height: 12px;"></div></th>
            </tr>
          </thead>
          <tbody>
            <% 6.times do |i| %>
              <tr>
                <td><div class="skeleton-pill mb-0" style="width: 95px; height: 20px;"></div></td>
                <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: <%= [70, 85, 60, 80, 65, 75][i] %>%; height: 12px;"></div></td>
                <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 75px; height: 12px;"></div></td>
                <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px; height: 12px;"></div></td>
                <td class="text-center"><div class="skeleton-pill mx-auto mb-0" style="width: 65px; height: 22px;"></div></td>
                <td class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 75px; height: 12px;"></div></td>
                <td class="text-center">
                  <div class="skeleton-circle mx-auto" style="width: 26px; height: 26px;"></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer Skeleton -->
      <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 mt-3 pt-2 border-top" style="border-color: var(--skeleton-border) !important;">
        <div class="skeleton-line skeleton-line-xs mb-0" style="width: 160px; height: 12px;"></div>
        <div class="d-flex gap-1">
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 4px;"></div>
          <div class="skeleton-btn" style="width: 32px; height: 28px; border-radius: 4px;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

