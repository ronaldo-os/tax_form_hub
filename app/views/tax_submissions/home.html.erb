<% 
  company_name = current_user.company&.name
  full_title = company_name.present? ? "#{company_name} Tax Submissions" : "Tax Submissions"
  display_company = company_name.present? ? truncate(company_name, length: 30) : nil
  display_title = display_company ? "#{display_company} Tax Submissions" : "Tax Submissions"
%>
<% content_for :page_title, full_title %>
<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "invoices", media: "all" %>
<% end %>

<div class="tax-submissions-page container-fluid px-2 px-sm-3 px-md-4 py-2.5 mt-3">
  <!-- Tax Submissions Skeleton Loader -->
  <div id="tax_submissions_skeleton" class="tax-submissions-skeleton-wrapper">
    <%= render "tax_submissions/skeleton" %>
  </div>

  <div id="tax_submissions_content" class="tax-submissions-content-wrapper" style="display: none;">
    <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-2 mb-3">
    <% is_archived_tab = (@active_tab || params[:tab].to_s.downcase) == "archived" %>
    <!-- Tab Navigation Container -->
    <div class="tabs-scroll-container">
      <ul class="custom_nav_tabs nav nav-tabs mb-0 border-0" id="submissionTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' unless is_archived_tab %>" id="unarchived-tab" data-bs-toggle="tab" data-bs-target="#unarchived" type="button" role="tab" aria-controls="unarchived" aria-selected="<%= !is_archived_tab %>">
            Active Submissions
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= 'active' if is_archived_tab %>" id="archived-tab" data-bs-toggle="tab" data-bs-target="#archived" type="button" role="tab" aria-controls="archived" aria-selected="<%= is_archived_tab %>">
            Archived Submissions
          </button>
        </li>
      </ul>
    </div>

    <!-- Action buttons aligned right / stacked/full-width on mobile -->
    <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end">
      <% if current_user.company_id.present? %>
        <%= link_to tax_submissions_path, class: "btn btn-outline-primary btn-sm flex-fill flex-sm-grow-0 text-nowrap d-inline-flex align-items-center justify-content-center gap-2" do %>
          <i class="fa-solid fa-inbox me-1.5"></i>
          <span>Incoming Submissions</span>
        <% end %>
      <% end %>
      <button type="button" class="btn btn-outline-secondary btn-sm flex-fill flex-sm-grow-0 text-nowrap d-inline-flex align-items-center justify-content-center" id="exportTaxSubmissionsBtn" title="Export currently filtered records to CSV">
        <i class="fa-solid fa-file-csv text-success fs-8"></i>
        <span>Export CSV</span>
      </button>
      <button class="btn btn-primary btn-sm flex-fill flex-sm-grow-0 text-nowrap d-inline-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#submitDocsModal">
        <i class="fa-solid fa-plus"></i>
        <span>Submit Documents</span>
      </button>
    </div>
  </div>

  <div class="tab-content">
    <div class="tab-pane fade <%= 'show active' unless is_archived_tab %>" id="unarchived">
      <%= render partial: 'submission_table', locals: { submissions: @unarchived_submissions, archived_table: false } %>
    </div>
    <div class="tab-pane fade <%= 'show active' if is_archived_tab %>" id="archived">
      <%= render partial: 'submission_table', locals: { submissions: @archived_submissions, archived_table: true } %>
    </div>
  </div>
  </div> <!-- /#tax_submissions_content -->

  <noscript>
    <style>
      #tax_submissions_skeleton { display: none !important; }
      #tax_submissions_content { display: block !important; }
    </style>
  </noscript>
</div>

<!-- Submit Documents Modal -->
<div class="modal fade" id="submitDocsModal" tabindex="-1" aria-labelledby="submitDocsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow-md border-0 rounded-4">
      
      <div class="modal-header border-0">
        <h4 class="modal-title fw-bold" id="submitDocsModalLabel">Submit Tax Documents</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 pt-0">
        <%= form_with model: @tax_submission, url: tax_submissions_path, local: true, html: { multipart: true } do |f| %>
          <%
            clean_redirect_path = begin
              uri = URI.parse(request.fullpath)
              params_hash = Rack::Utils.parse_nested_query(uri.query)
              params_hash.delete("open_modal")
              params_hash.delete("open_submit_modal")
              params_hash.delete("invoice_id")
              params_hash.delete("company_id")
              new_query = params_hash.to_query
              new_query.present? ? "#{uri.path}?#{new_query}" : uri.path
            rescue StandardError
              tax_submissions_home_path
            end
          %>
          <%= hidden_field_tag :redirect_url, clean_redirect_path, id: "tax_submission_redirect_url" %>
          <% if @tax_submission.errors.any? %>
            <div class="alert alert-danger py-2 small mb-3">
              <ul class="mb-0">
                <% @tax_submission.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
            <input type="hidden" id="has_submission_errors" value="true">
          <% end %>
          <div class="row g-3">

            <div class="col-12">
              <%= f.label :company_id, "Company Name", class: "form-label fw-semibold small text-muted" %>
              <% if @companies.any? %>
                <%= f.collection_select :company_id, @companies, :id, :name, { prompt: "Select Company" }, { class: "form-select rounded-3", id: "company_select", required: true } %>
              <% else %>
                <div class="alert alert-warning">
                  <p class="mb-0 small">You don't have any approved invoices yet. Reach out to your company to <b>get an invoice approved</b> before you can submit your tax documents.</p>
                </div>
                <%= f.select :company_id, [], { disabled: true, prompt: "No companies available" }, { class: "form-select rounded-3", id: "company_select" } %>
              <% end %>
            </div>

            <div class="col-12">
              <%= f.label :invoice_id, "Invoice Number", class: "form-label fw-semibold small text-muted" %>
              <%= f.select :invoice_id, [], { prompt: "Select Invoice" }, { class: "form-select rounded-3", id: "invoice_select", required: true } %>
              <small class="form-text text-muted">Please select a company first to load available invoices.</small>
            </div>

            <% if @tax_submission.invoice_id.present? && @tax_submission.company_id.present? %>
              <input type="hidden" id="prefill_invoice_id" value="<%= @tax_submission.invoice_id %>">
              <input type="hidden" id="prefill_company_id" value="<%= @tax_submission.company_id %>">
            <% end %>
            <% if params[:open_modal] == "true" %>
              <input type="hidden" id="open_submit_modal" value="true">
            <% end %>

            <div class="col-12">
              <%= f.label :form_2307, "Form 2307", class: "form-label fw-semibold small text-muted" %>
              <div class="file-dropzone tax-file-dropzone" data-target-input="#form_2307_input" role="button" tabindex="0" aria-label="Upload Form 2307">
                <%= f.file_field :form_2307,
                      class: "file-upload-input",
                      required: true,
                      accept: "image/*,application/pdf",
                      id: "form_2307_input",
                      tabindex: -1,
                      data: { list_target: "#form_2307_list", multiple: false } %>
                <div class="dropzone-content text-center py-3 px-2">
                  <div class="dropzone-icon mb-2">
                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary"></i>
                  </div>
                  <div class="dropzone-default-text">
                    <div class="dropzone-text mb-1">
                      <span class="fw-semibold text-body">Drag &amp; drop Form 2307 here</span>, or <span class="text-primary text-decoration-underline browse-link">browse</span>
                    </div>
                    <div class="dropzone-hint text-muted small">
                      Supports JPG, PNG, and PDF (Single file)
                    </div>
                  </div>
                </div>
              </div>
              <ul id="form_2307_list" class="list-group mt-2"></ul>
            </div>

            <div class="col-12">
              <%= f.label :deposit_slip, "Deposit Slip or Bank Transfer Details", class: "form-label fw-semibold small text-muted" %>
              <div class="file-dropzone tax-file-dropzone" data-target-input="#deposit_slip_input" role="button" tabindex="0" aria-label="Upload Deposit Slip or Bank Transfer Details">
                <%= f.file_field :deposit_slip,
                      multiple: true,
                      class: "file-upload-input",
                      required: true,
                      accept: "image/*,application/pdf",
                      id: "deposit_slip_input",
                      tabindex: -1,
                      data: { list_target: "#deposit_slip_list", multiple: true } %>
                <div class="dropzone-content text-center py-3 px-2">
                  <div class="dropzone-icon mb-2">
                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary"></i>
                  </div>
                  <div class="dropzone-default-text">
                    <div class="dropzone-text mb-1">
                      <span class="fw-semibold text-body">Drag &amp; drop deposit slips or bank transfers here</span>, or <span class="text-primary text-decoration-underline browse-link">browse</span>
                    </div>
                    <div class="dropzone-hint text-muted small">
                      Upload one or more images (JPG, PNG) or PDFs
                    </div>
                  </div>
                </div>
              </div>
              <ul id="deposit_slip_list" class="list-group mt-2"></ul>
            </div>

            <div class="col-12">
              <%= f.label :details, "Additional Notes", class: "form-label fw-semibold small text-muted" %>
              <%= f.text_area :details, class: "form-control rounded-3", rows: 4 %>
            </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-back px-4" data-bs-dismiss="modal">Cancel</button>
            <%= f.submit "Submit", class: "btn btn-primary px-4" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "tax_submissions/shared/modal" %>