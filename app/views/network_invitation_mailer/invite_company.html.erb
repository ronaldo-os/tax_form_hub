<%
  ttl = @expires_in.presence || NetworkInvitationMailer::INVITE_TOKEN_TTL
  valid_for = email_duration_label(ttl)
  expires_at = @expires_at.presence || (Time.current + ttl.to_i)
  expires_at_label = email_expiration_timestamp(expires_at)

  subtitle = if @company_name.present?
    "#{@inviter_company_name} invited #{@company_name} to connect on Tax Form Hub for streamlined invoicing and Form 2307 submissions. You have #{valid_for} to accept this invitation."
  else
    "#{@inviter_company_name} invited you to connect on Tax Form Hub for streamlined invoicing and Form 2307 submissions. You have #{valid_for} to accept this invitation."
  end

  details_rows = [{ label: "Invited By", value: @inviter_company_name, emphasize: true }]
  details_rows << { label: "Company", value: @company_name } if @company_name.present?
  details_rows << { label: "Invitation Valid For", value: valid_for, emphasize: true }
  details_rows << { label: "Expires At", value: expires_at_label }
%>
<% content_for :email_title, "You’re Invited to Tax Form Hub" %>
<% content_for :email_category, "Network Invitation" %>
<% content_for :email_accent, "primary" %>
<% content_for :email_preheader, "#{@inviter_company_name} invited you to connect on Tax Form Hub. This invite expires in #{valid_for}." %>
<% content_for :email_footer_note, "Once you register using this link, your company will automatically connect with #{@inviter_company_name}. This invitation expires in #{valid_for} (#{expires_at_label}). If you didn’t expect this invitation, you can safely ignore this email." %>

<%= render "shared/mailer/header",
      title: "You’re invited to Tax Form Hub",
      subtitle: subtitle %>

<%= render "shared/mailer/details_table", rows: details_rows %>

<% if @personal_message.present? %>
  <%= render "shared/mailer/callout",
        title: "Personal Note from #{@inviter_company_name}",
        body: @personal_message,
        tone: :info %>
<% end %>

<%= render "shared/mailer/button",
      label: "Create Account & Connect",
      url: @signup_url,
      tone: :primary,
      show_fallback_url: true %>

<div style="margin-top:24px;">
  <%= render "shared/mailer/callout",
        title: "Invitation Expiration",
        body: "This invitation link is valid for #{valid_for} and expires on #{expires_at_label}. If it expires before you sign up, ask #{@inviter_company_name} to send you a new invitation.",
        tone: :warning %>
</div>
