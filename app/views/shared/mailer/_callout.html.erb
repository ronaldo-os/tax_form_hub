<%# locals: (title: nil, body:, tone: :neutral, monospace: false) %>
<% palette = email_callout_palette(tone) %>
<% font_family = monospace ? "ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace" : "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif" %>
<% paragraphs = body.to_s.strip.split(/\r?\n\s*\r?\n/) %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= palette[:bg] %>;border:1px solid <%= palette[:border] %>;border-left:4px solid <%= palette[:accent] %>;border-radius:8px;margin-bottom:24px;">
  <tr>
    <td style="padding:14px 18px;">
      <% if title.present? %>
        <p style="margin:0 0 6px 0;font-size:11px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:<%= palette[:title] %>;">
          <%= title %>
        </p>
      <% end %>
      <% paragraphs.each_with_index do |paragraph, idx| %>
        <% margin_bottom = idx < paragraphs.length - 1 ? "8px" : "0" %>
        <p style="margin:0 0 <%= margin_bottom %> 0;font-size:13px;line-height:20px;color:<%= palette[:text] %>;word-break:break-word;font-family:<%= font_family %>;">
          <% lines = paragraph.split(/\r?\n/) %>
          <% lines.each_with_index do |line, line_idx| %><%= line %><% if line_idx < lines.length - 1 %><br><% end %><% end %>
        </p>
      <% end %>
    </td>
  </tr>
</table>
