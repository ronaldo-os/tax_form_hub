<% is_purchase = local_assigns.fetch(:is_purchase, false) %>
<% table_id = local_assigns[:table_id] || (is_purchase ? "purchasesPriceAdjustmentsTable" : "salesPriceAdjustmentsTable") %>
<% can_bulk_cancel = local_assigns.fetch(:can_bulk_cancel, false) %>
<% 
  normalized_items = []
  subscriptions.each do |record|
    if record.respond_to?(:adjustment)
      normalized_items << record
    elsif record.respond_to?(:price_adjustments) && record.price_adjustments.is_a?(Array)
      record.price_adjustments.each_with_index do |adj, idx|
        next unless adj.is_a?(Hash)
        freq = adj['frequency'] || adj[:frequency] || (adj['unit'] == 'monthly_charge' || adj[:unit] == 'monthly_charge' ? 'monthly' : nil)
        if %w[monthly annually yearly].include?(freq.to_s)
          normalized_items << PriceAdjustmentItemWrapper.new(record, adj, idx)
        end
      end
    else
      normalized_items << record
    end
  end
%>

<% if can_bulk_cancel %>
  <!-- Bulk Action Bar -->
  <div class="card border-0 rounded-3 mb-3 d-none subscriptions-bulk-bar shadow-sm" id="bulk_action_bar_<%= table_id %>">
    <div class="card-body py-2 px-3">
      <%= form_with url: bulk_action_subscriptions_path, method: :post, class: "bulk-subscriptions-form", id: "bulk_form_#{table_id}" do |f| %>
        <%= hidden_field_tag :tab, is_purchase ? "purchases" : "sales" %>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-2 gap-sm-3">
            <div class="form-check mb-0 d-flex align-items-center">
              <input class="form-check-input me-2 master-bulk-checkbox subscription-master-checkbox" type="checkbox" id="master_bulk_<%= table_id %>" data-table-id="<%= table_id %>">
              <label class="form-check-label fw-semibold fs-7 text-main" for="master_bulk_<%= table_id %>">
                Select All
              </label>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fs-8 fw-semibold selected-count-badge">
              <span class="selected-count">0</span> selected
            </span>
          </div>

          <div class="d-flex gap-2 flex-wrap flex-sm-nowrap justify-content-end align-items-center">
            <button type="button" name="bulk_action" value="cancel" class="btn btn-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 bulk-action-btn" data-bs-toggle="modal" data-bs-target="#cancelSubscriptionModal-bulk-<%= table_id %>">
              <i class="fa-solid fa-ban"></i>
              <span>Cancel Price Adjustment</span>
            </button>

            <button type="button" class="btn btn-sm btn-link text-muted p-1 text-decoration-none clear-selection-btn" data-table-id="<%= table_id %>" title="Clear selection">
              <i class="fa-solid fa-xmark fs-6"></i>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "bulk_cancel_subscription_modal", table_id: table_id, is_purchase: is_purchase, item_type: "Price Adjustment" %>
<% end %>

<div class="table-responsive overflow-visible">
    <table class="table table-hover table-compact invoice-datatable align-middle mb-0 subscription-table w-100" id="<%= table_id %>">
      <thead class="table-light">
        <tr>
          <% if can_bulk_cancel %>
            <th class="text-center no-sort" style="width: 40px;" data-orderable="false">
              <div class="form-check d-flex justify-content-center mb-0">
                <input class="form-check-input table-header-checkbox" type="checkbox" id="header_checkbox_<%= table_id %>" data-table-id="<%= table_id %>" title="Select all on this page">
              </div>
            </th>
          <% end %>
          <th class="<%= 'ps-4' unless can_bulk_cancel %>"><%= is_purchase ? "Supplier" : "Recipient" %></th>
          <th>Description</th>
          <th>Type</th>
          <th>Billing Cycle</th>
          <th>Status</th>
          <th>Next Invoice</th>
          <th class="text-end">Adjustment Amount</th>
          <th class="pe-4 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% normalized_items.each do |item| %>
          <% 
            if item.respond_to?(:adjustment)
              invoice = item.invoice
              adj = item.adjustment
              item_index = item.index
              is_active = item.subscription_active?
              is_cancelled = item.subscription_cancelled?
              is_finished = item.subscription_finished?
            else
              invoice = item
              adj = invoice.recurring_price_adjustments.first || {}
              item_index = 0
              is_active = invoice.subscription_active?
              is_cancelled = invoice.subscription_cancelled?
              is_finished = invoice.subscription_finished?
            end
            cycle = case adj['frequency']
                    when 'annually', 'yearly' then 'annual'
                    else 'monthly'
                    end
            start_date = adj['charge_start_date']
            description = adj['description_edit'].presence || adj['description'].presence || "Price Adjustment"
            type_label = (adj['type'] || adj['unit'] || 'Adjustment').capitalize
            
            amount_val = adj['amount'].to_f
            unit_val = adj['unit'] == '%' ? '%' : ((invoice.currency.presence || 'PHP') + ' ')
            amount_display = adj['unit'] == '%' ? "#{amount_val}%" : number_to_currency(amount_val, unit: unit_val)
            counterparty_name = is_purchase ? (invoice.sale_from&.name || "Unknown Supplier") : (invoice.recipient_company&.name || "Unknown Company")
          %>
          <tr data-subscription-id="<%= invoice.id %>" data-item-index="<%= item_index %>">
            <% if can_bulk_cancel %>
              <td class="text-center">
                <div class="form-check d-flex justify-content-center mb-0">
                  <input class="form-check-input subscription-row-checkbox"
                         type="checkbox"
                         name="subscription_ids[]"
                         value="<%= invoice.id %>"
                         data-table-id="<%= table_id %>"
                         data-item-index="<%= item_index %>"
                         data-allowed-actions="<%= allowed_subscription_bulk_actions(item).join(',') %>"
                         title="Select <%= description %>">
                </div>
              </td>
            <% end %>
            <td class="<%= 'ps-4' unless can_bulk_cancel %> fw-medium">
              <%= link_to counterparty_name, price_adjustment_path(invoice, item_index: item_index), class: "text-decoration-none" %>
            </td>
            <td>
              <span class="text-truncate d-inline-block" style="max-width: 200px;">
                <%= description %>
              </span>
            </td>
            <td>
              <span class="badge bg-info text-dark">
                <%= type_label %>
              </span>
            </td>
            <td>
              <span class="badge bg-secondary">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                <%= cycle.capitalize %>
              </span>
            </td>
            <td>
              <% if is_active %>
                <span class="badge bg-success">Active</span>
              <% elsif is_cancelled %>
                <span class="badge bg-danger">Cancelled</span>
              <% else %>
                <span class="badge bg-secondary">Finished</span>
              <% end %>
            </td>
            <td>
              <% if is_active && start_date.present? %>
                <% 
                  start_d = Date.parse(start_date) rescue nil
                  if start_d
                    current_sequence = invoice.recurring_sub_invoices.size + 1
                    next_date = start_d
                    current_sequence.times { next_date = invoice.calculate_next_period_date(next_date, cycle) }
                    
                    days_left = (next_date - Date.current).to_i
                    text_class = days_left <= 7 ? "text-danger fw-bold" : "text-muted"
                %>
                <div class="<%= text_class %>">
                  <%= next_date.strftime("%b %d, %Y") %>
                  <small class="d-block">
                    <% if days_left < 0 %>
                      Overdue by <%= days_left.abs %> days
                    <% elsif days_left == 0 %>
                      Today
                    <% else %>
                      In <%= days_left %> days
                    <% end %>
                  </small>
                </div>
                <% end %>
              <% else %>
                <span class="text-muted">-</span>
              <% end %>
            </td>
            <td class="text-end fw-semibold">
              <%= amount_display %>
            </td>
            <td class="pe-4 text-end">
              <div class="dropdown text-center">
                <button class="btn btn-sm btn-action-dropdown text-muted" type="button" id="actionsDropdown_<%= invoice.id %>_<%= item_index %>" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="actionsDropdown_<%= invoice.id %>_<%= item_index %>">
                  <li>
                    <%= link_to "View Details", price_adjustment_path(invoice, item_index: item_index), class: "dropdown-item" %>
                  </li>
                  <% if is_active %>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelSubscriptionModal-<%= invoice.id %>-<%= item_index %>">
                        Cancel Price Adjustment
                      </button>
                    </li>
                  <% end %>
                  <% if is_cancelled %>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelledDetailsModal-<%= invoice.id %>-<%= item_index %>">
                        View Cancellation Details
                      </button>
                    </li>
                  <% end %>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% normalized_items.each do |item| %>
    <% 
      if item.respond_to?(:adjustment)
        invoice = item.invoice
        item_index = item.index
        is_active = item.subscription_active?
        is_cancelled = item.subscription_cancelled?
      else
        invoice = item
        item_index = 0
        is_active = invoice.subscription_active?
        is_cancelled = invoice.subscription_cancelled?
      end
    %>
    <% if is_active %>
      <%= render "cancel_subscription_modal", subscription: invoice, item_type: "Price Adjustment", item_index: item_index %>
    <% end %>
    <% if is_cancelled %>
      <% 
        c_item = invoice.cancellation_line_item || {
          'description' => 'Subscription Cancelled',
          'optional_fields' => {
            'effective_date' => (invoice.updated_at || Date.current).to_date.to_s,
            'billing_option' => 'none'
          }
        }
        cancel_item = {
          index: "#{invoice.id}-#{item_index}",
          is_cancellation: true,
          item: c_item,
          description: c_item['description']
        }
      %>
      <%= render "cancelled_details_modal", item: cancel_item %>
    <% end %>
  <% end %>
