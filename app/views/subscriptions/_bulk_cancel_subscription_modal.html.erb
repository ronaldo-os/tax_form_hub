<% item_type = local_assigns[:item_type] || "Subscription" %>
<% lower_item_type = item_type.downcase %>
<% is_purchase = local_assigns.fetch(:is_purchase, false) %>
<% table_id = local_assigns[:table_id] %>
<% modal_id = "cancelSubscriptionModal-bulk-#{table_id}" %>

<div class="modal fade bulk-cancel-subscription-modal"
     id="<%= modal_id %>"
     tabindex="-1"
     aria-labelledby="<%= modal_id %>Label"
     aria-hidden="true"
     data-table-id="<%= table_id %>"
     data-item-type="<%= item_type %>"
     data-item-type-plural="<%= item_type.pluralize %>">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="<%= modal_id %>Label">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Cancel <span class="bulk-cancel-title-type"><%= item_type.pluralize %></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: bulk_action_subscriptions_path, method: :post, id: "bulk_cancel_form_#{table_id}", class: "bulk-cancel-modal-form" do |f| %>
        <%= hidden_field_tag :bulk_action, "cancel" %>
        <%= hidden_field_tag :tab, is_purchase ? "purchases" : "sales" %>
        <%= hidden_field_tag :item_type, item_type %>
        <%= hidden_field_tag :table_id, table_id %>

        <div class="modal-body pt-3">
          <p class="text-muted mb-4">
            Are you sure you want to cancel the selected <span class="bulk-cancel-count fw-semibold"></span> <span class="bulk-cancel-body-type"><%= lower_item_type.pluralize %></span>? <span class="bulk-cancel-body-type-target">The <%= lower_item_type.pluralize %></span> will be marked as finished and no future regular invoices will be generated.
          </p>

          <div class="mb-4">
            <label for="bulkEffectiveDate-<%= table_id %>" class="form-label fw-semibold">Effective Cancellation Date</label>
            <%= f.date_field :effective_date, class: "form-control", id: "bulkEffectiveDate-#{table_id}", value: Date.current, required: true %>
            <div class="form-text text-muted">This date will be recorded as the cancellation date.</div>
          </div>
          
          <div class="mb-4">
            <label class="form-label fw-semibold mb-3">Final Invoice Billing Option</label>
            
            <div class="form-check mb-3">
              <%= f.radio_button :billing_option, "none", class: "form-check-input", id: "bulkBillingNone-#{table_id}", checked: true %>
              <label class="form-check-label" for="bulkBillingNone-<%= table_id %>">
                <span class="d-block fw-medium">No Final Invoice</span>
                <span class="d-block text-muted small">Cancel immediately without generating any additional invoices.</span>
              </label>
            </div>
            
            <div class="form-check mb-3">
              <%= f.radio_button :billing_option, "prorate", class: "form-check-input", id: "bulkBillingProrate-#{table_id}" %>
              <label class="form-check-label" for="bulkBillingProrate-<%= table_id %>">
                <span class="d-block fw-medium">Prorated Amount</span>
                <span class="d-block text-muted small">Generate a final invoice prorated based on the remaining days in the current cycle.</span>
              </label>
            </div>
            
            <div class="form-check mb-2">
              <%= f.radio_button :billing_option, "full", class: "form-check-input", id: "bulkBillingFull-#{table_id}" %>
              <label class="form-check-label" for="bulkBillingFull-<%= table_id %>">
                <span class="d-block fw-medium">Full Amount</span>
                <span class="d-block text-muted small">Generate a final invoice for the full regular billing cycle amount.</span>
              </label>
            </div>
          </div>
          
          <div class="mb-3">
            <label for="bulkCancellationReason-<%= table_id %>" class="form-label fw-semibold">Reason / Note (Optional)</label>
            <%= f.text_area :reason, class: "form-control", id: "bulkCancellationReason-#{table_id}", rows: 2, placeholder: "e.g. Customer requested cancellation" %>
          </div>
        </div>

        <div class="modal-footer bg-light border-top-0 rounded-bottom">
          <button type="button" class="btn btn-outline-secondary bulk-cancel-keep-btn" data-bs-dismiss="modal">Keep <%= item_type.pluralize %></button>
          <%= f.button type: "submit", name: "bulk_action", value: "cancel", class: "btn btn-danger bulk-cancel-submit-btn" do %>
            Cancel <span class="bulk-cancel-submit-label"><%= item_type.pluralize %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
