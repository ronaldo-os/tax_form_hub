<!-- Subscription Show Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="subscription-show-skeleton" aria-hidden="true">
  <!-- Back Button Skeleton -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="skeleton-btn-pill" style="width: 95px; height: 34px;"></div>
  </div>

  <div class="row">
    <!-- Main Column (8 cols) -->
    <div class="col-lg-8">
      <!-- Overview Card Skeleton -->
      <div class="card shadow-sm border-0 rounded-4 mb-4" style="background: var(--skeleton-card-bg);">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-2 px-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
              <div class="skeleton-line skeleton-title mb-1.5" style="width: 200px; height: 22px;"></div>
              <div class="skeleton-line skeleton-line-xs mb-0" style="width: 140px; height: 12px;"></div>
            </div>
            <div class="skeleton-pill mb-0" style="width: 95px; height: 28px;"></div>
          </div>
        </div>

        <div class="card-body px-4 pb-4 pt-3">
          <!-- Stat Tiles Row -->
          <div class="row g-3 mb-4">
            <% 3.times do %>
              <div class="col-6 col-md-4">
                <div class="p-3 rounded-3" style="background: var(--skeleton-card-bg); border: 1px solid var(--skeleton-border);">
                  <div class="skeleton-line skeleton-line-xs mb-2" style="width: 55px; height: 10px;"></div>
                  <div class="skeleton-value mb-0" style="width: 90px; height: 24px;"></div>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Description Box -->
          <div class="p-3 rounded-3" style="background: var(--skeleton-card-bg); border: 1px solid var(--skeleton-border);">
            <div class="skeleton-line skeleton-line-xs mb-2" style="width: 80px; height: 10px;"></div>
            <div class="skeleton-line skeleton-line-sm mb-1" style="width: 90%;"></div>
            <div class="skeleton-line skeleton-line-sm mb-0" style="width: 60%;"></div>
          </div>
        </div>
      </div>

      <!-- Generated Invoices Table Card Skeleton -->
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-2 px-4">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 170px; height: 18px;"></div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle skeleton-table mb-0 w-100">
              <thead class="table-light">
                <tr>
                  <th class="ps-4" style="width: 25%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 75px;"></div></th>
                  <th style="width: 25%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px;"></div></th>
                  <th style="width: 20%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 60px;"></div></th>
                  <th class="text-end" style="width: 15%;"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 65px;"></div></th>
                  <th class="pe-4 text-end" style="width: 15%;"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 45px;"></div></th>
                </tr>
              </thead>
              <tbody>
                <% 3.times do %>
                  <tr>
                    <td class="ps-4"><div class="skeleton-pill mb-0" style="width: 90px; height: 20px;"></div></td>
                    <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 85px;"></div></td>
                    <td><div class="skeleton-pill mb-0" style="width: 60px; height: 20px;"></div></td>
                    <td class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 70px;"></div></td>
                    <td class="pe-4 text-end"><div class="skeleton-btn ms-auto" style="width: 55px; height: 26px; border-radius: 4px;"></div></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Contract Details Sidebar (4 cols) -->
    <div class="col-lg-4">
      <div class="card shadow-sm border-0 rounded-4" style="background: var(--skeleton-card-bg);">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-2 px-4">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 130px; height: 18px;"></div>
        </div>
        <div class="card-body px-4 pb-4 pt-2">
          <% 4.times do %>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="skeleton-line skeleton-line-xs mb-0" style="width: 40%;"></div>
              <div class="skeleton-line skeleton-line-sm mb-0" style="width: 45%;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

