<%
  reset_link = edit_password_url(@resource, reset_password_token: @token)
  ttl = Devise.reset_password_within || 1.hour
  valid_for = email_duration_label(ttl)
  expires_at = (@resource.reset_password_sent_at || Time.current) + ttl
  expires_at_label = email_expiration_timestamp(expires_at)
%>
<% content_for :email_title, "Reset Your Password" %>
<% content_for :email_category, "Account Security" %>
<% content_for :email_accent, "primary" %>
<% content_for :email_preheader, "Reset your Tax Form Hub password. This link expires in #{valid_for}." %>
<% content_for :email_footer_note, "This password reset link expires in #{valid_for}. If you didn’t request a reset, you can safely ignore this email—your password will remain unchanged." %>

<%= render "shared/mailer/header",
      title: "Reset your password",
      subtitle: "We received a request to reset the password for your Tax Form Hub account. You have #{valid_for} to complete this reset using the button below." %>

<%= render "shared/mailer/details_table", rows: [
      { label: "Account Email", value: @resource.email, emphasize: true },
      { label: "Link Valid For", value: valid_for, emphasize: true },
      { label: "Expires At", value: expires_at_label }
    ] %>

<%= render "shared/mailer/button",
      label: "Reset Password",
      url: reset_link,
      tone: :primary,
      show_fallback_url: true %>

<div style="margin-top:24px;">
  <%= render "shared/mailer/callout",
        title: "Expiration & Security Notice",
        body: "For your security, this link will expire in #{valid_for} (#{expires_at_label}). If it expires before you use it, you can request a new reset link from the sign-in page.\n\nIf you didn’t request this reset, no action is needed—your password will not change.",
        tone: :warning %>
</div>
