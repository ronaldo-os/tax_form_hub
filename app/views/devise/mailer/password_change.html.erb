<% content_for :email_title, "Password Changed" %>
<% content_for :email_category, "Account Security" %>
<% content_for :email_accent, "success" %>
<% content_for :email_preheader, "Your Tax Form Hub account password has been successfully updated." %>
<% content_for :email_footer_note, "This is a security notification sent whenever your Tax Form Hub password is changed." %>

<%= render "shared/mailer/header",
      title: "Your password has been changed",
      subtitle: "This is a confirmation that the password for your Tax Form Hub account was recently updated.",
      status_label: "Confirmed",
      status_tone: :success %>

<%= render "shared/mailer/details_table", rows: [
      { label: "Account Email", value: @resource.email, emphasize: true },
      { label: "Updated On", value: Time.current.strftime("%b %d, %Y") }
    ] %>

<%= render "shared/mailer/callout",
      title: "Didn’t change your password?",
      body: "If you didn’t make this change, reset your password right away to protect your account.",
      tone: :warning %>

<%= render "shared/mailer/button",
      label: "Sign In to Tax Form Hub",
      url: root_url,
      tone: :primary %>
