<!DOCTYPE html>
<html data-theme="<%= current_user&.theme || 'light' %>" data-bs-theme="<%= current_user&.theme || 'light' %>">
  <head>
    <meta name="user-theme" content="<%= current_user&.theme || 'light' %>">
    <title><%= content_for(:title) || "Tax Form Hub" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <%= render "layouts/cdns" %>

    <!-- Critical CSS inlined for fast first paint -->
    <style>
      <%= raw File.read(Rails.root.join('app/assets/builds/critical.css')) if File.exist?(Rails.root.join('app/assets/builds/critical.css')) %>
    </style>

    <!-- Stylesheets -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= yield :stylesheets %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
    <%= yield :javascripts %>
  </head>
  <body data-devise="<%= devise_controller? %>" class="bg-light">


  <% unless devise_controller? && !(controller_name == "registrations" && (action_name == "edit" || action_name == "update")) %>
    <div class="app-menu-toggle" id="desktop_menu_toggle">
      <i class="fa-solid fa-chevron-right"></i>
    </div>
    
    <div class="app-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3 overflow-hidden">
        <div class="mobile-app-menu-toggle flex-shrink-0" id="mobile_menu_toggle" role="button" aria-label="Toggle navigation">
          <i class="fa-solid fa-bars"></i>
        </div>
        <h1 class="mobile-page-title mb-0 fs-5 text-truncate fw-bold">
          <%= content_for(:page_title) || content_for(:title) || "Tax Form Hub" %>
        </h1>
      </div>
    </div>

    <div class="app-sidebar">
      <div class="mobile-sidebar-header position-relative d-flex align-items-center justify-content-center px-3 py-3 border-bottom">
        <%= link_to root_path, class: "d-flex align-items-center justify-content-center text-decoration-none" do %>
          <div class="app-icon text-primary fs-3">
            <i class="fa-solid fa-cloud-arrow-up fa-fw"></i>
          </div>
          <div class="app-text text-primary ms-2 fs-5 fw-bold text-uppercase">Tax Form Hub</div>
        <% end %>
        <div class="mobile-app-menu-close position-absolute end-0 me-3" id="mobile_menu_close" role="button" aria-label="Close menu">
          <i class="fa-solid fa-xmark fs-4"></i>
        </div>
      </div>

      <ul>
        <!-- App logo for desktop -->
        <li class="app-logo" id="desktop_app_logo">
          <%= link_to root_path, class: "d-flex align-items-center" do %>
            <div class="app-icon text-primary">
            <i class="fa-solid fa-cloud-arrow-up fa-fw"></i>
            </div>
            <div class="app-text text-primary">Tax Form Hub</div>
          <% end %>
        </li>

        <!-- Main Menu -->
        <div class="app-menu-list">
          <li class="<%= 'app-active' if request.path == root_path || request.path.starts_with?('/admin') %>">
            <%= link_to root_path do %>
              <div class="app-icon"><i class="fa-solid fa-file-invoice-dollar fa-fw z-1"></i></div>
              <div class="app-text">Taxes</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(invoices_path) %>">
            <%= link_to invoices_path do %>
              <div class="app-icon"><i class="fa-solid fa-file-invoice fa-fw z-1"></i></div>
              <div class="app-text">Invoices</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(subscriptions_path) rescue false %>">
            <%= link_to subscriptions_path do %>
              <div class="app-icon"><i class="fa-solid fa-repeat fa-fw z-1"></i></div>
              <div class="app-text">Subscriptions</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(locations_path) %>">
            <%= link_to locations_path do %>
              <div class="app-icon"><i class="fa-solid fa-location-dot fa-fw z-1"></i></div>
              <div class="app-text">Locations</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(networks_path) %>">
            <%= link_to networks_path do %>
              <div class="app-icon"><i class="fa-solid fa-network-wired fa-fw z-1"></i></div>
              <div class="app-text">Network</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(edit_profile_path) %>">
            <%= link_to edit_profile_path do %>
              <div class="app-icon"><i class="fa-solid fa-user-gear fa-fw z-1"></i></div>
              <div class="app-text">User Profile</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(companies_path) %>">
            <%= link_to companies_path, data: { turbo: false } do %>
              <div class="app-icon"><i class="fa-solid fa-building fa-fw z-1"></i></div>
              <div class="app-text">Company Profile</div>
            <% end %>
          </li>

          <li id="theme_toggle_btn" style="cursor: pointer;">
            <a>
              <div class="app-icon"><i class="fa-solid fa-moon fa-fw z-1"></i></div>
              <div class="app-text">Dark Mode</div>
            </a>
          </li>

          <li>
            <%= link_to destroy_user_session_path,
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to log out?" },
                        id: "logout-btn" do %>
              <div class="app-icon"><i class="fa-solid fa-right-from-bracket fa-fw z-1"></i></div>
              <div class="app-text">Log out</div>
            <% end %>
          </li>
        </div>
      </ul>
    </div>

    <div id="main_content_div">
      <%= yield %>
    </div>
  <% end %>


  <% if devise_controller? && !(controller_name == "registrations" && (action_name == "edit" || action_name == "update")) %>
    <%= yield %>
  <% end %>

  <% flash.each do |key, message| %>
    <div class="custom_tfh_alert alert alert-dismissible show d-flex align-items-start" role="alert">
      <i class="fa-solid fa-circle-exclamation me-2 mt-1 alert_text_<%= key == "notice" ? "success" : "danger" %>"></i>

      <div>
        <% messages = message.to_s.split(/<br\s*\/?>/) %>
        <% if messages.size > 1 %>
          <ol class="mb-0 ps-3">
            <% messages.each do |msg| %>
              <li><%= msg.strip %></li>
            <% end %>
          </ol>
        <% else %>
          <span><%= message %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  </body>
</html>
