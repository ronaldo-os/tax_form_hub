<!DOCTYPE html>
<html data-theme="<%= current_user&.theme || 'light' %>" data-bs-theme="<%= current_user&.theme || 'light' %>">
  <head>
    <meta name="user-theme" content="<%= current_user&.theme || 'light' %>">
    <title><%= content_for(:title) || "Tax Form Hub" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <%= render "layouts/cdns" %>

    <!-- Critical CSS inlined for fast first paint -->
    <style>
      <%= raw File.read(Rails.root.join('app/assets/builds/critical.css')) if File.exist?(Rails.root.join('app/assets/builds/critical.css')) %>
    </style>

    <!-- Stylesheets -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= yield :stylesheets %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
    <%= yield :javascripts %>
  </head>
  <body data-devise="<%= devise_controller? %>" class="bg-light">


  <% unless devise_controller? && !(controller_name == "registrations" && (action_name == "edit" || action_name == "update")) %>
    <div class="app-menu-toggle" id="desktop_menu_toggle">
      <i class="fa-solid fa-chevron-right"></i>
    </div>
    
    <div class="app-header d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3 overflow-hidden">
        <div class="mobile-app-menu-toggle flex-shrink-0" id="mobile_menu_toggle" role="button" aria-label="Toggle navigation">
          <i class="fa-solid fa-bars"></i>
        </div>
        <h1 class="mobile-page-title mb-0 fs-5 text-truncate fw-bold">
          <%= content_for(:page_title) || content_for(:title) || "Tax Form Hub" %>
        </h1>
      </div>
    </div>

    <div class="app-sidebar">
      <div class="mobile-sidebar-header position-relative d-flex align-items-center justify-content-center px-3 py-3 border-bottom">
        <%= link_to root_path, class: "d-flex align-items-center justify-content-center text-decoration-none" do %>
          <div class="app-icon text-primary fs-3">
            <i class="fa-solid fa-cloud-arrow-up fa-fw"></i>
          </div>
          <div class="app-text text-primary ms-2 fs-5 fw-bold text-uppercase">Tax Form Hub</div>
        <% end %>
        <div class="mobile-app-menu-close position-absolute end-0 me-3" id="mobile_menu_close" role="button" aria-label="Close menu">
          <i class="fa-solid fa-xmark fs-4"></i>
        </div>
      </div>

      <ul>
        <!-- App logo for desktop -->
        <li class="app-logo" id="desktop_app_logo">
          <%= link_to root_path, class: "d-flex align-items-center" do %>
            <div class="app-icon text-primary">
              <i class="fa-solid fa-cloud-arrow-up fa-fw"></i>
            </div>
            <div class="app-text text-primary">Tax Form Hub</div>
          <% end %>
        </li>

        <!-- Main Menu -->
        <div class="app-menu-list">
          <li class="<%= 'app-active' if request.path == root_path || request.path == dashboard_path || request.path.starts_with?('/dashboard') %>">
            <%= link_to root_path do %>
              <div class="app-icon"><i class="fa-solid fa-gauge-high fa-fw z-1"></i></div>
              <div class="app-text">Dashboard</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?('/tax_submissions') || request.path.starts_with?('/admin') %>">
            <%= link_to tax_submissions_home_path do %>
              <div class="app-icon"><i class="fa-solid fa-file-invoice-dollar fa-fw z-1"></i></div>
              <div class="app-text">Taxes</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(invoices_path) %>">
            <%= link_to invoices_path do %>
              <div class="app-icon"><i class="fa-solid fa-file-invoice fa-fw z-1"></i></div>
              <div class="app-text">Invoices</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(subscriptions_path) rescue false %>">
            <%= link_to subscriptions_path do %>
              <div class="app-icon"><i class="fa-solid fa-repeat fa-fw z-1"></i></div>
              <div class="app-text">Subscriptions</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(locations_path) %>">
            <%= link_to locations_path do %>
              <div class="app-icon"><i class="fa-solid fa-location-dot fa-fw z-1"></i></div>
              <div class="app-text">Locations</div>
            <% end %>
          </li>

          <li class="<%= 'app-active' if request.path.starts_with?(networks_path) %>">
            <%= link_to networks_path do %>
              <div class="app-icon"><i class="fa-solid fa-network-wired fa-fw z-1"></i></div>
              <div class="app-text">Network</div>
            <% end %>
          </li>

          <!-- Mobile-only account links (since desktop header dropdown is hidden on mobile) -->
          <li class="d-lg-none <%= 'app-active' if request.path.starts_with?(edit_profile_path) %>">
            <%= link_to edit_profile_path do %>
              <div class="app-icon"><i class="fa-solid fa-user-gear fa-fw z-1"></i></div>
              <div class="app-text">User Profile</div>
            <% end %>
          </li>

          <li class="d-lg-none <%= 'app-active' if request.path.starts_with?(companies_path) %>">
            <%= link_to companies_path, data: { turbo: false } do %>
              <div class="app-icon"><i class="fa-solid fa-building fa-fw z-1"></i></div>
              <div class="app-text">Company Profile</div>
            <% end %>
          </li>

          <li class="d-lg-none">
            <%= link_to destroy_user_session_path,
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to log out?" },
                        id: "mobile-logout-btn" do %>
              <div class="app-icon"><i class="fa-solid fa-right-from-bracket fa-fw z-1"></i></div>
              <div class="app-text">Log out</div>
            <% end %>
          </li>
        </div>
      </ul>

      <!-- Theme Toggle at Bottom of Left Sidebar -->
      <div class="sidebar-theme-wrapper p-2" id="sidebar_theme_wrapper">
        <li id="theme_toggle_btn" class="list-unstyled" style="cursor: pointer;">
          <a class="d-flex align-items-center rounded-3 text-decoration-none">
            <div class="app-icon d-flex align-items-center justify-content-center" style="min-width: 70px; width: 70px; height: 50px; font-size: 1.3em;">
              <i class="fa-solid <%= (current_user&.theme || 'light') == 'dark' ? 'fa-sun' : 'fa-moon' %> fa-fw"></i>
            </div>
            <div class="app-text fw-medium">
              <%= (current_user&.theme || 'light') == 'dark' ? 'Light Mode' : 'Dark Mode' %>
            </div>
          </a>
        </li>
      </div>
    </div>

    <!-- Desktop Page Title Header Bar -->
    <div id="desktop_header_bar" class="page-header-bar d-none d-lg-flex align-items-center justify-content-between px-4 py-3 border-bottom bg-sidebar">
      <div class="d-flex align-items-center gap-3">
        <h1 class="desktop-page-title mb-0 fs-4 fw-bold text-main">
          <%= content_for(:page_title) || content_for(:title) || "Tax Form Hub" %>
        </h1>
      </div>
      <div class="d-flex align-items-center gap-2">
        <!-- Modern Notification Dropdown Menu -->
        <%= render "layouts/notification_dropdown" %>

        <!-- Minimalist User Profile Dropdown Menu -->
        <div class="dropdown header-user-dropdown" id="header_user_dropdown_container">
          <button class="btn btn-sm p-1 border-0 shadow-none text-main d-flex align-items-center gap-2" type="button" id="headerUserDropdown" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
            <% if current_user&.profile_image&.attached? && current_user.profile_image.attachment&.persisted? %>
              <%= image_tag(url_for(current_user.profile_image), class: "rounded-circle", style: "width: 32px; height: 32px; object-fit: cover;", alt: "User Avatar") %>
            <% else %>
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-weight: 600; font-size: 0.85rem;">
                <%= current_user&.email&.first(2)&.upcase || "TF" %>
              </div>
            <% end %>
            <span class="fw-semibold fs-7 text-main me-1"><%= current_user&.email&.split('@')&.first&.capitalize || "Account" %></span>
            <i class="fa-solid fa-chevron-down text-muted fs-8"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 p-2 rounded-3 modern-user-dropdown-menu" aria-labelledby="headerUserDropdown" style="min-width: 220px;">
            <!-- Header User Summary -->
            <li class="px-3 py-2 border-bottom">
              <div class="fw-bold fs-7 text-main text-truncate" title="<%= current_user&.email %>">
                <%= current_user&.email&.split('@')&.first&.capitalize || "User" %>
              </div>
              <small class="text-muted fs-8 text-truncate d-block"><%= current_user&.email %></small>
            </li>

            <!-- Navigation Links -->
            <li>
              <%= link_to edit_profile_path, class: "dropdown-item d-flex align-items-center gap-2 py-2 fs-7 rounded-2" do %>
                <div class="app-icon text-muted me-1"><i class="fa-solid fa-user-gear fa-fw"></i></div>
                <div class="app-text text-main">User Profile</div>
              <% end %>
            </li>

            <li>
              <%= link_to companies_path, class: "dropdown-item d-flex align-items-center gap-2 py-2 fs-7 rounded-2", data: { turbo: false } do %>
                <div class="app-icon text-muted me-1"><i class="fa-solid fa-building fa-fw"></i></div>
                <div class="app-text text-main">Company Profile</div>
              <% end %>
            </li>

            <li><hr class="dropdown-divider my-1 opacity-50"></li>

            <!-- Logout Link -->
            <li>
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to log out?" }, class: "dropdown-item d-flex align-items-center gap-2 py-2 fs-7 rounded-2 text-danger", id: "header_logout_btn" do %>
                <div class="app-icon me-1"><i class="fa-solid fa-right-from-bracket fa-fw"></i></div>
                <div class="app-text">Log out</div>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div id="main_content_div">
      <%= yield %>
    </div>
  <% end %>


  <% if devise_controller? && !(controller_name == "registrations" && (action_name == "edit" || action_name == "update")) %>
    <%= yield %>
  <% end %>

  <% flash.each do |key, message| %>
    <div class="custom_tfh_alert alert alert-dismissible show d-flex align-items-start" role="alert">
      <i class="fa-solid fa-circle-exclamation me-2 mt-1 alert_text_<%= key == "notice" ? "success" : "danger" %>"></i>

      <div>
        <% messages = message.to_s.split(/<br\s*\/?>/) %>
        <% if messages.size > 1 %>
          <ol class="mb-0 ps-3">
            <% messages.each do |msg| %>
              <li><%= msg.strip %></li>
            <% end %>
          </ol>
        <% else %>
          <span><%= message %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Global Command Palette Modal -->
  <div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-labelledby="commandPaletteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-top modal-lg mt-5">
      <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="modal-header border-bottom px-3 py-2 bg-body">
          <div class="input-group input-group-lg border-0 shadow-none">
            <span class="input-group-text bg-transparent border-0 pe-2" id="cmd-search-icon">
              <i class="fa-solid fa-magnifying-glass text-muted fs-5"></i>
            </span>
            <input type="text" class="form-control bg-transparent border-0 shadow-none ps-0 fs-6 text-main" id="command_palette_input" placeholder="Type to search page (Taxes, Invoices, Subscriptions, Locations...)" aria-label="Search" autocomplete="off">
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0 max-vh-50 overflow-auto" id="command_palette_results">
          <div class="list-group list-group-flush border-0">
            <a href="<%= root_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-primary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-gauge-high fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Analytics & KPI Dashboard</div>
                  <small class="text-muted">Interactive business metrics, charts & KPIs</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= tax_submissions_home_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-success-subtle text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-file-invoice-dollar fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Taxes Hub & Submissions</div>
                  <small class="text-muted">View and submit BIR Form 2307 and tax forms</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= invoices_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-info-subtle text-info rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-file-invoice fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Invoices</div>
                  <small class="text-muted">Manage sales, purchases, quotes & credit notes</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= subscriptions_path rescue '#' %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-warning-subtle text-warning rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-repeat fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Subscriptions</div>
                  <small class="text-muted">Recurring billing and price adjustments</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= locations_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-success-subtle text-success rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-location-dot fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Locations</div>
                  <small class="text-muted">Manage business branch locations</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= networks_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-secondary-subtle text-primary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-network-wired fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Network Connections</div>
                  <small class="text-muted">View network vendors and customers</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= edit_profile_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-secondary-subtle text-secondary rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-user-gear fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">User Profile</div>
                  <small class="text-muted">User settings and account details</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>

            <a href="<%= companies_path %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-4 py-3 border-bottom-0 command-item" data-turbo="false">
              <div class="d-flex align-items-center gap-3">
                <div class="icon-square bg-dark-subtle text-dark rounded-3 p-2 d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                  <i class="fa-solid fa-building fs-5"></i>
                </div>
                <div>
                  <div class="fw-semibold text-main">Company Profile</div>
                  <small class="text-muted">Manage company data and attachments</small>
                </div>
              </div>
              <span class="badge bg-light text-muted border">Jump to</span>
            </a>
          </div>
        </div>
        <div class="modal-footer bg-light px-3 py-2 border-top d-flex justify-content-between align-items-center fs-8 text-muted">
          <div>Navigate with <kbd class="bg-secondary-subtle text-body border px-1 rounded">↑</kbd> <kbd class="bg-secondary-subtle text-body border px-1 rounded">↓</kbd></div>
          <div>Shortcut <kbd class="bg-secondary-subtle text-body border px-1 rounded">Ctrl + K</kbd></div>
        </div>
      </div>
    </div>
  </div>

  </body>
</html>
