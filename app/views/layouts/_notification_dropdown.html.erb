<%
  u = local_assigns[:user] || (defined?(current_user) ? current_user : nil)
  if u
    recent_notifications = u.notifications.recent.limit(30).to_a
    unread_notifications = recent_notifications.select(&:unread?)
    taxes_notifications = recent_notifications.select { |n| n.category == "taxes" }
    invoices_notifications = recent_notifications.select { |n| n.category == "invoices" }
    unread_count = u.notifications.unread.count
    total_count = recent_notifications.size
  else
    recent_notifications = []
    unread_notifications = []
    taxes_notifications = []
    invoices_notifications = []
    unread_count = 0
    total_count = 0
  end
%>

<!-- Modern Notification Dropdown -->
<div class="dropdown header-notification-dropdown" id="header_notification_dropdown_container" data-controller="notifications">
  <button class="btn btn-sm p-0 border-0 shadow-none text-main position-relative d-flex align-items-center justify-content-center notification-bell-btn"
          type="button"
          id="headerNotificationDropdown"
          data-bs-toggle="dropdown"
          data-bs-auto-close="outside"
          data-bs-display="static"
          aria-expanded="false"
          aria-label="Notifications"
          title="Notifications">
    <i class="fa-regular fa-bell bell-icon"></i>
    <span class="notification-badge-pulse <%= 'd-none' if unread_count.zero? %>"></span>
    <span class="notification-badge-count <%= 'd-none' if unread_count.zero? %>" id="notification_unread_badge_count">
      <%= unread_count > 99 ? '99+' : unread_count %>
    </span>
  </button>

  <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0 rounded-4 modern-notification-dropdown-menu"
       aria-labelledby="headerNotificationDropdown">
    <!-- Header Section -->
    <div class="px-3 py-3 border-bottom d-flex align-items-center justify-content-between bg-sidebar">
      <div class="d-flex align-items-center gap-2">
        <h6 class="mb-0 fw-bold fs-7 text-main">Notifications</h6>
        <% if unread_count > 0 %>
          <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5 fs-9 fw-semibold" id="dropdown_unread_badge_pill">
            <%= unread_count %> New
          </span>
        <% else %>
          <span class="badge bg-secondary-subtle text-muted rounded-pill px-2 py-0.5 fs-9 fw-semibold" id="dropdown_unread_badge_pill">
            All read
          </span>
        <% end %>
      </div>
      <% if unread_count > 0 %>
        <button type="button"
                class="btn btn-link btn-sm text-decoration-none p-0 text-muted fs-8 fw-medium d-flex align-items-center gap-1 mark-all-read-btn"
                data-action="click->notifications#markAllRead"
                title="Mark all as read">
          <i class="fa-solid fa-check-double text-primary fs-8"></i>
          <span>Mark all read</span>
        </button>
      <% end %>
    </div>

    <!-- Category Filter Tabs (Bootstrap Nav Pills) -->
    <div class="px-3 py-2 border-bottom">
      <ul class="nav nav-pills notification-filter-tabs d-flex" id="notificationTabs" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
          <button class="nav-link w-100 active py-1 px-2 fs-8" id="notif-all-tab" data-bs-toggle="pill" data-bs-target="#notif-all-pane" type="button" role="tab" aria-controls="notif-all-pane" aria-selected="true">
            All <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= total_count %></span>
          </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
          <button class="nav-link w-100 py-1 px-2 fs-8" id="notif-unread-tab" data-bs-toggle="pill" data-bs-target="#notif-unread-pane" type="button" role="tab" aria-controls="notif-unread-pane" aria-selected="false">
            Unread <span class="badge rounded-pill bg-primary text-white ms-1 fs-9"><%= unread_count %></span>
          </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
          <button class="nav-link w-100 py-1 px-2 fs-8" id="notif-taxes-tab" data-bs-toggle="pill" data-bs-target="#notif-taxes-pane" type="button" role="tab" aria-controls="notif-taxes-pane" aria-selected="false">
            Taxes <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= taxes_notifications.size %></span>
          </button>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
          <button class="nav-link w-100 py-1 px-2 fs-8" id="notif-invoices-tab" data-bs-toggle="pill" data-bs-target="#notif-invoices-pane" type="button" role="tab" aria-controls="notif-invoices-pane" aria-selected="false">
            Invoices <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= invoices_notifications.size %></span>
          </button>
        </li>
      </ul>
    </div>

    <!-- Notification Tab Panes Content -->
    <div class="tab-content" id="notificationTabsContent">
      <!-- "All" Tab Pane -->
      <div class="tab-pane fade show active" id="notif-all-pane" role="tabpanel" aria-labelledby="notif-all-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-all">
          <% if recent_notifications.any? %>
            <% recent_notifications.each do |notif| %>
              <%= render "notifications/notification_item", notification: notif %>
            <% end %>
          <% else %>
            <div class="text-center py-4 px-3 text-muted">
              <i class="fa-regular fa-bell-slash fs-4 mb-2 d-block opacity-50"></i>
              <p class="fs-8 fw-medium mb-1 text-main">No notifications yet</p>
              <p class="fs-9 text-muted mb-0">Alerts for taxes and invoices will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Unread" Tab Pane -->
      <div class="tab-pane fade" id="notif-unread-pane" role="tabpanel" aria-labelledby="notif-unread-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-unread">
          <% if unread_notifications.any? %>
            <% unread_notifications.each do |notif| %>
              <%= render "notifications/notification_item", notification: notif %>
            <% end %>
          <% else %>
            <div class="text-center py-4 px-3 text-muted">
              <i class="fa-solid fa-check-circle text-success fs-4 mb-2 d-block"></i>
              <p class="fs-8 fw-medium mb-1 text-main">All caught up!</p>
              <p class="fs-9 text-muted mb-0">You have no unread notifications.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Taxes" Tab Pane -->
      <div class="tab-pane fade" id="notif-taxes-pane" role="tabpanel" aria-labelledby="notif-taxes-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-taxes">
          <% if taxes_notifications.any? %>
            <% taxes_notifications.each do |notif| %>
              <%= render "notifications/notification_item", notification: notif %>
            <% end %>
          <% else %>
            <div class="text-center py-4 px-3 text-muted">
              <i class="fa-solid fa-file-invoice-dollar fs-4 mb-2 d-block opacity-50 text-success"></i>
              <p class="fs-8 fw-medium mb-1 text-main">No tax notifications</p>
              <p class="fs-9 text-muted mb-0">BIR Form 2307 updates will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Invoices" Tab Pane -->
      <div class="tab-pane fade" id="notif-invoices-pane" role="tabpanel" aria-labelledby="notif-invoices-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-invoices">
          <% if invoices_notifications.any? %>
            <% invoices_notifications.each do |notif| %>
              <%= render "notifications/notification_item", notification: notif %>
            <% end %>
          <% else %>
            <div class="text-center py-4 px-3 text-muted">
              <i class="fa-solid fa-file-invoice fs-4 mb-2 d-block opacity-50 text-primary"></i>
              <p class="fs-8 fw-medium mb-1 text-main">No invoice notifications</p>
              <p class="fs-9 text-muted mb-0">Invoice and quote alerts will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Dropdown Footer -->
    <div class="px-3 py-2 border-top bg-sidebar text-center">
      <%= link_to notifications_path, class: "text-decoration-none fs-8 fw-semibold text-primary d-flex align-items-center justify-content-center gap-1.5 py-1 hover-primary" do %>
        <span>View all notifications</span>
        <i class="fa-solid fa-arrow-right fs-9"></i>
      <% end %>
    </div>
  </div>
</div>
