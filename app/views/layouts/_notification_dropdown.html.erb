<%
  u = local_assigns[:user] || (defined?(current_user) ? current_user : nil)
  if u
    recent_notifications = u.notifications.recent.limit(30).to_a
    unread_notifications = u.notifications.unread.recent.limit(30).to_a
    taxes_notifications = u.notifications.where(category: "taxes").recent.limit(30).to_a
    invoices_notifications = u.notifications.where(category: "invoices").recent.limit(30).to_a
    unread_count = u.unread_notifications.count
    total_count = u.notifications.count
  else
    recent_notifications = []
    unread_notifications = []
    taxes_notifications = []
    invoices_notifications = []
    unread_count = 0
    total_count = 0
  end
%>

<!-- Notification Dropdown -->
<div class="dropdown header-notification-dropdown" id="header_notification_dropdown_container" data-controller="notifications">
  <button class="btn btn-sm p-0 border-0 shadow-none text-main position-relative d-flex align-items-center justify-content-center notification-bell-btn"
          type="button"
          id="headerNotificationDropdown"
          data-bs-toggle="dropdown"
          data-bs-auto-close="outside"
          data-bs-display="static"
          aria-expanded="false"
          aria-label="Notifications"
          title="Notifications">
    <i class="fa-regular fa-bell bell-icon"></i>
    <span class="notification-badge-pulse <%= 'd-none' if unread_count.zero? %>"></span>
    <span class="notification-badge-count <%= 'd-none' if unread_count.zero? %>" id="notification_unread_badge_count">
      <%= unread_count > 99 ? '99+' : unread_count %>
    </span>
  </button>

  <div class="dropdown-menu dropdown-menu-end border-0 mt-2 p-0 rounded-4 modern-notification-dropdown-menu"
       aria-labelledby="headerNotificationDropdown">
    <!-- Header Section -->
    <div class="dropdown-header-bar px-3 pt-3 pb-2 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <h5 class="fw-bold fs-5 text-main">Notifications</h5>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0.5 fs-9 fw-semibold <%= 'd-none' if unread_count.zero? %>" id="dropdown_unread_badge_pill">
          <%= unread_count %> New
        </span>
      </div>
      <% if unread_count > 0 %>
        <button type="button"
                class="btn btn-link btn-sm text-decoration-none p-1 text-primary fs-8 fw-semibold d-flex align-items-center gap-2 mark-all-read-btn header-mark-read-btn"
                data-action="click->notifications#markAllRead"
                title="Mark all as read">
          <i class="fa-solid fa-check-double fs-9 me-1.5"></i>
          <span>Mark all as read</span>
        </button>
      <% end %>
    </div>

    <!-- Capsule Pill Filter Tabs -->
    <div class="tabs-scroll-container px-3 pb-2">
      <ul class="nav nav-pills notification-filter-tabs d-flex gap-1.5" id="notificationTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="notif-all-tab" data-bs-toggle="pill" data-bs-target="#notif-all-pane" type="button" role="tab" aria-controls="notif-all-pane" aria-selected="true">
            All <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= total_count %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="notif-unread-tab" data-bs-toggle="pill" data-bs-target="#notif-unread-pane" type="button" role="tab" aria-controls="notif-unread-pane" aria-selected="false">
            Unread <span class="badge rounded-pill <%= unread_count > 0 ? 'bg-primary text-white' : 'bg-secondary-subtle text-secondary' %> ms-1 fs-9"><%= unread_count %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="notif-taxes-tab" data-bs-toggle="pill" data-bs-target="#notif-taxes-pane" type="button" role="tab" aria-controls="notif-taxes-pane" aria-selected="false">
            Taxes <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= taxes_notifications.size %></span>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="notif-invoices-tab" data-bs-toggle="pill" data-bs-target="#notif-invoices-pane" type="button" role="tab" aria-controls="notif-invoices-pane" aria-selected="false">
            Invoices <span class="badge rounded-pill bg-secondary-subtle text-secondary ms-1 fs-9"><%= invoices_notifications.size %></span>
          </button>
        </li>
      </ul>
    </div>

    <!-- Notification Tab Panes Content -->
    <div class="tab-content" id="notificationTabsContent">
      <!-- "All" Tab Pane -->
      <div class="tab-pane fade show active" id="notif-all-pane" role="tabpanel" aria-labelledby="notif-all-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-all">
          <% if recent_notifications.any? %>
            <%= render partial: "notifications/notification_item", collection: recent_notifications, as: :notification %>
          <% else %>
            <div class="text-center py-5 px-3 text-muted">
              <div class="empty-state-icon-circle mx-auto mb-2">
                <i class="fa-regular fa-bell-slash fs-4 opacity-50"></i>
              </div>
              <p class="fs-7 fw-semibold mb-1 text-main">No notifications yet</p>
              <p class="fs-9 text-muted mb-0">Alerts for taxes and invoices will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Unread" Tab Pane -->
      <div class="tab-pane fade" id="notif-unread-pane" role="tabpanel" aria-labelledby="notif-unread-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-unread">
          <% if unread_notifications.any? %>
            <%= render partial: "notifications/notification_item", collection: unread_notifications, as: :notification %>
          <% else %>
            <div class="text-center py-5 px-3 text-muted">
              <div class="empty-state-icon-circle mx-auto mb-2 text-success">
                <i class="fa-solid fa-check-circle fs-4 opacity-75"></i>
              </div>
              <p class="fs-7 fw-semibold mb-1 text-main">All caught up!</p>
              <p class="fs-9 text-muted mb-0">You have no unread notifications.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Taxes" Tab Pane -->
      <div class="tab-pane fade" id="notif-taxes-pane" role="tabpanel" aria-labelledby="notif-taxes-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-taxes">
          <% if taxes_notifications.any? %>
            <%= render partial: "notifications/notification_item", collection: taxes_notifications, as: :notification %>
          <% else %>
            <div class="text-center py-5 px-3 text-muted">
              <div class="empty-state-icon-circle mx-auto mb-2 text-success">
                <i class="fa-solid fa-file-invoice-dollar fs-4 opacity-50"></i>
              </div>
              <p class="fs-7 fw-semibold mb-1 text-main">No tax notifications</p>
              <p class="fs-9 text-muted mb-0">BIR Form 2307 updates will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- "Invoices" Tab Pane -->
      <div class="tab-pane fade" id="notif-invoices-pane" role="tabpanel" aria-labelledby="notif-invoices-tab" tabindex="0">
        <div class="notification-list-scroll" id="notification-scroll-invoices">
          <% if invoices_notifications.any? %>
            <%= render partial: "notifications/notification_item", collection: invoices_notifications, as: :notification %>
          <% else %>
            <div class="text-center py-5 px-3 text-muted">
              <div class="empty-state-icon-circle mx-auto mb-2 text-primary">
                <i class="fa-solid fa-file-invoice fs-4 opacity-50"></i>
              </div>
              <p class="fs-7 fw-semibold mb-1 text-main">No invoice notifications</p>
              <p class="fs-9 text-muted mb-0">Invoice and quote alerts will appear here.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Dropdown Footer -->
    <div class="dropdown-footer-bar px-3 py-2.5 border-top text-center">
      <%= link_to notifications_path, class: "view-all-notifications-link text-decoration-none fs-8 fw-semibold text-primary d-flex align-items-center justify-content-center gap-1.5" do %>
        <span>See all in Notifications</span>
        <i class="fa-solid fa-arrow-right fs-9 dropdown-arrow-icon"></i>
      <% end %>
    </div>
  </div>
</div>
