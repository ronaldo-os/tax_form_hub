<!-- Price Adjustment Show Skeleton Loader (Theme-Accurate & Container-Accurate) -->
<div class="price-adjustment-show-skeleton" aria-hidden="true">
  <!-- Back Button Skeleton -->
  <div class="d-flex justify-content-between mt-5 mb-3">
    <div class="skeleton-btn-pill" style="width: 95px; height: 38px;"></div>
  </div>

  <div class="row g-4">
    <!-- Main Column (8 cols) -->
    <div class="col-lg-8">
      <!-- Overview Card Skeleton -->
      <div class="card shadow-sm border-0 rounded-3 mb-4" style="background: var(--skeleton-card-bg);">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-3 px-4">
          <div class="skeleton-line skeleton-title mb-1.5" style="width: 220px; height: 22px;"></div>
          <div class="skeleton-line skeleton-line-xs mb-0" style="width: 140px; height: 12px;"></div>
        </div>

        <div class="card-body px-4 py-4 pt-0">
          <div class="row g-4">
            <% 6.times do %>
              <div class="col-sm-6 col-md-4">
                <div class="skeleton-line skeleton-line-xs mb-2" style="width: 65px; height: 10px;"></div>
                <div class="skeleton-value mb-0" style="width: 85px; height: 26px;"></div>
              </div>
            <% end %>
            <div class="col-12">
              <div class="skeleton-line skeleton-line-xs mb-2" style="width: 75px; height: 10px;"></div>
              <div class="p-3 rounded-3" style="background: var(--skeleton-card-bg); border: 1px solid var(--skeleton-border);">
                <div class="skeleton-line skeleton-line-sm mb-1" style="width: 80%;"></div>
                <div class="skeleton-line skeleton-line-xs mb-0" style="width: 50%;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Generated Invoices Card Skeleton -->
      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-3 px-4">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 160px; height: 18px;"></div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle skeleton-table mb-0 w-100">
              <thead class="table-light">
                <tr>
                  <th class="ps-4" style="width: 25%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px;"></div></th>
                  <th style="width: 25%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 80px;"></div></th>
                  <th style="width: 20%;"><div class="skeleton-line skeleton-line-sm mb-0" style="width: 60px;"></div></th>
                  <th class="text-end" style="width: 15%;"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 65px;"></div></th>
                  <th class="pe-4 text-end" style="width: 15%;"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 45px;"></div></th>
                </tr>
              </thead>
              <tbody>
                <% 3.times do %>
                  <tr>
                    <td class="ps-4"><div class="skeleton-pill mb-0" style="width: 90px; height: 20px;"></div></td>
                    <td><div class="skeleton-line skeleton-line-sm mb-0" style="width: 85px;"></div></td>
                    <td><div class="skeleton-pill mb-0" style="width: 60px; height: 20px;"></div></td>
                    <td class="text-end"><div class="skeleton-line skeleton-line-sm ms-auto mb-0" style="width: 70px;"></div></td>
                    <td class="pe-4 text-end"><div class="skeleton-btn ms-auto" style="width: 55px; height: 26px; border-radius: 4px;"></div></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Contract Details Sidebar (4 cols) -->
    <div class="col-lg-4">
      <div class="card shadow-sm border-0 rounded-3" style="background: var(--skeleton-card-bg);">
        <div class="card-header bg-transparent border-bottom-0 pt-4 pb-3 px-4">
          <div class="skeleton-line skeleton-title-sm mb-0" style="width: 130px; height: 18px;"></div>
        </div>
        <div class="card-body px-4 py-4 pt-0">
          <% 3.times do %>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="skeleton-line skeleton-line-xs mb-0" style="width: 45%;"></div>
              <div class="skeleton-line skeleton-line-sm mb-0" style="width: 40%;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

